region        = "ap-south-1"
name          = "my-ec2-instance"
ami           = null # Automatically uses latest Amazon Linux 2023 AMI if null
instance_type = "t3.micro"
key_name      = null

associate_public_ip_address = true
monitoring                  = false
ebs_optimized               = false
enable_eip                  = false

root_block_device = {
  volume_type           = "gp3"
  volume_size           = 20
  delete_on_termination = true
  encrypted             = true
  kms_key_id            = null
  iops                  = null
  throughput            = null
}

metadata_options = {
  http_endpoint               = "enabled"
  http_tokens                 = "required"
  http_put_response_hop_limit = 1
  http_protocol_ipv6          = "disabled"
  instance_metadata_tags      = "disabled"
}

tags = {
  Environment = "test"
  ManagedBy   = "Terraform"
}
