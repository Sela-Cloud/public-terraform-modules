{
  "$schema": "../../ui-metadata.schema.json",
  "module": "vpn",
  "version": "1.0.0",
  "display": {
    "label": "Classic VPN",
    "icon": "vpn",
    "description": "Route-based Classic VPN gateway, address, forwarding rules, and tunnel",
    "category": "regional"
  },
  "globals": [
    {
      "id": "project_id",
      "label": "Project ID",
      "type": "text",
      "required": true,
      "placeholder": "my-gcp-project"
    }
  ],
  "import": {
    "module": "vpn",
    "identity_fields": [
      "project_id",
      "region",
      "name"
    ],
    "targets": [
      {
        "id": "tunnel",
        "target": "google_compute_vpn_tunnel.this",
        "id_template": "projects/{project_id}/regions/{region}/vpnTunnels/{name}"
      },
      {
        "id": "gateway",
        "target": "google_compute_vpn_gateway.this",
        "id_template": "projects/{project_id}/regions/{region}/targetVpnGateways/{name}-gateway"
      },
      {
        "id": "address",
        "target": "google_compute_address.this",
        "id_template": "projects/{project_id}/regions/{region}/addresses/{name}-ip"
      },
      {
        "id": "forwarding_esp",
        "target": "google_compute_forwarding_rule.esp",
        "id_template": "projects/{project_id}/regions/{region}/forwardingRules/{name}-esp"
      },
      {
        "id": "forwarding_udp500",
        "target": "google_compute_forwarding_rule.udp_500",
        "id_template": "projects/{project_id}/regions/{region}/forwardingRules/{name}-udp500"
      },
      {
        "id": "forwarding_udp4500",
        "target": "google_compute_forwarding_rule.udp_4500",
        "id_template": "projects/{project_id}/regions/{region}/forwardingRules/{name}-udp4500"
      }
    ],
    "requires_review": true
  },
  "resource": {
    "variable": "vpn",
    "key_field": "name",
    "key_label": "Tunnel name",
    "sections": [
      {
        "id": "gateway",
        "label": "Gateway and tunnel",
        "fields": [
          {
            "id": "name",
            "label": "Tunnel name",
            "type": "text",
            "required": true,
            "validation": {
              "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$",
              "pattern_error": "Use an RFC 1035 name."
            }
          },
          {
            "id": "region",
            "label": "Region",
            "type": "select",
            "required": true,
            "data_source": {
              "resource": "compute.regions",
              "params": {
                "project_id": {
                  "from_field": "project_id"
                }
              },
              "display": {
                "value_key": "name",
                "label_key": "name"
              },
              "allow_custom": true,
              "cache_ttl": 300
            }
          },
          {
            "id": "network",
            "label": "VPC network",
            "type": "select",
            "required": true,
            "data_source": {
              "resource": "compute.networks",
              "params": {
                "project_id": {
                  "from_field": "project_id"
                }
              },
              "display": {
                "value_key": "name",
                "label_key": "name"
              },
              "allow_custom": true,
              "cache_ttl": 300
            }
          },
          {
            "id": "peer_ip",
            "label": "Peer gateway public IP",
            "type": "text",
            "required": true,
            "placeholder": "203.0.113.10"
          },
          {
            "id": "shared_secret",
            "label": "Pre-shared secret",
            "description": "Stored in Terraform state; use a dedicated secret-management flow before production.",
            "type": "text",
            "required": true,
            "sensitive": true
          },
          {
            "id": "ike_version",
            "label": "IKE version",
            "type": "select",
            "default": "2",
            "options": [
              {
                "value": "1",
                "label": "IKEv1"
              },
              {
                "value": "2",
                "label": "IKEv2"
              }
            ]
          },
          {
            "id": "routing_mode",
            "label": "Routing",
            "description": "Route-based lets GCP routes direct traffic into the tunnel (0.0.0.0/0 selectors, managed automatically). Policy-based matches traffic against the selectors you specify below.",
            "type": "select",
            "required": true,
            "default": "ROUTE_BASED",
            "options": [
              { "value": "ROUTE_BASED", "label": "Route-based" },
              { "value": "POLICY_BASED", "label": "Policy-based" }
            ]
          },
          {
            "id": "destination_ranges",
            "label": "Destination IP ranges",
            "description": "Remote (on-premises) CIDR ranges to route into this tunnel.",
            "type": "list",
            "required": true,
            "depends_on": { "field": "routing_mode", "value": "ROUTE_BASED" }
          },
          {
            "id": "local_traffic_selector",
            "label": "Local traffic selectors",
            "type": "list",
            "required": true,
            "depends_on": { "field": "routing_mode", "value": "POLICY_BASED" }
          },
          {
            "id": "remote_traffic_selector",
            "label": "Remote traffic selectors",
            "type": "list",
            "required": true,
            "depends_on": { "field": "routing_mode", "value": "POLICY_BASED" }
          },
          {
            "id": "description",
            "label": "Description",
            "type": "text",
            "default": ""
          }
        ]
      }
    ]
  }
}
