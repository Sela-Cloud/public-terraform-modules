{
  "$schema": "../../../ui-metadata.schema.json",
  "module": "vpn-gateway",
  "version": "1.1.0",
  "display": {
    "label": "VPN Gateway",
    "icon": "azure-vpn-gateway",
    "description": "Azure Virtual WAN VPN Gateway for scalable site-to-site VPN, created with its own Virtual WAN and virtual hub",
    "category": "regional"
  },
  "resource": {
    "variable": "vpn_gateway",
    "key_field": "name",
    "key_label": "VPN Gateway Name",
    "key_description": "The unique name for the Azure VPN Gateway. Serves as the map key.",
    "sections": [
      {
        "id": "basic",
        "label": "Basic Configuration",
        "description": "Core VPN Gateway settings.",
        "collapsed": false,
        "fields": [
          {
            "id": "name",
            "label": "VPN Gateway Name",
            "description": "Name of the Azure VPN Gateway. Must be 1-80 characters, begin with an alphanumeric character, end with an alphanumeric character or underscore, and contain only alphanumerics, underscores, hyphens, or periods.",
            "type": "text",
            "required": true,
            "locked_after_create": true,
            "placeholder": "vwan-vpn-gw-01",
            "validation": {
              "min": 1,
              "max": 80,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,78}[a-zA-Z0-9_]$",
              "pattern_error": "VPN Gateway name must be 1-80 characters, begin with an alphanumeric character, end with an alphanumeric character or underscore, and contain only alphanumerics, underscores, hyphens, or periods."
            }
          },
          {
            "id": "resource_group_name",
            "label": "Resource Group Name",
            "description": "The name of the Resource Group in which to create the VPN Gateway.",
            "type": "select",
            "required": true,
            "locked_after_create": true,
            "data_source": {
              "resource": "resources.resourceGroups",
              "params": {},
              "display": {
                "value_key": "name",
                "label_key": "name",
                "description_key": "location"
              }
            }
          },
          {
            "id": "location",
            "label": "Region",
            "description": "The Azure Region where the VPN Gateway should be created.",
            "type": "select",
            "required": true,
            "locked_after_create": true,
            "options": [
              { "value": "eastus", "label": "East US (Virginia)" },
              { "value": "eastus2", "label": "East US 2 (Virginia)" },
              { "value": "westus", "label": "West US (California)" },
              { "value": "westus2", "label": "West US 2 (Washington)" },
              { "value": "westus3", "label": "West US 3 (Phoenix)" },
              { "value": "centralus", "label": "Central US (Iowa)" },
              { "value": "northcentralus", "label": "North Central US (Illinois)" },
              { "value": "southcentralus", "label": "South Central US (Texas)" },
              { "value": "northeurope", "label": "North Europe (Ireland)" },
              { "value": "westeurope", "label": "West Europe (Netherlands)" },
              { "value": "uksouth", "label": "UK South (London)" },
              { "value": "ukwest", "label": "UK West (Cardiff)" },
              { "value": "southeastasia", "label": "Southeast Asia (Singapore)" },
              { "value": "eastasia", "label": "East Asia (Hong Kong)" },
              { "value": "australiaeast", "label": "Australia East (Sydney)" },
              { "value": "canadacentral", "label": "Canada Central (Toronto)" },
              { "value": "germanywestcentral", "label": "Germany West Central (Frankfurt)" },
              { "value": "francecentral", "label": "France Central (Paris)" },
              { "value": "japaneast", "label": "Japan East (Tokyo)" },
              { "value": "centralindia", "label": "Central India (Pune)" }
            ]
          },
          {
            "id": "scale_unit",
            "label": "Scale Unit",
            "description": "The Scale Unit for this VPN Gateway (between 1 and 100). Each scale unit provides roughly 500 Mbps aggregate throughput.",
            "type": "number",
            "required": false,
            "default": 1,
            "validation": {
              "min": 1,
              "max": 100
            }
          }
        ]
      },
      {
        "id": "virtual_hub",
        "label": "Virtual hub and Virtual WAN",
        "description": "A new Virtual WAN and virtual hub are created for the gateway, in its resource group and region. The hub's router takes around 30 minutes to provision. Destroying the gateway deletes both, and Azure refuses that while other gateways or network connections still use the hub.",
        "fields": [
          {
            "id": "virtual_hub",
            "label": "Virtual hub",
            "type": "object",
            "fields": [
              {
                "id": "name",
                "label": "Hub name",
                "type": "text",
                "required": true,
                "placeholder": "vwan-hub-eastus",
                "validation": {
                  "min": 1,
                  "max": 80,
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,78}[a-zA-Z0-9_]$",
                  "pattern_error": "1-80 characters: letters, numbers, underscores, hyphens and periods; start with a letter or number."
                }
              },
              {
                "id": "address_prefix",
                "label": "Hub address prefix",
                "type": "text",
                "required": true,
                "placeholder": "10.100.0.0/23",
                "description": "The hub's own address space: /24 or larger (Microsoft recommends /23). It must not overlap any network the hub connects to.",
                "validation": {
                  "pattern": "^(\\d{1,3}\\.){3}\\d{1,3}/(1\\d|2[0-4]|[0-9])$",
                  "pattern_error": "Use an IPv4 CIDR block of /24 or larger, such as 10.100.0.0/23."
                }
              },
              {
                "id": "sku",
                "label": "Hub SKU",
                "type": "select",
                "default": "Standard",
                "description": "Basic supports site-to-site VPN only. A Basic Virtual WAN can hold only Basic hubs.",
                "options": [
                  {
                    "value": "Standard",
                    "label": "Standard"
                  },
                  {
                    "value": "Basic",
                    "label": "Basic"
                  }
                ]
              },
              {
                "id": "hub_routing_preference",
                "label": "Hub routing preference",
                "type": "select",
                "default": "ExpressRoute",
                "description": "Which path the hub prefers when the same prefix is learned from several sources.",
                "options": [
                  {
                    "value": "ExpressRoute",
                    "label": "ExpressRoute"
                  },
                  {
                    "value": "VpnGateway",
                    "label": "VPN gateway"
                  },
                  {
                    "value": "ASPath",
                    "label": "AS path"
                  }
                ]
              }
            ],
            "required": true
          },
          {
            "id": "virtual_wan",
            "label": "Virtual WAN",
            "type": "object",
            "fields": [
              {
                "id": "name",
                "label": "WAN name",
                "type": "text",
                "required": true,
                "placeholder": "core-wan",
                "validation": {
                  "min": 1,
                  "max": 80,
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,78}[a-zA-Z0-9_]$",
                  "pattern_error": "1-80 characters: letters, numbers, underscores, hyphens and periods; start with a letter or number."
                }
              },
              {
                "id": "type",
                "label": "WAN type",
                "type": "select",
                "default": "Standard",
                "description": "Basic supports site-to-site VPN only and Basic hubs only. Standard adds point-to-site VPN, ExpressRoute and hub-to-hub transit.",
                "options": [
                  {
                    "value": "Standard",
                    "label": "Standard"
                  },
                  {
                    "value": "Basic",
                    "label": "Basic"
                  }
                ]
              },
              {
                "id": "allow_branch_to_branch_traffic",
                "label": "Allow branch-to-branch traffic",
                "type": "boolean",
                "default": true,
                "description": "Lets sites connected to the WAN reach each other through it."
              },
              {
                "id": "disable_vpn_encryption",
                "label": "Disable VPN encryption",
                "type": "boolean",
                "default": false
              },
              {
                "id": "office365_local_breakout_category",
                "label": "Office 365 local breakout",
                "type": "select",
                "default": "None",
                "options": [
                  {
                    "value": "None",
                    "label": "None"
                  },
                  {
                    "value": "Optimize",
                    "label": "Optimize"
                  },
                  {
                    "value": "OptimizeAndAllow",
                    "label": "Optimize and allow"
                  },
                  {
                    "value": "All",
                    "label": "All"
                  }
                ]
              }
            ],
            "required": true
          }
        ]
      },
      {
        "id": "bgp_settings",
        "label": "BGP Routing Settings",
        "description": "Border Gateway Protocol (BGP) routing configuration for the VPN Gateway.",
        "collapsed": true,
        "fields": [
          {
            "id": "bgp_settings",
            "label": "BGP Configuration",
            "description": "BGP settings block for dynamic routing.",
            "type": "object",
            "required": false,
            "default": null,
            "nullable": true,
            "fields": [
              {
                "id": "asn",
                "label": "Autonomous System Number (ASN)",
                "description": "The Autonomous System Number of the BGP Speaker (e.g. 65515).",
                "type": "number",
                "required": false,
                "default": 65515
              },
              {
                "id": "peer_weight",
                "label": "Peer Weight",
                "description": "The weight added to routes learned from this BGP Speaker.",
                "type": "number",
                "required": false,
                "default": 0
              },
              {
                "id": "instance_0_custom_ips",
                "label": "Instance 0 Custom BGP IPs",
                "description": "List of custom BGP peering APIPA IP addresses (169.254.21.0/24 - 169.254.22.255) for Gateway Instance 0.",
                "type": "list",
                "required": false,
                "default": [],
                "placeholder": "169.254.21.1"
              },
              {
                "id": "instance_1_custom_ips",
                "label": "Instance 1 Custom BGP IPs",
                "description": "List of custom BGP peering APIPA IP addresses (169.254.21.0/24 - 169.254.22.255) for Gateway Instance 1.",
                "type": "list",
                "required": false,
                "default": [],
                "placeholder": "169.254.21.5"
              }
            ]
          }
        ]
      },
      {
        "id": "tagging",
        "label": "Tagging",
        "description": "Resource tags for governance and billing.",
        "collapsed": true,
        "fields": [
          {
            "id": "tags",
            "label": "Tags",
            "description": "Key-value pairs to assign to the VPN Gateway.",
            "type": "map",
            "required": false,
            "default": {}
          }
        ]
      }
    ]
  },
  "satellites": [
    { "address": "azurerm_virtual_hub.this", "note": "The virtual hub is created and deleted with the gateway." },
    { "address": "azurerm_virtual_wan.this", "note": "The Virtual WAN is created and deleted with the gateway." }
  ]
}
