{
  "$schema": "../../../ui-metadata.schema.json",
  "module": "frontdoor",
  "version": "1.1.0",
  "display": {
    "label": "Azure Front Door",
    "icon": "azure-front-door",
    "description": "Azure Front Door (Standard/Premium) global, scalable modern CDN and Layer 7 load balancer with instant failover and edge acceleration",
    "category": "global"
  },
  "resource": {
    "variable": "frontdoor",
    "key_field": "name",
    "key_label": "Profile Name",
    "key_description": "The unique name for the Azure Front Door Profile. Serves as the map key.",
    "sections": [
      {
        "id": "basic",
        "label": "Basic Configuration",
        "description": "Core Front Door profile settings and SKU selection.",
        "collapsed": false,
        "fields": [
          {
            "id": "name",
            "label": "Front Door Profile Name",
            "description": "Specifies the name of the Front Door profile. Must be 3-64 characters, using alphanumerics and hyphens.",
            "type": "text",
            "required": true,
            "locked_after_create": true,
            "placeholder": "afd-my-workload-prod",
            "validation": {
              "min": 3,
              "max": 64,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9-]{1,62}[a-zA-Z0-9]$",
              "pattern_error": "Front Door name must be between 3 and 64 characters, begin and end with an alphanumeric character, and contain only alphanumerics and hyphens."
            }
          },
          {
            "id": "resource_group_name",
            "label": "Resource Group Name",
            "description": "Specifies the name of the Resource Group in which the Front Door profile should exist.",
            "type": "select",
            "required": true,
            "locked_after_create": true,
            "data_source": {
              "resource": "resources.resourceGroups",
              "params": {},
              "display": {
                "value_key": "name",
                "label_key": "name",
                "description_key": "location"
              }
            }
          },
          {
            "id": "sku_name",
            "label": "Front Door SKU Tier",
            "description": "The pricing and capability tier for Azure Front Door. Standard is optimized for content delivery; Premium adds advanced WAF and private link origin integration.",
            "type": "select",
            "required": false,
            "default": "Standard_AzureFrontDoor",
            "options": [
              { "value": "Standard_AzureFrontDoor", "label": "Standard (Content delivery & basic security - Recommended)" },
              { "value": "Premium_AzureFrontDoor", "label": "Premium (Advanced WAF, Bot Protection & Private Link)" }
            ]
          },
          {
            "id": "response_timeout_seconds",
            "label": "Response Timeout (seconds)",
            "description": "Maximum response timeout in seconds between 16 and 240 seconds. Defaults to 120 seconds.",
            "type": "number",
            "required": false,
            "default": 120,
            "validation": {
              "min": 16,
              "max": 240
            }
          }
        ]
      },
      {
        "id": "endpoints_section",
        "label": "Frontend Endpoints",
        "description": "Public entry points hosted on Microsoft's global edge network (*.azurefd.net).",
        "collapsed": false,
        "fields": [
          {
            "id": "endpoints",
            "label": "Endpoints",
            "description": "List of endpoints that receive client traffic.",
            "type": "repeatable",
            "required": true,
            "fields": [
              {
                "id": "name",
                "label": "Endpoint Name",
                "description": "Name of the endpoint (e.g. ep-my-app).",
                "type": "text",
                "required": true,
                "placeholder": "ep-my-app"
              },
              {
                "id": "enabled",
                "label": "Enabled",
                "description": "Whether this endpoint is enabled to receive traffic.",
                "type": "boolean",
                "required": false,
                "default": true
              }
            ]
          }
        ]
      },
      {
        "id": "origin_groups_section",
        "label": "Origin Groups & Backend Origins",
        "description": "Backend targets (origins) and health check / load balancing settings.",
        "collapsed": false,
        "fields": [
          {
            "id": "origin_groups",
            "label": "Origin Groups",
            "description": "Groups of backend origins with health monitoring and failover routing.",
            "type": "repeatable",
            "required": true,
            "fields": [
              {
                "id": "name",
                "label": "Origin Group Name",
                "description": "Name of the origin group.",
                "type": "text",
                "required": true,
                "default": "og-default",
                "placeholder": "og-default"
              },
              {
                "id": "session_affinity_enabled",
                "label": "Session Affinity",
                "description": "Direct subsequent client requests to the same origin.",
                "type": "boolean",
                "required": false,
                "default": false
              },
              {
                "id": "load_balancing",
                "label": "Load Balancing Settings",
                "description": "Sample size, successful samples, and latency threshold for origin selection.",
                "type": "object",
                "required": false,
                "fields": [
                  {
                    "id": "sample_size",
                    "label": "Sample Size",
                    "type": "number",
                    "required": false,
                    "default": 4
                  },
                  {
                    "id": "successful_samples_required",
                    "label": "Successful Samples Required",
                    "type": "number",
                    "required": false,
                    "default": 3
                  },
                  {
                    "id": "additional_latency_in_milliseconds",
                    "label": "Additional Latency Sensitivity (ms)",
                    "type": "number",
                    "required": false,
                    "default": 50
                  }
                ]
              },
              {
                "id": "health_probe",
                "label": "Health Probe Settings",
                "description": "Health check probes sent from edge PoPs to backend origins.",
                "type": "object",
                "required": false,
                "fields": [
                  {
                    "id": "protocol",
                    "label": "Probe Protocol",
                    "type": "select",
                    "required": false,
                    "default": "Https",
                    "options": [
                      { "value": "Https", "label": "HTTPS" },
                      { "value": "Http", "label": "HTTP" }
                    ]
                  },
                  {
                    "id": "interval_in_seconds",
                    "label": "Probe Interval (seconds)",
                    "type": "number",
                    "required": false,
                    "default": 100
                  },
                  {
                    "id": "path",
                    "label": "Probe Path",
                    "type": "text",
                    "required": false,
                    "default": "/"
                  },
                  {
                    "id": "request_type",
                    "label": "Request Method",
                    "type": "select",
                    "required": false,
                    "default": "HEAD",
                    "options": [
                      { "value": "HEAD", "label": "HEAD" },
                      { "value": "GET", "label": "GET" }
                    ]
                  }
                ]
              },
              {
                "id": "origins",
                "label": "Backend Origins",
                "description": "List of actual backend application endpoints (App Services, VMs, APIs, etc.).",
                "type": "repeatable",
                "required": true,
                "fields": [
                  {
                    "id": "name",
                    "label": "Origin Name",
                    "description": "Friendly name for this backend origin.",
                    "type": "text",
                    "required": true,
                    "default": "primary-origin",
                    "placeholder": "primary-app"
                  },
                  {
                    "id": "host_name",
                    "label": "Host Name / FQDN",
                    "description": "The IPv4 address or FQDN of the backend target (e.g. app-my-workload.azurewebsites.net).",
                    "type": "text",
                    "required": true,
                    "placeholder": "app-my-workload.azurewebsites.net"
                  },
                  {
                    "id": "origin_host_header",
                    "label": "Origin Host Header Override",
                    "description": "The Host header sent to the backend. If left empty, defaults to the Host Name.",
                    "type": "text",
                    "required": false,
                    "placeholder": "app-my-workload.azurewebsites.net"
                  },
                  {
                    "id": "http_port",
                    "label": "HTTP Port",
                    "type": "number",
                    "required": false,
                    "default": 80
                  },
                  {
                    "id": "https_port",
                    "label": "HTTPS Port",
                    "type": "number",
                    "required": false,
                    "default": 443
                  },
                  {
                    "id": "priority",
                    "label": "Priority",
                    "description": "Priority for load balancing (1 is highest priority, 2+ for failover).",
                    "type": "number",
                    "required": false,
                    "default": 1
                  },
                  {
                    "id": "weight",
                    "label": "Weight",
                    "description": "Weight among origins with the same priority (1 to 1000).",
                    "type": "number",
                    "required": false,
                    "default": 1000
                  },
                  {
                    "id": "certificate_name_check_enabled",
                    "label": "Verify Certificate Name",
                    "type": "boolean",
                    "required": false,
                    "default": true
                  },
                  {
                    "id": "enabled",
                    "label": "Enabled",
                    "type": "boolean",
                    "required": false,
                    "default": true
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "id": "routes_section",
        "label": "Routing Rules",
        "description": "Map incoming client traffic on endpoints to destination origin groups.",
        "collapsed": false,
        "fields": [
          {
            "id": "routes",
            "label": "Routing Rules",
            "description": "List of route definitions connecting endpoints to origin groups.",
            "type": "repeatable",
            "required": true,
            "fields": [
              {
                "id": "name",
                "label": "Route Name",
                "type": "text",
                "required": true,
                "default": "route-default",
                "placeholder": "route-default"
              },
              {
                "id": "endpoint_name",
                "label": "Target Endpoint Name",
                "description": "Name of the endpoint this route applies to (must match an endpoint name above).",
                "type": "text",
                "required": true,
                "default": "ep-my-app",
                "placeholder": "ep-my-app"
              },
              {
                "id": "origin_group_name",
                "label": "Target Origin Group Name",
                "description": "Name of the origin group to forward traffic to (must match an origin group name above).",
                "type": "text",
                "required": true,
                "default": "og-default",
                "placeholder": "og-default"
              },
              {
                "id": "forwarding_protocol",
                "label": "Forwarding Protocol",
                "description": "Protocol used to forward traffic to the origin.",
                "type": "select",
                "required": false,
                "default": "HttpsOnly",
                "options": [
                  { "value": "HttpsOnly", "label": "HTTPS Only" },
                  { "value": "HttpOnly", "label": "HTTP Only" },
                  { "value": "MatchRequest", "label": "Match Incoming Request" }
                ]
              },
              {
                "id": "patterns_to_match",
                "label": "Path Patterns to Match",
                "description": "List of path patterns (e.g. /*).",
                "type": "list",
                "required": false,
                "default": ["/*"]
              },
              {
                "id": "supported_protocols",
                "label": "Supported Client Protocols",
                "description": "Protocols accepted from clients.",
                "type": "list",
                "required": false,
                "default": ["Http", "Https"]
              },
              {
                "id": "https_redirect_enabled",
                "label": "Redirect HTTP to HTTPS",
                "type": "boolean",
                "required": false,
                "default": true
              },
              {
                "id": "link_to_default_domain",
                "label": "Link to Default Domain (*.azurefd.net)",
                "type": "boolean",
                "required": false,
                "default": true
              }
            ]
          }
        ]
      },
      {
        "id": "tagging",
        "label": "Tags",
        "description": "Resource tags for governance and billing.",
        "collapsed": true,
        "fields": [
          {
            "id": "tags",
            "label": "Tags",
            "description": "Key-value pairs to assign to the Front Door profile.",
            "type": "map",
            "required": false,
            "default": {}
          }
        ]
      }
    ]
  }
}
