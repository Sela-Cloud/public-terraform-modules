{
  "$schema": "../../ui-metadata.schema.json",
  "module": "application-security-group",
  "version": "1.0.0",
  "display": {
    "label": "Application Security Group",
    "icon": "application-security-group",
    "description": "Azure Application Security Group (ASG) for configuring network security policies based on application structure",
    "category": "regional"
  },
  "resource": {
    "variable": "application_security_group",
    "key_field": "name",
    "key_label": "Application Security Group Name",
    "key_description": "The unique name for the Azure Application Security Group. Serves as the map key.",
    "sections": [
      {
        "id": "basic",
        "label": "Basic Configuration",
        "description": "Core Application Security Group settings.",
        "collapsed": false,
        "fields": [
          {
            "id": "name",
            "label": "Application Security Group Name",
            "description": "Name of the Azure Application Security Group. Must be 1-80 characters using alphanumeric, underscores, hyphens, and periods.",
            "type": "text",
            "required": true,
            "default": "asg-default",
            "placeholder": "asg-my-workload",
            "locked_after_create": true,
            "validation": {
              "min": 1,
              "max": 80,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]*[a-zA-Z0-9_]$",
              "pattern_error": "Application Security Group name must be 1-80 characters, begin with an alphanumeric character, end with an alphanumeric character or underscore, and contain only alphanumerics, hyphens, periods, or underscores."
            }
          },
          {
            "id": "resource_group_name",
            "label": "Resource Group Name",
            "description": "The name of the Resource Group in which to create the Application Security Group.",
            "type": "text",
            "required": true,
            "default": "rg-default",
            "placeholder": "rg-my-workload",
            "locked_after_create": true,
            "validation": {
              "min": 1,
              "max": 90,
              "pattern": "^[-\\w\\._\\(\\)]+[^\\.]$",
              "pattern_error": "Resource Group name must be 1-90 characters (alphanumerics, underscores, parentheses, hyphens, periods) and cannot end in a period."
            }
          },
          {
            "id": "location",
            "label": "Region",
            "description": "The Azure Region where the Application Security Group should be created.",
            "type": "select",
            "required": true,
            "default": "eastus",
            "locked_after_create": true,
            "options": [
              { "value": "eastus", "label": "East US (Virginia)" },
              { "value": "eastus2", "label": "East US 2 (Virginia)" },
              { "value": "westus", "label": "West US (California)" },
              { "value": "westus2", "label": "West US 2 (Washington)" },
              { "value": "westus3", "label": "West US 3 (Phoenix)" },
              { "value": "centralus", "label": "Central US (Iowa)" },
              { "value": "northcentralus", "label": "North Central US (Illinois)" },
              { "value": "southcentralus", "label": "South Central US (Texas)" },
              { "value": "westeurope", "label": "West Europe (Netherlands)" },
              { "value": "northeurope", "label": "North Europe (Ireland)" },
              { "value": "uksouth", "label": "UK South (London)" },
              { "value": "ukwest", "label": "UK West (Cardiff)" },
              { "value": "southeastasia", "label": "Southeast Asia (Singapore)" },
              { "value": "eastasia", "label": "East Asia (Hong Kong)" },
              { "value": "australiaeast", "label": "Australia East (New South Wales)" },
              { "value": "centralindia", "label": "Central India (Pune)" },
              { "value": "canadacentral", "label": "Canada Central (Toronto)" },
              { "value": "germanywestcentral", "label": "Germany West Central (Frankfurt)" },
              { "value": "francecentral", "label": "France Central (Paris)" },
              { "value": "japaneast", "label": "Japan East (Tokyo, Saitama)" },
              { "value": "brazilsouth", "label": "Brazil South (Sao Paulo State)" },
              { "value": "uaenorth", "label": "UAE North (Dubai)" },
              { "value": "southafricanorth", "label": "South Africa North (Johannesburg)" },
              { "value": "switzerlandnorth", "label": "Switzerland North (Zurich)" },
              { "value": "swedencentral", "label": "Sweden Central (Gavle)" }
            ]
          }
        ]
      },
      {
        "id": "network_interfaces",
        "label": "Network Interface Associations",
        "description": "Optional Network Interfaces to associate with this Application Security Group.",
        "collapsed": true,
        "fields": [
          {
            "id": "network_interface_ids",
            "label": "Network Interface IDs",
            "description": "List of Azure Network Interface IDs to associate with this Application Security Group.",
            "type": "list",
            "required": false,
            "default": []
          }
        ]
      },
      {
        "id": "tagging",
        "label": "Tags",
        "description": "Resource tagging for organization, governance, and billing.",
        "collapsed": true,
        "fields": [
          {
            "id": "tags",
            "label": "Tags",
            "description": "Key-value pairs to tag the Application Security Group for organization, governance, and billing.",
            "type": "map",
            "required": false,
            "default": {}
          }
        ]
      }
    ]
  }
}
