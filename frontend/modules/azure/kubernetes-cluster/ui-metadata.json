{
  "$schema": "../../../ui-metadata.schema.json",
  "module": "kubernetes-cluster",
  "version": "1.0.0",
  "display": {
    "label": "Azure Kubernetes Service (AKS)",
    "icon": "azure-kubernetes",
    "description": "Fully managed Kubernetes cluster with auto-scaling node pools, advanced networking, Workload Identity, and enterprise security.",
    "category": "regional"
  },
  "resource": {
    "variable": "kubernetes_cluster",
    "key_field": "name",
    "key_label": "Cluster Name",
    "key_description": "The unique name for the Azure Kubernetes Service Managed Cluster. Serves as the map key.",
    "sections": [
      {
        "id": "basic",
        "label": "Basic Configuration",
        "description": "Cluster identity, region, and control plane settings.",
        "collapsed": false,
        "fields": [
          {
            "id": "name",
            "label": "Cluster Name",
            "description": "Name of the Managed Kubernetes Cluster. Must begin and end with an alphanumeric character and contain only letters, numbers, and hyphens.",
            "type": "text",
            "required": true,
            "placeholder": "aks-my-workload",
            "validation": {
              "min": 1,
              "max": 63,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9-]{0,61}[a-zA-Z0-9]$",
              "pattern_error": "Name must be 1 to 63 characters, start and end with an alphanumeric character, and contain only letters, numbers, and hyphens."
            }
          },
          {
            "id": "resource_group_name",
            "label": "Resource Group Name",
            "description": "The name of the Resource Group in which to create the Kubernetes Cluster.",
            "type": "select",
            "required": true,
            "data_source": {
              "resource": "resources.resourceGroups",
              "params": {},
              "display": {
                "value_key": "name",
                "label_key": "name"
              }
            }
          },
          {
            "id": "location",
            "label": "Region",
            "description": "The Azure Region where the Kubernetes Cluster should be created.",
            "type": "select",
            "required": true,
            "options": [
              { "value": "eastus", "label": "East US (Virginia)" },
              { "value": "eastus2", "label": "East US 2 (Virginia)" },
              { "value": "westus", "label": "West US (California)" },
              { "value": "westus2", "label": "West US 2 (Washington)" },
              { "value": "westus3", "label": "West US 3 (Phoenix)" },
              { "value": "centralus", "label": "Central US (Iowa)" },
              { "value": "northcentralus", "label": "North Central US (Illinois)" },
              { "value": "southcentralus", "label": "South Central US (Texas)" },
              { "value": "westeurope", "label": "West Europe (Netherlands)" },
              { "value": "northeurope", "label": "North Europe (Ireland)" },
              { "value": "uksouth", "label": "UK South (London)" },
              { "value": "ukwest", "label": "UK West (Cardiff)" },
              { "value": "southeastasia", "label": "Southeast Asia (Singapore)" },
              { "value": "eastasia", "label": "East Asia (Hong Kong)" },
              { "value": "australiaeast", "label": "Australia East (New South Wales)" },
              { "value": "centralindia", "label": "Central India (Pune)" },
              { "value": "canadacentral", "label": "Canada Central (Toronto)" },
              { "value": "germanywestcentral", "label": "Germany West Central (Frankfurt)" },
              { "value": "francecentral", "label": "France Central (Paris)" },
              { "value": "japaneast", "label": "Japan East (Tokyo, Saitama)" },
              { "value": "brazilsouth", "label": "Brazil South (Sao Paulo State)" },
              { "value": "uaenorth", "label": "UAE North (Dubai)" },
              { "value": "southafricanorth", "label": "South Africa North (Johannesburg)" },
              { "value": "switzerlandnorth", "label": "Switzerland North (Zurich)" },
              { "value": "swedencentral", "label": "Sweden Central (Gavle)" },
              { "value": "israelcentral", "label": "Israel Central (Tel Aviv)" }
            ]
          },
          {
            "id": "sku_tier",
            "label": "SKU Tier",
            "description": "The SKU Tier for this cluster. Standard includes financially-backed 99.95% uptime SLA.",
            "type": "select",
            "default": "Standard",
            "options": [
              { "value": "Standard", "label": "Standard (Recommended - Uptime SLA)" },
              { "value": "Free", "label": "Free (No Uptime SLA)" },
              { "value": "Premium", "label": "Premium (Mission-critical SLA & long-term support)" }
            ]
          },
          {
            "id": "kubernetes_version",
            "label": "Kubernetes Version",
            "description": "Specific Kubernetes control plane version (leave empty for Azure default).",
            "type": "select",
            "required": false,
            "nullable": true,
            "data_source": {
              "resource": "container.kubernetesVersions",
              "params": {
                "location": {
                  "from_field": "location"
                }
              },
              "display": {
                "value_key": "version",
                "label_key": "version",
                "description_key": "description"
              }
            }
          },
          {
            "id": "automatic_upgrade_channel",
            "label": "Automatic Upgrade Channel",
            "description": "Cluster upgrade channel for automated patch and minor version management.",
            "type": "select",
            "default": "patch",
            "options": [
              { "value": "patch", "label": "patch (Keep on latest patch of current minor)" },
              { "value": "rapid", "label": "rapid (Upgrade to latest supported minor version)" },
              { "value": "stable", "label": "stable (Upgrade to latest minor N-1 version)" },
              { "value": "node-image", "label": "node-image (Only upgrade node OS images)" },
              { "value": "none", "label": "none (Disable automatic upgrades)" }
            ]
          }
        ]
      },
      {
        "id": "default_node_pool_section",
        "label": "Default System Node Pool",
        "description": "Primary node pool hosting critical system pods and cluster controllers.",
        "collapsed": false,
        "fields": [
          {
            "id": "default_node_pool",
            "label": "System Node Pool Configuration",
            "description": "Sizing and auto-scaling settings for the system node pool.",
            "type": "object",
            "fields": [
              {
                "id": "name",
                "label": "Node Pool Name",
                "description": "Unique name of the system node pool (1-12 lowercase letters/numbers).",
                "type": "text",
                "default": "system",
                "required": true,
                "validation": {
                  "min": 1,
                  "max": 12,
                  "pattern": "^[a-z][a-z0-9]{0,11}$",
                  "pattern_error": "Node pool name must begin with a lowercase letter, contain only lowercase letters and numbers, and be between 1 and 12 characters in length."
                }
              },
              {
                "id": "vm_size",
                "label": "VM SKU Size",
                "description": "Virtual machine size for the nodes.",
                "type": "select",
                "required": true,
                "default": "Standard_D2s_v5",
                "data_source": {
                  "resource": "compute.vmSizes",
                  "params": {
                    "location": {
                      "from_field": "location"
                    }
                  },
                  "display": {
                    "value_key": "name",
                    "label_key": "name",
                    "description_key": "description"
                  }
                }
              },
              {
                "id": "auto_scaling_enabled",
                "label": "Enable Autoscaling",
                "description": "Enable Kubernetes cluster autoscaler on the system node pool.",
                "type": "boolean",
                "default": true
              },
              {
                "id": "min_count",
                "label": "Minimum Node Count",
                "description": "Minimum number of nodes in system pool when autoscaling is enabled.",
                "type": "number",
                "default": 1
              },
              {
                "id": "max_count",
                "label": "Maximum Node Count",
                "description": "Maximum number of nodes in system pool when autoscaling is enabled.",
                "type": "number",
                "default": 3
              },
              {
                "id": "os_disk_size_gb",
                "label": "OS Disk Size (GB)",
                "description": "Size of the OS disk in gigabytes.",
                "type": "number",
                "default": 128
              },
              {
                "id": "vnet_subnet_id",
                "label": "Subnet",
                "description": "Subnet for custom VNet Azure CNI integration (optional).",
                "type": "select",
                "required": false,
                "nullable": true,
                "data_source": {
                  "resource": "network.subnets",
                  "params": {
                    "vnet": {
                      "from_field": "virtual_network_name"
                    },
                    "resource_group": {
                      "from_field": "resource_group_name"
                    }
                  },
                  "display": {
                    "value_key": "id",
                    "label_key": "name",
                    "description_key": "addressPrefix"
                  },
                  "allow_custom": true
                }
              }
            ]
          }
        ]
      },
      {
        "id": "networking_section",
        "label": "Networking & Ingress",
        "description": "CNI network plugin, network policies, and private cluster configuration.",
        "collapsed": false,
        "fields": [
          {
            "id": "virtual_network_name",
            "label": "Virtual Network",
            "description": "Virtual Network containing the AKS subnets (optional, used to select Subnet).",
            "type": "select",
            "ui_only": true,
            "required": false,
            "nullable": true,
            "data_source": {
              "resource": "network.virtualNetworks",
              "params": {
                "resource_group": {
                  "from_field": "resource_group_name"
                }
              },
              "display": {
                "value_key": "name",
                "label_key": "name",
                "description_key": "addressSpace"
              }
            }
          },
          {
            "id": "network_profile",
            "label": "Networking Profile",
            "description": "Container Network Interface (CNI) and load balancer parameters.",
            "type": "object",
            "fields": [
              {
                "id": "network_plugin",
                "label": "Network Plugin",
                "description": "Network plugin used for building Kubernetes network.",
                "type": "select",
                "default": "azure",
                "options": [
                  { "value": "azure", "label": "Azure CNI (Native VNet IP allocation)" },
                  { "value": "kubenet", "label": "Kubenet (Basic routed overlay network)" }
                ]
              },
              {
                "id": "network_policy",
                "label": "Network Policy Engine",
                "description": "Network policy engine used for traffic filtering between pods.",
                "type": "select",
                "default": "azure",
                "options": [
                  { "value": "azure", "label": "Azure Network Policy Manager" },
                  { "value": "calico", "label": "Calico Network Policies" },
                  { "value": "cilium", "label": "Cilium (eBPF-powered network policies)" }
                ]
              },
              {
                "id": "load_balancer_sku",
                "label": "Load Balancer SKU",
                "description": "SKU of the Azure Load Balancer used by the cluster.",
                "type": "select",
                "default": "standard",
                "options": [
                  { "value": "standard", "label": "Standard (Zone redundant, HA)" }
                ]
              },
              {
                "id": "outbound_type",
                "label": "Outbound Routing Type",
                "description": "Outbound routing method used for egress traffic.",
                "type": "select",
                "default": "loadBalancer",
                "options": [
                  { "value": "loadBalancer", "label": "loadBalancer (Managed Public IP)" },
                  { "value": "userDefinedRouting", "label": "userDefinedRouting (Firewall / NVA Egress)" }
                ]
              }
            ]
          },
          {
            "id": "private_cluster_enabled",
            "label": "Private Cluster",
            "description": "Disable public internet endpoint for the Kubernetes API server.",
            "type": "boolean",
            "default": false
          },
          {
            "id": "private_dns_zone_id",
            "label": "Private DNS Zone ID",
            "description": "Private DNS Zone resource ID for private cluster FQDN resolution (or 'System').",
            "type": "text"
          }
        ]
      },
      {
        "id": "security_and_identity_section",
        "label": "Security & Workload Identity",
        "description": "Identity, Microsoft Entra ID, and governance features.",
        "collapsed": false,
        "fields": [
          {
            "id": "identity_type",
            "label": "Managed Identity Type",
            "description": "Managed identity type assigned to the AKS cluster control plane.",
            "type": "select",
            "default": "SystemAssigned",
            "options": [
              { "value": "SystemAssigned", "label": "SystemAssigned" },
              { "value": "UserAssigned", "label": "UserAssigned" }
            ]
          },
          {
            "id": "oidc_issuer_enabled",
            "label": "Enable OIDC Issuer",
            "description": "Enable OIDC discovery endpoint required for Microsoft Entra Workload Identity.",
            "type": "boolean",
            "default": true
          },
          {
            "id": "workload_identity_enabled",
            "label": "Enable Workload Identity",
            "description": "Enable Microsoft Entra Workload Identity for passwordless Azure service access.",
            "type": "boolean",
            "default": true
          },
          {
            "id": "azure_policy_enabled",
            "label": "Enable Azure Policy Add-on",
            "description": "Enforce built-in Azure Policy controls and compliance on cluster workloads.",
            "type": "boolean",
            "default": false
          },
          {
            "id": "local_account_disabled",
            "label": "Disable Local Admin Accounts",
            "description": "Enforce Entra ID authentication and disable local cluster-admin kubeconfig access.",
            "type": "boolean",
            "default": false
          },
          {
            "id": "log_analytics_workspace_id",
            "label": "Log Analytics Workspace",
            "description": "Log Analytics Workspace for Container Insights monitoring.",
            "type": "select",
            "required": false,
            "nullable": true,
            "data_source": {
              "resource": "operationalinsights.workspaces",
              "params": {},
              "display": {
                "value_key": "id",
                "label_key": "name",
                "description_key": "resourceGroup"
              }
            }
          }
        ]
      },
      {
        "id": "node_pools_section",
        "label": "Additional Node Pools",
        "description": "Secondary worker node pools (spot instances, user workloads, or dedicated computing pools).",
        "collapsed": true,
        "fields": [
          {
            "id": "node_pools",
            "label": "Worker Node Pools",
            "description": "List of secondary worker node pool configurations.",
            "type": "repeatable",
            "required": false,
            "default": [],
            "fields": [
              {
                "id": "name",
                "label": "Node Pool Name",
                "description": "Unique name of the node pool (1-12 lowercase letters/numbers).",
                "type": "text",
                "required": true,
                "placeholder": "worker1",
                "validation": {
                  "min": 1,
                  "max": 12,
                  "pattern": "^[a-z][a-z0-9]{0,11}$",
                  "pattern_error": "Node pool name must begin with a lowercase letter, contain only lowercase letters and numbers, and be between 1 and 12 characters in length."
                }
              },
              {
                "id": "vm_size",
                "label": "VM SKU Size",
                "description": "Virtual machine size / SKU for the worker nodes.",
                "type": "select",
                "required": true,
                "default": "Standard_D2s_v5",
                "data_source": {
                  "resource": "compute.vmSizes",
                  "params": {
                    "location": {
                      "from_field": "location"
                    }
                  },
                  "display": {
                    "value_key": "name",
                    "label_key": "name",
                    "description_key": "description"
                  }
                }
              },
              {
                "id": "mode",
                "label": "Node Pool Mode",
                "description": "User mode for application workloads or System mode for cluster services.",
                "type": "select",
                "default": "User",
                "options": [
                  {
                    "value": "User",
                    "label": "User (Application Workloads)"
                  },
                  {
                    "value": "System",
                    "label": "System (Infrastructure / Ingress)"
                  }
                ]
              },
              {
                "id": "auto_scaling_enabled",
                "label": "Enable Autoscaling",
                "description": "Enable Kubernetes cluster autoscaler on this worker pool.",
                "type": "boolean",
                "default": true
              },
              {
                "id": "min_count",
                "label": "Minimum Node Count",
                "description": "Minimum number of nodes when autoscaling is enabled.",
                "type": "number",
                "default": 1,
                "depends_on": {
                  "field": "auto_scaling_enabled",
                  "operator": "eq",
                  "value": true
                }
              },
              {
                "id": "max_count",
                "label": "Maximum Node Count",
                "description": "Maximum number of nodes when autoscaling is enabled.",
                "type": "number",
                "default": 5,
                "depends_on": {
                  "field": "auto_scaling_enabled",
                  "operator": "eq",
                  "value": true
                }
              },
              {
                "id": "node_count",
                "label": "Node Count",
                "description": "Fixed number of nodes when autoscaling is disabled.",
                "type": "number",
                "nullable": true,
                "depends_on": {
                  "field": "auto_scaling_enabled",
                  "operator": "eq",
                  "value": false
                }
              },
              {
                "id": "os_disk_size_gb",
                "label": "OS Disk Size (GB)",
                "description": "Size of the OS disk in gigabytes.",
                "type": "number",
                "default": 128
              },
              {
                "id": "os_disk_type",
                "label": "OS Disk Type",
                "description": "Type of OS disk: Managed or Ephemeral.",
                "type": "select",
                "default": "Managed",
                "options": [
                  {
                    "value": "Managed",
                    "label": "Managed"
                  },
                  {
                    "value": "Ephemeral",
                    "label": "Ephemeral"
                  }
                ]
              },
              {
                "id": "os_sku",
                "label": "OS SKU",
                "description": "Operating system image for the nodes.",
                "type": "select",
                "default": "Ubuntu",
                "options": [
                  {
                    "value": "Ubuntu",
                    "label": "Ubuntu Linux"
                  },
                  {
                    "value": "AzureLinux",
                    "label": "Azure Linux (CBL-Mariner)"
                  }
                ]
              },
              {
                "id": "vnet_subnet_id",
                "label": "Subnet",
                "description": "Subnet for nodes in this pool.",
                "type": "select",
                "required": false,
                "nullable": true,
                "data_source": {
                  "resource": "network.subnets",
                  "params": {
                    "vnet": {
                      "from_field": "virtual_network_name"
                    },
                    "resource_group": {
                      "from_field": "resource_group_name"
                    }
                  },
                  "display": {
                    "value_key": "id",
                    "label_key": "name",
                    "description_key": "addressPrefix"
                  },
                  "allow_custom": true
                }
              },
              {
                "id": "priority",
                "label": "Scale Set Priority",
                "description": "Regular for standard on-demand VMs or Spot for discounted excess capacity.",
                "type": "select",
                "default": "Regular",
                "options": [
                  {
                    "value": "Regular",
                    "label": "Regular (On-Demand)"
                  },
                  {
                    "value": "Spot",
                    "label": "Spot (Discounted / Preemptible)"
                  }
                ]
              },
              {
                "id": "eviction_policy",
                "label": "Spot Eviction Policy",
                "description": "Eviction policy when Spot priority is selected.",
                "type": "select",
                "required": false,
                "nullable": true,
                "options": [
                  {
                    "value": "Delete",
                    "label": "Delete"
                  },
                  {
                    "value": "Deallocate",
                    "label": "Deallocate"
                  }
                ],
                "depends_on": {
                  "field": "priority",
                  "operator": "eq",
                  "value": "Spot"
                }
              },
              {
                "id": "zones",
                "label": "Availability Zones",
                "description": "Availability zones for node placement (e.g. ['1', '2', '3']).",
                "type": "list",
                "default": [
                  "1",
                  "2",
                  "3"
                ]
              }
            ]
          }
        ]
      },
      {
        "id": "tags",
        "label": "Tags",
        "description": "Resource tags for governance and cost tracking.",
        "collapsed": true,
        "fields": [
          {
            "id": "tags",
            "label": "Resource Tags",
            "description": "Key-value pairs to assign to the AKS Cluster.",
            "type": "map"
          }
        ]
      }
    ]
  }
}
