{
  "$schema": "../../../ui-metadata.schema.json",
  "module": "storage-mover",
  "version": "1.0.0",
  "display": {
    "label": "Azure Storage Mover",
    "icon": "azure-storage-mover",
    "description": "Hybrid data migration service to migrate on-premises files and folders to Azure Storage containers.",
    "category": "regional"
  },
  "resource": {
    "variable": "storage_mover",
    "key_field": "name",
    "key_label": "Storage Mover Name",
    "key_description": "The unique name of the Azure Storage Mover instance. Serves as the map key.",
    "sections": [
      {
        "id": "basic",
        "label": "Basic Configuration",
        "description": "Storage Mover service identity and regional settings.",
        "collapsed": false,
        "fields": [
          {
            "id": "name",
            "label": "Storage Mover Name",
            "description": "The name of the Storage Mover resource. Changing this forces a new resource to be created.",
            "type": "text",
            "required": true,
            "placeholder": "sm-migration-workload"
          },
          {
            "id": "resource_group_name",
            "label": "Resource Group Name",
            "description": "The name of the Resource Group in which to create the Storage Mover.",
            "type": "select",
            "required": true,
            "data_source": {
              "resource": "resources.resourceGroups",
              "params": {},
              "display": "name"
            }
          },
          {
            "id": "location",
            "label": "Region",
            "description": "The Azure Region where the Storage Mover should exist.",
            "type": "select",
            "required": true,
            "options": [
              { "value": "eastus", "label": "East US (Virginia)" },
              { "value": "eastus2", "label": "East US 2 (Virginia)" },
              { "value": "westus", "label": "West US (California)" },
              { "value": "westus2", "label": "West US 2 (Washington)" },
              { "value": "westus3", "label": "West US 3 (Phoenix)" },
              { "value": "centralus", "label": "Central US (Iowa)" },
              { "value": "northcentralus", "label": "North Central US (Illinois)" },
              { "value": "southcentralus", "label": "South Central US (Texas)" },
              { "value": "westeurope", "label": "West Europe (Netherlands)" },
              { "value": "northeurope", "label": "North Europe (Ireland)" },
              { "value": "uksouth", "label": "UK South (London)" },
              { "value": "ukwest", "label": "UK West (Cardiff)" },
              { "value": "southeastasia", "label": "Southeast Asia (Singapore)" },
              { "value": "eastasia", "label": "East Asia (Hong Kong)" },
              { "value": "australiaeast", "label": "Australia East (New South Wales)" },
              { "value": "centralindia", "label": "Central India (Pune)" },
              { "value": "canadacentral", "label": "Canada Central (Toronto)" },
              { "value": "germanywestcentral", "label": "Germany West Central (Frankfurt)" },
              { "value": "francecentral", "label": "France Central (Paris)" },
              { "value": "japaneast", "label": "Japan East (Tokyo, Saitama)" },
              { "value": "brazilsouth", "label": "Brazil South (Sao Paulo State)" },
              { "value": "uaenorth", "label": "UAE North (Dubai)" },
              { "value": "southafricanorth", "label": "South Africa North (Johannesburg)" },
              { "value": "switzerlandnorth", "label": "Switzerland North (Zurich)" },
              { "value": "swedencentral", "label": "Sweden Central (Gavle)" },
              { "value": "israelcentral", "label": "Israel Central (Tel Aviv)" }
            ]
          },
          {
            "id": "description",
            "label": "Description",
            "description": "A description for the Storage Mover instance.",
            "type": "text",
            "placeholder": "Hybrid data migration instance for datacenter migration"
          }
        ]
      },
      {
        "id": "migration_configuration",
        "label": "Projects & Endpoints",
        "description": "Projects, source/target endpoints, and job definitions.",
        "collapsed": false,
        "fields": [
          {
            "id": "projects",
            "label": "Projects",
            "description": "Map of Storage Mover projects to create.",
            "type": "map"
          },
          {
            "id": "source_endpoints",
            "label": "Source Endpoints",
            "description": "Map of NFS source endpoints to configure.",
            "type": "map"
          },
          {
            "id": "target_endpoints",
            "label": "Target Endpoints",
            "description": "Map of Azure Storage container target endpoints.",
            "type": "map"
          },
          {
            "id": "job_definitions",
            "label": "Job Definitions",
            "description": "Map of migration job definitions linking project, source, and target endpoints.",
            "type": "map"
          },
          {
            "id": "agents",
            "label": "Agents",
            "description": "Map of Azure Arc VM migration agents to register with the Storage Mover.",
            "type": "map"
          }
        ]
      },
      {
        "id": "tags",
        "label": "Tags",
        "description": "Resource tags for governance and cost tracking.",
        "collapsed": true,
        "fields": [
          {
            "id": "tags",
            "label": "Resource Tags",
            "description": "Key-value pairs to assign to the Storage Mover.",
            "type": "map"
          }
        ]
      }
    ]
  }
}
