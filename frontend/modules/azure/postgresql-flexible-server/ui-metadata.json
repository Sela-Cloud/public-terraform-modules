{
  "$schema": "../../../ui-metadata.schema.json",
  "module": "postgresql-flexible-server",
  "version": "1.0.0",
  "display": {
    "label": "Azure Database for PostgreSQL Flexible Server",
    "icon": "postgresql",
    "description": "Fully managed PostgreSQL database service with zone redundancy, automatic backups, and flexible scaling.",
    "category": "database"
  },
  "resource": {
    "variable": "postgresql_flexible_server",
    "key_field": "name",
    "key_label": "PostgreSQL Server Name",
    "key_description": "The unique name for the PostgreSQL Flexible Server. Serves as the map key.",
    "sections": [
      {
        "id": "basic",
        "label": "Basic Configuration",
        "description": "Server identity, resource group, region, and credentials.",
        "collapsed": false,
        "fields": [
          {
            "id": "name",
            "label": "Server Name",
            "description": "Name of the PostgreSQL Flexible Server. Must be between 3 and 63 characters.",
            "type": "text",
            "required": true,
            "placeholder": "psql-my-workload"
          },
          {
            "id": "resource_group_name",
            "label": "Resource Group Name",
            "description": "The name of the Resource Group in which to create the server.",
            "type": "select",
            "required": true,
            "data_source": {
              "resource": "resources.resourceGroups",
              "params": {},
              "display": {
                "value_key": "name",
                "label_key": "name"
              }
            }
          },
          {
            "id": "location",
            "label": "Region",
            "description": "The Azure Region where the PostgreSQL Flexible Server should be created.",
            "type": "select",
            "required": true,
            "options": [
              { "value": "eastus", "label": "East US (Virginia)" },
              { "value": "eastus2", "label": "East US 2 (Virginia)" },
              { "value": "westus", "label": "West US (California)" },
              { "value": "westus2", "label": "West US 2 (Washington)" },
              { "value": "westus3", "label": "West US 3 (Phoenix)" },
              { "value": "centralus", "label": "Central US (Iowa)" },
              { "value": "northcentralus", "label": "North Central US (Illinois)" },
              { "value": "southcentralus", "label": "South Central US (Texas)" },
              { "value": "westeurope", "label": "West Europe (Netherlands)" },
              { "value": "northeurope", "label": "North Europe (Ireland)" },
              { "value": "uksouth", "label": "UK South (London)" },
              { "value": "ukwest", "label": "UK West (Cardiff)" },
              { "value": "southeastasia", "label": "Southeast Asia (Singapore)" },
              { "value": "eastasia", "label": "East Asia (Hong Kong)" },
              { "value": "australiaeast", "label": "Australia East (New South Wales)" },
              { "value": "centralindia", "label": "Central India (Pune)" },
              { "value": "canadacentral", "label": "Canada Central (Toronto)" },
              { "value": "germanywestcentral", "label": "Germany West Central (Frankfurt)" },
              { "value": "francecentral", "label": "France Central (Paris)" },
              { "value": "japaneast", "label": "Japan East (Tokyo, Saitama)" },
              { "value": "brazilsouth", "label": "Brazil South (Sao Paulo State)" },
              { "value": "uaenorth", "label": "UAE North (Dubai)" },
              { "value": "southafricanorth", "label": "South Africa North (Johannesburg)" },
              { "value": "switzerlandnorth", "label": "Switzerland North (Zurich)" },
              { "value": "swedencentral", "label": "Sweden Central (Gavle)" },
              { "value": "israelcentral", "label": "Israel Central (Tel Aviv)" }
            ]
          },
          {
            "id": "administrator_login",
            "label": "Administrator Login",
            "description": "Administrator username for the PostgreSQL server.",
            "type": "text",
            "default": "pgadmin"
          },
          {
            "id": "administrator_password",
            "label": "Administrator Password",
            "description": "Administrator password for the PostgreSQL server.",
            "type": "text"
          },
          {
            "id": "zone",
            "label": "Availability Zone",
            "description": "Specifies the Availability Zone in which this server should be located (e.g. 1, 2, 3).",
            "type": "text"
          }
        ]
      },
      {
        "id": "compute_and_storage",
        "label": "Compute & Storage",
        "description": "SKU size, PostgreSQL engine version, and storage configurations.",
        "collapsed": false,
        "fields": [
          {
            "id": "sku_name",
            "label": "Compute Tier / SKU",
            "description": "Compute tier and size for the PostgreSQL Flexible Server.",
            "type": "select",
            "required": true,
            "default": "B_Standard_B1ms",
            "options": [
              { "value": "B_Standard_B1ms", "label": "Burstable B1ms (1 vCore, 2 GiB RAM)" },
              { "value": "B_Standard_B2s", "label": "Burstable B2s (2 vCores, 4 GiB RAM)" },
              { "value": "GP_Standard_D2s_v3", "label": "General Purpose D2s_v3 (2 vCores, 8 GiB RAM)" },
              { "value": "GP_Standard_D4s_v3", "label": "General Purpose D4s_v3 (4 vCores, 16 GiB RAM)" },
              { "value": "GP_Standard_D2ds_v4", "label": "General Purpose D2ds_v4 (2 vCores, 8 GiB RAM)" },
              { "value": "GP_Standard_D4ds_v4", "label": "General Purpose D4ds_v4 (4 vCores, 16 GiB RAM)" },
              { "value": "MO_Standard_E2s_v3", "label": "Memory Optimized E2s_v3 (2 vCores, 16 GiB RAM)" },
              { "value": "MO_Standard_E4s_v3", "label": "Memory Optimized E4s_v3 (4 vCores, 32 GiB RAM)" }
            ]
          },
          {
            "id": "server_version",
            "label": "PostgreSQL Version",
            "description": "Major engine version of PostgreSQL.",
            "type": "select",
            "required": true,
            "default": "16",
            "options": [
              { "value": "16", "label": "PostgreSQL 16" },
              { "value": "15", "label": "PostgreSQL 15" },
              { "value": "14", "label": "PostgreSQL 14" },
              { "value": "13", "label": "PostgreSQL 13" },
              { "value": "12", "label": "PostgreSQL 12" },
              { "value": "11", "label": "PostgreSQL 11" }
            ]
          },
          {
            "id": "storage_mb",
            "label": "Storage Size (MB)",
            "description": "Max storage allowed for the server in MB (e.g. 32768 for 32GB, 65536 for 64GB).",
            "type": "number",
            "default": 32768
          },
          {
            "id": "auto_grow_enabled",
            "label": "Enable Auto-Grow",
            "description": "Whether storage auto-grow is enabled.",
            "type": "boolean",
            "default": true
          }
        ]
      },
      {
        "id": "backup_and_ha",
        "label": "Backup & High Availability",
        "description": "Automated backups and disaster recovery settings.",
        "collapsed": true,
        "fields": [
          {
            "id": "backup_retention_days",
            "label": "Backup Retention Days",
            "description": "Number of days retention for automated backups (7 to 35).",
            "type": "number",
            "default": 7
          },
          {
            "id": "geo_redundant_backup_enabled",
            "label": "Geo-Redundant Backup",
            "description": "Whether geo-redundant backups are enabled.",
            "type": "boolean",
            "default": false
          }
        ]
      },
      {
        "id": "networking",
        "label": "Networking & Private Access",
        "description": "Public network toggle and VNet delegated subnet integration.",
        "collapsed": true,
        "fields": [
          {
            "id": "public_network_access_enabled",
            "label": "Allow Public Network Access",
            "description": "Whether public network access is enabled.",
            "type": "boolean",
            "default": true
          },
          {
            "id": "delegated_subnet_id",
            "label": "Delegated Subnet ID",
            "description": "Subnet ID delegated to Microsoft.DBforPostgreSQL/flexibleServers for private access.",
            "type": "text"
          },
          {
            "id": "private_dns_zone_id",
            "label": "Private DNS Zone ID",
            "description": "Private DNS zone resource ID for private VNet resolution.",
            "type": "text"
          }
        ]
      },
      {
        "id": "tags",
        "label": "Tags",
        "description": "Resource tags for governance and cost tracking.",
        "collapsed": true,
        "fields": [
          {
            "id": "tags",
            "label": "Resource Tags",
            "description": "Key-value pairs to assign to the PostgreSQL Flexible Server.",
            "type": "map"
          }
        ]
      }
    ]
  }
}
