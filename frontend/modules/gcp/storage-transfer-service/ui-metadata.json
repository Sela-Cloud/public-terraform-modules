{
  "$schema": "../../../ui-metadata.schema.json",
  "module": "storage-transfer-service",
  "version": "1.1.0",
  "display": {
    "label": "Storage Transfer Service",
    "icon": "storage-transfer-service",
    "description": "Copy objects from AWS S3, Azure Blob Storage or another Cloud Storage bucket into a Cloud Storage bucket — once, on a recurring schedule, or as soon as they change.",
    "category": "global"
  },
  "globals": [
    {
      "id": "project_id",
      "label": "Project ID",
      "type": "text",
      "required": true,
      "placeholder": "my-gcp-project"
    }
  ],
  "resource": {
    "variable": "storage_transfer_service",
    "key_field": "name",
    "key_label": "Deployment name",
    "key_description": "A name for this group of transfer jobs.",
    "sections": [
      {
        "id": "basics",
        "label": "Configuration",
        "fields": [
          {
            "id": "name",
            "label": "Deployment name",
            "type": "text",
            "required": true,
            "placeholder": "backup-jobs",
            "validation": {
              "min": 1,
              "max": 50,
              "pattern": "^[a-z][a-z0-9-]*$",
              "pattern_error": "Use lowercase letters, numbers, and hyphens; start with a letter."
            }
          },
          {
            "id": "source_type",
            "label": "Source",
            "description": "Where transfer jobs in this deployment copy from. Choose one; the matching job list appears below.",
            "type": "select",
            "required": true,
            "options": [
              {
                "value": "aws_s3",
                "label": "AWS S3"
              },
              {
                "value": "azure_blob",
                "label": "Azure Blob Storage"
              },
              {
                "value": "gcs",
                "label": "Cloud Storage"
              }
            ]
          },
          {
            "id": "grant_destination_bucket_access",
            "label": "Grant the transfer service access to destination buckets",
            "description": "Automatically grants this project's Storage Transfer service agent write access to every destination bucket used below. Turn off if bucket access is already managed elsewhere.",
            "type": "boolean",
            "default": true
          },
          {
            "id": "grant_source_access",
            "label": "Grant the transfer service access to Cloud Storage sources",
            "description": "For Cloud Storage sources only: grants this project's Storage Transfer service agent read access to each source bucket (write access if a job deletes from source), and subscriber access to the Pub/Sub subscription of each event-driven job. AWS and Azure sources use their own credentials and are unaffected. Turn off if access is managed elsewhere.",
            "type": "boolean",
            "default": true,
            "depends_on": {
              "field": "source_type",
              "value": "gcs"
            }
          }
        ]
      },
      {
        "id": "aws-jobs",
        "label": "AWS S3 transfer jobs",
        "description": "Each job copies from one AWS S3 bucket into one Cloud Storage destination.",
        "depends_on": {
          "field": "source_type",
          "value": "aws_s3"
        },
        "fields": [
          {
            "id": "aws_jobs",
            "label": "Transfer jobs",
            "type": "repeatable",
            "fields": [
              {
                "id": "job_name",
                "label": "Job name",
                "type": "text",
                "required": true,
                "validation": {
                  "pattern": "^[a-z][a-z0-9-]*$",
                  "pattern_error": "Use lowercase letters, numbers, and hyphens."
                }
              },
              {
                "id": "description",
                "label": "Description",
                "type": "text"
              },
              {
                "id": "enabled",
                "label": "Enabled",
                "type": "boolean",
                "default": true
              },
              {
                "id": "bucket_name",
                "label": "S3 bucket name",
                "type": "text",
                "required": true
              },
              {
                "id": "path",
                "label": "Path prefix (optional)",
                "type": "text"
              },
              {
                "id": "auth_method",
                "label": "Authentication method",
                "type": "select",
                "required": true,
                "default": "role_arn",
                "options": [
                  {
                    "value": "role_arn",
                    "label": "IAM role ARN"
                  },
                  {
                    "value": "access_key",
                    "label": "Access key / secret key"
                  }
                ]
              },
              {
                "id": "role_arn",
                "label": "AWS IAM role ARN",
                "description": "The AWS IAM role Storage Transfer Service assumes to read this bucket.",
                "type": "text",
                "required": true,
                "placeholder": "arn:aws:iam::123456789012:role/gcp-storage-transfer",
                "depends_on": {
                  "field": "auth_method",
                  "value": "role_arn"
                }
              },
              {
                "id": "access_key_id",
                "label": "AWS access key ID",
                "type": "text",
                "required": true,
                "sensitive": true,
                "depends_on": {
                  "field": "auth_method",
                  "value": "access_key"
                }
              },
              {
                "id": "secret_access_key",
                "label": "AWS secret access key",
                "type": "text",
                "required": true,
                "sensitive": true,
                "depends_on": {
                  "field": "auth_method",
                  "value": "access_key"
                }
              },
              {
                "id": "dest_gcs_bucket",
                "label": "Destination Cloud Storage bucket",
                "type": "select",
                "required": true,
                "data_source": {
                  "resource": "storage.buckets",
                  "params": {
                    "project_id": {
                      "from_field": "project_id"
                    }
                  },
                  "display": {
                    "value_key": "name",
                    "label_key": "name",
                    "description_key": "description"
                  },
                  "allow_custom": true,
                  "cache_ttl": 300
                }
              },
              {
                "id": "dest_path",
                "label": "Destination path prefix (optional)",
                "type": "text"
              },
              {
                "id": "include_prefixes",
                "label": "Include only object prefixes",
                "type": "list"
              },
              {
                "id": "exclude_prefixes",
                "label": "Exclude object prefixes",
                "type": "list"
              },
              {
                "id": "overwrite_when",
                "label": "Overwrite objects in destination",
                "type": "select",
                "default": "NEVER",
                "options": [
                  {
                    "value": "NEVER",
                    "label": "Never overwrite"
                  },
                  {
                    "value": "DIFFERENT",
                    "label": "Overwrite when different"
                  },
                  {
                    "value": "ALWAYS",
                    "label": "Always overwrite"
                  }
                ]
              },
              {
                "id": "delete_objects_from_source_after_transfer",
                "label": "Delete source objects after transfer",
                "type": "boolean",
                "default": false
              },
              {
                "id": "delete_objects_unique_in_sink",
                "label": "Delete destination objects not present in source",
                "type": "boolean",
                "default": false
              },
              {
                "id": "trigger",
                "label": "Run",
                "description": "On a schedule copies everything matching on each run. When objects change listens for notifications and copies new or updated objects as they arrive — deletions at the source are not propagated in that mode.",
                "type": "select",
                "default": "schedule",
                "options": [
                  {
                    "value": "schedule",
                    "label": "On a schedule, or once"
                  },
                  {
                    "value": "event",
                    "label": "When objects change (event-driven)"
                  }
                ]
              },
              {
                "id": "event_stream",
                "label": "Change notifications",
                "type": "object",
                "depends_on": {
                  "field": "trigger",
                  "value": "event"
                },
                "fields": [
                  {
                    "id": "name",
                    "label": "SQS queue ARN",
                    "description": "The SQS queue your bucket sends \"All object create events\" to. The job's AWS credentials also need sqs:ReceiveMessage, sqs:DeleteMessage and sqs:ChangeMessageVisibility on it.",
                    "type": "text",
                    "required": true,
                    "placeholder": "arn:aws:sqs:us-east-1:123456789012:s3-events"
                  },
                  {
                    "id": "start_time",
                    "label": "Start listening at (optional)",
                    "description": "RFC 3339 in UTC, e.g. 2026-10-01T00:00:00Z. Empty or in the past means now.",
                    "type": "text",
                    "placeholder": "2026-10-01T00:00:00Z"
                  },
                  {
                    "id": "expiration_time",
                    "label": "Stop listening at (optional)",
                    "description": "RFC 3339 in UTC. Empty means listen indefinitely.",
                    "type": "text",
                    "placeholder": "2027-10-01T00:00:00Z"
                  }
                ]
              },
              {
                "id": "schedule",
                "label": "Recurring schedule",
                "description": "Leave empty to run this job once, immediately, when deployed.",
                "type": "object",
                "nullable": true,
                "fields": [
                  {
                    "id": "start_date",
                    "label": "Start date",
                    "type": "object",
                    "fields": [
                      {
                        "id": "year",
                        "label": "Year",
                        "type": "number",
                        "required": true,
                        "validation": {
                          "min": 2020
                        }
                      },
                      {
                        "id": "month",
                        "label": "Month",
                        "type": "number",
                        "required": true,
                        "validation": {
                          "min": 1,
                          "max": 12
                        }
                      },
                      {
                        "id": "day",
                        "label": "Day",
                        "type": "number",
                        "required": true,
                        "validation": {
                          "min": 1,
                          "max": 31
                        }
                      }
                    ]
                  },
                  {
                    "id": "end_date",
                    "label": "End date (optional)",
                    "type": "object",
                    "nullable": true,
                    "fields": [
                      {
                        "id": "year",
                        "label": "Year",
                        "type": "number",
                        "required": true,
                        "validation": {
                          "min": 2020
                        }
                      },
                      {
                        "id": "month",
                        "label": "Month",
                        "type": "number",
                        "required": true,
                        "validation": {
                          "min": 1,
                          "max": 12
                        }
                      },
                      {
                        "id": "day",
                        "label": "Day",
                        "type": "number",
                        "required": true,
                        "validation": {
                          "min": 1,
                          "max": 31
                        }
                      }
                    ]
                  },
                  {
                    "id": "start_time",
                    "label": "Start time of day (optional, UTC)",
                    "type": "object",
                    "nullable": true,
                    "fields": [
                      {
                        "id": "hours",
                        "label": "Hour (0-23)",
                        "type": "number",
                        "required": true,
                        "validation": {
                          "min": 0,
                          "max": 23
                        }
                      },
                      {
                        "id": "minutes",
                        "label": "Minute",
                        "type": "number",
                        "required": true,
                        "validation": {
                          "min": 0,
                          "max": 59
                        }
                      },
                      {
                        "id": "seconds",
                        "label": "Second",
                        "type": "number",
                        "default": 0,
                        "validation": {
                          "min": 0,
                          "max": 59
                        }
                      }
                    ]
                  },
                  {
                    "id": "repeat_interval_days",
                    "label": "Repeat every N days (leave empty to run once on start date)",
                    "type": "number",
                    "validation": {
                      "min": 1
                    }
                  }
                ],
                "depends_on": {
                  "field": "trigger",
                  "value": "schedule"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "azure-jobs",
        "label": "Azure Blob transfer jobs",
        "description": "Each job copies from one Azure Blob container into one Cloud Storage destination.",
        "depends_on": {
          "field": "source_type",
          "value": "azure_blob"
        },
        "fields": [
          {
            "id": "azure_jobs",
            "label": "Transfer jobs",
