                "default": true
              },
              {
                "id": "storage_account",
                "label": "Storage account",
                "type": "text",
                "required": true
              },
              {
                "id": "container",
                "label": "Container",
                "type": "text",
                "required": true
              },
              {
                "id": "path",
                "label": "Path prefix (optional)",
                "type": "text"
              },
              {
                "id": "sas_token",
                "label": "SAS token",
                "description": "A shared access signature token scoped to this container, granting Storage Transfer Service read access.",
                "type": "text",
                "required": true,
                "sensitive": true
              },
              {
                "id": "dest_gcs_bucket",
                "label": "Destination Cloud Storage bucket",
                "type": "select",
                "required": true,
                "data_source": {
                  "resource": "storage.buckets",
                  "params": {
                    "project_id": {
                      "from_field": "project_id"
                    }
                  },
                  "display": {
                    "value_key": "name",
                    "label_key": "name",
                    "description_key": "description"
                  },
                  "allow_custom": true,
                  "cache_ttl": 300
                }
              },
              {
                "id": "dest_path",
                "label": "Destination path prefix (optional)",
                "type": "text"
              },
              {
                "id": "include_prefixes",
