                          "max": 23
                        }
                      },
                      {
                        "id": "minutes",
                        "label": "Minute",
                        "type": "number",
                        "required": true,
                        "validation": {
                          "min": 0,
                          "max": 59
                        }
                      },
                      {
                        "id": "seconds",
                        "label": "Second",
                        "type": "number",
                        "default": 0,
                        "validation": {
                          "min": 0,
                          "max": 59
                        }
                      }
                    ]
                  },
                  {
                    "id": "repeat_interval_days",
                    "label": "Repeat every N days (leave empty to run once on start date)",
