      },
      {
        "id": "gcs-jobs",
        "label": "Cloud Storage transfer jobs",
        "description": "Each job copies from one Cloud Storage bucket into another.",
        "depends_on": {
          "field": "source_type",
          "value": "gcs"
        },
        "fields": [
          {
            "id": "gcs_jobs",
            "label": "Transfer jobs",
            "type": "repeatable",
            "fields": [
              {
                "id": "job_name",
                "label": "Job name",
                "type": "text",
                "required": true,
                "validation": {
                  "pattern": "^[a-z][a-z0-9-]*$",
                  "pattern_error": "Use lowercase letters, numbers, and hyphens."
                }
              },
              {
                "id": "description",
                "label": "Description",
                "type": "text"
              },
              {
                "id": "enabled",
                "label": "Enabled",
                "type": "boolean",
                "default": true
              },
              {
                "id": "bucket_name",
                "label": "Source Cloud Storage bucket",
                "type": "select",
                "required": true,
                "data_source": {
                  "resource": "storage.buckets",
                  "params": {
                    "project_id": {
                      "from_field": "project_id"
                    }
                  },
                  "display": {
                    "value_key": "name",
                    "label_key": "name",
                    "description_key": "description"
                  },
                  "allow_custom": true,
                  "cache_ttl": 300
                }
              },
              {
                "id": "path",
                "label": "Path prefix (optional)",
                "description": "Only objects under this prefix. Must end with '/', e.g. exports/.",
                "type": "text",
                "placeholder": "exports/",
                "validation": {
                  "pattern": "^$|/$",
                  "pattern_error": "Leave empty, or end the prefix with '/'."
                }
              },
              {
                "id": "dest_gcs_bucket",
                "label": "Destination Cloud Storage bucket",
                "type": "select",
                "required": true,
                "data_source": {
                  "resource": "storage.buckets",
                  "params": {
                    "project_id": {
                      "from_field": "project_id"
                    }
                  },
                  "display": {
                    "value_key": "name",
                    "label_key": "name",
                    "description_key": "description"
                  },
                  "allow_custom": true,
                  "cache_ttl": 300
                }
              },
              {
                "id": "dest_path",
                "label": "Destination path prefix (optional)",
                "type": "text"
              },
              {
                "id": "include_prefixes",
                "label": "Include only object prefixes",
                "type": "list"
              },
              {
                "id": "exclude_prefixes",
                "label": "Exclude object prefixes",
                "type": "list"
              },
              {
                "id": "overwrite_when",
                "label": "Overwrite objects in destination",
                "type": "select",
                "default": "NEVER",
                "options": [
                  {
                    "value": "NEVER",
                    "label": "Never overwrite"
                  },
                  {
                    "value": "DIFFERENT",
                    "label": "Overwrite when different"
                  },
                  {
                    "value": "ALWAYS",
                    "label": "Always overwrite"
                  }
                ]
              },
              {
                "id": "delete_objects_from_source_after_transfer",
                "label": "Delete source objects after transfer",
                "type": "boolean",
                "default": false
              },
              {
                "id": "delete_objects_unique_in_sink",
                "label": "Delete destination objects not present in source",
                "type": "boolean",
                "default": false
              },
              {
                "id": "trigger",
                "label": "Run",
                "description": "On a schedule copies everything matching on each run. When objects change listens for notifications and copies new or updated objects as they arrive — deletions at the source are not propagated in that mode.",
                "type": "select",
                "default": "schedule",
                "options": [
                  {
                    "value": "schedule",
                    "label": "On a schedule, or once"
                  },
                  {
                    "value": "event",
                    "label": "When objects change (event-driven)"
                  }
                ]
              },
              {
                "id": "event_stream",
                "label": "Change notifications",
                "type": "object",
                "depends_on": {
                  "field": "trigger",
                  "value": "event"
                },
                "fields": [
                  {
                    "id": "name",
                    "label": "Pub/Sub subscription",
                    "description": "A subscription to the topic your source bucket's Pub/Sub notifications publish to (`gcloud storage buckets notifications create gs://BUCKET --topic=TOPIC`).",
                    "type": "text",
                    "required": true,
                    "placeholder": "projects/my-project/subscriptions/bucket-changes"
                  },
                  {
                    "id": "start_time",
                    "label": "Start listening at (optional)",
                    "description": "RFC 3339 in UTC, e.g. 2026-10-01T00:00:00Z. Empty or in the past means now.",
                    "type": "text",
                    "placeholder": "2026-10-01T00:00:00Z"
                  },
                  {
                    "id": "expiration_time",
                    "label": "Stop listening at (optional)",
                    "description": "RFC 3339 in UTC. Empty means listen indefinitely.",
                    "type": "text",
                    "placeholder": "2027-10-01T00:00:00Z"
                  }
                ]
              },
              {
