{
  "$schema": "../../ui-metadata.schema.json",
  "module": "cloud-sql-database",
  "version": "1.0.0",
  "display": {
    "label": "Cloud SQL Database",
    "icon": "cloud-sql",
    "description": "A single database on an existing Cloud SQL instance, with its own lifecycle",
    "category": "regional"
  },
  "globals": [
    {
      "id": "project_id",
      "label": "Project ID",
      "description": "GCP Project ID that owns the parent Cloud SQL instance.",
      "type": "text",
      "required": true,
      "placeholder": "my-gcp-project"
    }
  ],
  "import": {
    "module": "cloud_sql_database",
    "target": "google_sql_database.this",
    "id_template": "projects/{project_id}/instances/{instance_name}/databases/{name}",
    "identity_fields": [
      "project_id",
      "instance_name",
      "name",
      "database_key"
    ],
    "field_map": {
      "instance": "instance_name"
    },
    "requires_review": false
  },
  "resource": {
    "variable": "cloud_sql_database",
    "key_field": "database_key",
    "key_label": "Database entry ID",
    "key_description": "Unique Terraform map key for this database. Use the instance-database convention, for example orders-db-analytics.",
    "locked_after_create": true,
    "sections": [
      {
        "id": "basics",
        "label": "Database configuration",
        "description": "The parent Cloud SQL instance must already exist in this environment.",
        "fields": [
          {
            "id": "database_key",
            "label": "Database entry ID",
            "description": "Unique key for this database entry. Use the instance-database convention, for example orders-db-analytics.",
            "locked_after_create": true,
            "type": "text",
            "required": true,
            "validation": {
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
              "pattern_error": "Use lowercase letters, numbers and hyphens."
            }
          },
          {
            "id": "instance_name",
            "label": "Cloud SQL instance ID",
            "description": "The Cloud SQL instance that hosts this database. Pick from the instances that exist in this project, or type a name if the instance is being created in the same change. Read replicas are not listed \u2014 they cannot own databases.",
            "locked_after_create": true,
            "type": "select",
            "required": true,
            "data_source": {
              "resource": "cloudsql.instances",
              "params": {
                "project_id": {
                  "from_field": "project_id"
                }
              },
              "display": {
                "value_key": "name",
                "label_key": "name",
                "description_key": "description"
              },
              "allow_custom": true,
              "cache_ttl": 300
            },
            "validation": {
              "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$",
              "pattern_error": "Must start with a lowercase letter and contain only lowercase letters, numbers and hyphens."
            }
          },
          {
            "id": "name",
            "label": "Database name",
            "description": "Name of the database as it appears inside the instance.",
            "locked_after_create": true,
            "type": "text",
            "required": true
          }
        ]
      },
      {
        "id": "advanced",
        "label": "Character set and lifecycle",
        "collapsed": true,
        "fields": [
          {
            "id": "charset",
            "label": "Charset (optional)",
            "type": "text"
          },
          {
            "id": "collation",
            "label": "Collation (optional)",
            "type": "text"
          },
          {
            "id": "deletion_policy",
            "label": "Deletion policy",
            "type": "select",
            "default": "ABANDON",
            "options": [
              {
                "value": "ABANDON",
                "label": "Abandon on Terraform destroy"
              },
              {
                "value": "DELETE",
                "label": "Delete on Terraform destroy"
              }
            ]
          }
        ]
      }
    ]
  }
}
