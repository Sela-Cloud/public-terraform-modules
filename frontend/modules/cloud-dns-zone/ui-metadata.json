{
  "$schema": "../ui-metadata.schema.json",
  "module": "cloud-dns-zone",
  "version": "1.0.0",
  "display": {
    "label": "Cloud DNS Zone",
    "icon": "network",
    "description": "Public, private, forwarding, and peering Cloud DNS managed zones.",
    "category": "global"
  },
  "globals": [
    {
      "id": "project_id",
      "label": "Project ID",
      "type": "text",
      "required": true,
      "placeholder": "my-gcp-project"
    }
  ],
  "provides": [
    {
      "data_source": "dns.managedZones",
      "value_field": "name"
    }
  ],
  "import": {
    "module": "cloud_dns_zone",
    "target": "google_dns_managed_zone.this",
    "id_template": "projects/{project_id}/managedZones/{name}",
    "identity_fields": [
      "project_id",
      "name"
    ],
    "requires_review": false
  },
  "resource": {
    "variable": "cloud_dns_zone",
    "key_field": "name",
    "key_label": "Managed zone name",
    "key_description": "Managed zone names and DNS names identify the zone in Terraform.",
    "locked_after_create": true,
    "sections": [
      {
        "id": "basics",
        "label": "Zone configuration",
        "fields": [
          {
            "id": "name",
            "label": "Managed zone name",
            "locked_after_create": true,
            "type": "text",
            "required": true,
            "placeholder": "corp-example-com",
            "validation": {
              "min": 1,
              "max": 63,
              "pattern": "^[a-z][a-z0-9-]{0,62}$",
              "pattern_error": "Use lowercase letters, numbers, and hyphens; start with a letter."
            }
          },
          {
            "id": "dns_name",
            "label": "DNS name",
            "locked_after_create": true,
            "description": "Fully qualified DNS suffix ending with a dot, for example example.com.",
            "type": "text",
            "required": true,
            "placeholder": "example.com.",
            "validation": {
              "pattern": "^.+\\.$",
              "pattern_error": "DNS names must end with a trailing dot."
            }
          },
          {
            "id": "visibility",
            "label": "Visibility",
            "locked_after_create": true,
            "type": "select",
            "required": true,
            "default": "public",
            "options": [
              {
                "value": "public",
                "label": "Public"
              },
              {
                "value": "private",
                "label": "Private"
              }
            ]
          },
          {
            "id": "zone_type",
            "label": "Private zone type",
            "description": "Forwarding and peering zones are private. Standard creates a conventional authoritative zone.",
            "type": "select",
            "required": true,
            "default": "standard",
            "options": [
              {
                "value": "standard",
                "label": "Standard"
              },
              {
                "value": "forwarding",
                "label": "Forwarding"
              },
              {
                "value": "peering",
                "label": "Peering"
              }
            ]
          },
          {
            "id": "description",
            "label": "Description",
            "type": "text",
            "validation": {
              "max": 1024
            }
          },
          {
            "id": "labels",
            "label": "Labels",
            "type": "map"
          }
        ]
      },
      {
        "id": "private-visibility",
        "label": "Private zone networks",
        "description": "Private zones must be associated with one or more VPC networks.",
        "depends_on": {
          "field": "visibility",
          "value": "private"
        },
        "fields": [
          {
            "id": "private_networks",
            "label": "VPC networks",
            "type": "list",
            "required": true,
            "data_source": {
              "resource": "compute.networks",
              "params": {
                "project_id": {
                  "from_field": "project_id"
                }
              },
              "display": {
                "value_key": "name",
                "label_key": "name",
                "description_key": "description"
              },
              "allow_custom": true,
              "cache_ttl": 300
            }
          }
        ]
      },
      {
        "id": "forwarding",
        "label": "Forwarding targets",
        "description": "Use one FQDN target or one or more IP targets. The target must be reachable from every authorized VPC.",
        "depends_on": {
          "field": "zone_type",
          "value": "forwarding"
        },
        "fields": [
          {
            "id": "forwarding_targets",
            "label": "Target name servers",
            "type": "repeatable",
            "required": true,
            "fields": [
              {
                "id": "ipv4_address",
                "label": "IPv4 address",
                "type": "text",
                "validation": {
                  "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}$",
                  "pattern_error": "Enter a valid IPv4 address."
                }
              },
              {
                "id": "ipv6_address",
                "label": "IPv6 address",
                "type": "text",
                "validation": {
                  "pattern": "^[0-9A-Fa-f:]+$",
                  "pattern_error": "Enter a valid IPv6 address."
                }
              },
              {
                "id": "domain_name",
                "label": "Fully qualified domain name",
                "description": "Use this instead of IP targets. Cloud DNS permits only one FQDN target per forwarding zone.",
                "type": "text",
                "validation": {
                  "pattern": "^.+\\.$",
                  "pattern_error": "Use a fully qualified name ending with a dot."
                }
              },
              {
                "id": "forwarding_path",
                "label": "Forwarding path",
                "type": "select",
                "default": "default",
                "options": [
                  {
                    "value": "default",
                    "label": "Default routing"
                  },
                  {
                    "value": "private",
                    "label": "Always through VPC"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "id": "peering",
        "label": "Peering target",
        "description": "The deployer identity must have roles/dns.peer in the target project. Selecting the target VPC performs that permission pre-check before deployment.",
        "depends_on": {
          "field": "zone_type",
          "value": "peering"
        },
        "fields": [
          {
            "id": "peering_target_project",
            "label": "Target project ID",
            "type": "text",
            "required": true,
            "placeholder": "producer-project"
          },
          {
            "id": "peering_target_network",
            "label": "Target VPC network",
            "type": "select",
            "required": true,
            "data_source": {
              "resource": "dns.peeringNetworks",
              "params": {
                "project_id": {
                  "from_field": "peering_target_project"
                }
              },
              "display": {
                "value_key": "name",
                "label_key": "name",
                "description_key": "description"
              },
              "allow_custom": true,
              "cache_ttl": 300
            }
          }
        ]
      },
      {
        "id": "dnssec",
        "label": "DNSSEC",
        "description": "To change DNSSEC denial-of-existence or key specifications on an existing zone, first deploy with DNSSEC off, make the change, then deploy again with DNSSEC on. This workflow is enforced by the provider and GCP API at apply time.",
        "collapsed": true,
        "fields": [
          {
            "id": "dnssec_state",
            "label": "DNSSEC state",
            "type": "select",
            "default": "off",
            "options": [
              {
                "value": "off",
                "label": "Off"
              },
              {
                "value": "on",
                "label": "On"
              },
              {
                "value": "transfer",
                "label": "Transfer"
              }
            ]
          },
          {
            "id": "dnssec_non_existence",
            "label": "Denial-of-existence mechanism",
            "type": "select",
            "nullable": true,
            "options": [
              {
                "value": "nsec",
                "label": "NSEC"
              },
              {
                "value": "nsec3",
                "label": "NSEC3"
              }
            ]
          },
          {
            "id": "dnssec_default_key_specs",
            "label": "Default key specifications",
            "description": "When set, add exactly one KSK and one ZSK. Google generates the keys from these specifications.",
            "type": "repeatable",
            "fields": [
              {
                "id": "key_type",
                "label": "Key type",
                "type": "select",
                "required": true,
                "options": [
                  {
                    "value": "keySigning",
                    "label": "Key signing key (KSK)"
                  },
                  {
                    "value": "zoneSigning",
                    "label": "Zone signing key (ZSK)"
                  }
                ]
              },
              {
                "id": "algorithm",
                "label": "Algorithm",
                "type": "select",
                "required": true,
                "options": [
                  {
                    "value": "ecdsap256sha256",
                    "label": "ECDSA P-256 / SHA-256"
                  },
                  {
                    "value": "ecdsap384sha384",
                    "label": "ECDSA P-384 / SHA-384"
                  },
                  {
                    "value": "rsasha1",
                    "label": "RSA/SHA-1"
                  },
                  {
                    "value": "rsasha256",
                    "label": "RSA/SHA-256"
                  },
                  {
                    "value": "rsasha512",
                    "label": "RSA/SHA-512"
                  }
                ]
              },
              {
                "id": "key_length",
                "label": "Key length (bits)",
                "type": "number",
                "validation": {
                  "min": 1
                }
              }
            ]
          }
        ]
      },
      {
        "id": "advanced",
        "label": "Advanced",
        "collapsed": true,
        "fields": [
          {
            "id": "enable_logging",
            "label": "Enable DNS query logging",
            "description": "Writes DNS query logs to Cloud Logging and can increase log volume.",
            "type": "boolean",
            "default": false
          }
        ]
      }
    ]
  }
}
