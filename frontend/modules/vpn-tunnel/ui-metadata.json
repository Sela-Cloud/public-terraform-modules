{
  "$schema": "../../ui-metadata.schema.json",
  "module": "vpn-tunnel",
  "version": "1.0.0",
  "display": {
    "label": "Classic VPN Tunnel",
    "icon": "vpn",
    "description": "An IPsec tunnel attached to an existing vpn-gateway. A gateway can carry several tunnels to different peers.",
    "category": "regional"
  },
  "globals": [
    {
      "id": "project_id",
      "label": "Project ID",
      "type": "text",
      "required": true,
      "placeholder": "my-gcp-project"
    }
  ],
  "import": {
    "module": "vpn_tunnel",
    "target": "google_compute_vpn_tunnel.this",
    "id_template": "projects/{project_id}/regions/{region}/vpnTunnels/{name}",
    "identity_fields": ["project_id", "region", "name"],
    "requires_review": true
  },
  "satellites": [
    {
      "address": "google_compute_route.this",
      "driven_by": "destination_ranges",
      "note": "Routes for a ROUTE_BASED tunnel are not adopted on import; existing routes stay unmanaged."
    }
  ],
  "resource": {
    "variable": "vpn_tunnel",
    "key_field": "name",
    "key_label": "Tunnel name",
    "sections": [
      {
        "id": "tunnel",
        "label": "Gateway and tunnel",
        "fields": [
          {
            "id": "name",
            "label": "Tunnel name",
            "type": "text",
            "required": true,
            "validation": {
              "pattern": "^[a-z]([-a-z0-9]*[a-z0-9])?$",
              "pattern_error": "Use an RFC 1035 name."
            }
          },
          {
            "id": "region",
            "label": "Region",
            "description": "Must match the gateway's own region.",
            "type": "select",
            "required": true,
            "data_source": {
              "resource": "compute.regions",
              "params": { "project_id": { "from_field": "project_id" } },
              "display": { "value_key": "name", "label_key": "name" },
              "allow_custom": true,
              "cache_ttl": 300
            }
          },
          {
            "id": "gateway_name",
            "label": "VPN gateway",
            "description": "The vpn-gateway this tunnel attaches to. Pick from gateways that exist in this project, or type a name if the gateway is being created in the same change.",
            "type": "select",
            "required": true,
            "locked_after_create": true,
            "data_source": {
              "resource": "compute.targetVpnGateways",
              "params": {
                "project_id": { "from_field": "project_id" },
                "region": { "from_field": "region" }
              },
              "display": { "value_key": "name", "label_key": "name", "description_key": "description" },
              "allow_custom": true,
              "cache_ttl": 300
            }
          },
          {
            "id": "network",
            "label": "VPC network",
            "description": "Only used for ROUTE_BASED routing (to create routes into the tunnel). Must match the gateway's own network.",
            "type": "select",
            "required": true,
            "data_source": {
              "resource": "compute.networks",
              "params": { "project_id": { "from_field": "project_id" } },
              "display": { "value_key": "name", "label_key": "name" },
              "allow_custom": true,
              "cache_ttl": 300
            }
          },
          {
            "id": "peer_ip",
            "label": "Peer gateway public IP",
            "type": "text",
            "required": true,
            "placeholder": "34.120.10.5"
          },
          {
            "id": "shared_secret",
            "label": "Pre-shared secret",
            "description": "Stored in Terraform state; use a dedicated secret-management flow before production.",
            "type": "text",
            "required": true,
            "sensitive": true
          },
          {
            "id": "ike_version",
            "label": "IKE version",
            "type": "select",
            "default": "2",
            "options": [
              { "value": "1", "label": "IKEv1" },
              { "value": "2", "label": "IKEv2" }
            ]
          },
          {
            "id": "routing_mode",
            "label": "Routing",
            "description": "Route-based lets GCP routes direct traffic into the tunnel (0.0.0.0/0 selectors, managed automatically). Policy-based matches traffic against the selectors you specify below. Dynamic (BGP) routing isn't supported yet.",
            "type": "select",
            "required": true,
            "default": "ROUTE_BASED",
            "options": [
              { "value": "ROUTE_BASED", "label": "Route-based" },
              { "value": "POLICY_BASED", "label": "Policy-based" }
            ]
          },
          {
            "id": "destination_ranges",
            "label": "Destination IP ranges",
            "description": "Remote (on-premises) CIDR ranges to route into this tunnel.",
            "type": "list",
            "required": true,
            "depends_on": { "field": "routing_mode", "value": "ROUTE_BASED" }
          },
          {
            "id": "local_traffic_selector",
            "label": "Local traffic selectors",
            "type": "list",
            "required": true,
            "depends_on": { "field": "routing_mode", "value": "POLICY_BASED" }
          },
          {
            "id": "remote_traffic_selector",
            "label": "Remote traffic selectors",
            "type": "list",
            "required": true,
            "depends_on": { "field": "routing_mode", "value": "POLICY_BASED" }
          },
          {
            "id": "description",
            "label": "Description",
            "type": "text",
            "default": ""
          }
        ]
      }
    ]
  }
}
