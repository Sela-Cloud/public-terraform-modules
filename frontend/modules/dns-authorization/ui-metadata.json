{
  "$schema": "../../ui-metadata.schema.json",
  "module": "dns-authorization",
  "version": "1.0.0",
  "display": {
    "label": "DNS Authorization",
    "icon": "certificate-manager",
    "description": "Authorize a domain for a Google-managed certificate using DNS-01 validation.",
    "category": "global"
  },
  "globals": [
    {
      "id": "project_id",
      "label": "Project ID",
      "type": "text",
      "required": true,
      "placeholder": "my-gcp-project"
    }
  ],
  "provides": [
    {
      "data_source": "certificatemanager.dnsAuthorizations",
      "value_field": "name"
    }
  ],
  "import": {
    "module": "dns_authorization",
    "target": "google_certificate_manager_dns_authorization.this",
    "id_template": "projects/{project_id}/locations/global/dnsAuthorizations/{name}",
    "identity_fields": ["project_id", "name"],
    "requires_review": false
  },
  "resource": {
    "variable": "dns_authorization",
    "key_field": "name",
    "key_label": "Authorization name",
    "key_description": "Name of the DNS authorization resource.",
    "locked_after_create": true,
    "sections": [
      {
        "id": "basics",
        "label": "Configuration",
        "fields": [
          {
            "id": "name",
            "label": "Authorization name",
            "type": "text",
            "required": true,
            "placeholder": "example-com-auth",
            "validation": { "min": 1, "max": 64, "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$", "pattern_error": "Start with a letter; use letters, numbers, hyphens, or underscores after that." }
          },
          {
            "id": "domain",
            "label": "Domain",
            "description": "The domain to authorize. Also covers its wildcard, e.g. authorizing example.com also covers *.example.com.",
            "type": "text",
            "required": true,
            "placeholder": "example.com"
          },
          {
            "id": "description",
            "label": "Description",
            "type": "text"
          }
        ]
      }
    ]
  }
}
