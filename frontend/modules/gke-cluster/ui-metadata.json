{
  "$schema": "../../ui-metadata.schema.json",
  "module": "gke-cluster",
  "version": "1.0.0",
  "display": {
    "label": "GKE Cluster",
    "icon": "gke-cluster",
    "description": "Google Kubernetes Engine clusters in Autopilot or Standard mode",
    "category": "regional"
  },
  "resource": {
    "variable": "gke_cluster",
    "key_field": "name",
    "key_label": "Cluster name",
    "key_description": "RFC 1035 cluster name and Terraform map key.",
    "sections": [
      {
        "id": "basic",
        "label": "Cluster configuration",
        "description": "Choose the GKE operating mode and location.",
        "fields": [
          {
            "id": "project_id",
            "label": "Project ID",
            "type": "text",
            "required": true,
            "placeholder": "my-gcp-project"
          },
          {
            "id": "mode",
            "label": "Cluster mode",
            "description": "Autopilot manages node infrastructure. Standard exposes node-pool controls.",
            "type": "select",
            "required": true,
            "default": "autopilot",
            "options": [
              { "value": "autopilot", "label": "Autopilot" },
              { "value": "standard", "label": "Standard" }
            ]
          },
          {
            "id": "region",
            "label": "Region",
            "type": "select",
            "required": true,
            "data_source": {
              "resource": "compute.regions",
              "params": { "project_id": { "from_field": "project_id" } },
              "display": { "value_key": "name", "label_key": "name" },
              "cache_ttl": 300
            }
          },
          {
            "id": "location_type",
            "label": "Standard cluster location",
            "type": "select",
            "default": "regional",
            "depends_on": { "field": "mode", "value": "standard" },
            "options": [
              { "value": "regional", "label": "Regional" },
              { "value": "zonal", "label": "Zonal" }
            ]
          },
          {
            "id": "zone",
            "label": "Control-plane zone",
            "description": "Required only for a Standard zonal cluster.",
            "type": "select",
            "required": true,
            "depends_on": { "field": "location_type", "value": "zonal" },
            "data_source": {
              "resource": "compute.zones",
              "params": {
                "project_id": { "from_field": "project_id" },
                "region": { "from_field": "region" }
              },
              "display": { "value_key": "name", "label_key": "name" },
              "cache_ttl": 300
            }
          },
          {
            "id": "description",
            "label": "Description",
            "type": "text"
          },
          {
            "id": "node_locations",
            "label": "Additional node locations",
            "description": "Optional zones in the selected region for workloads.",
            "type": "list",
            "default": []
          },
          {
            "id": "labels",
            "label": "Cluster labels",
            "type": "map",
            "default": {}
          },
          {
            "id": "deletion_protection",
            "label": "Deletion protection",
            "description": "Prevent Terraform from deleting this cluster. Disable for temporary test clusters.",
            "type": "boolean",
            "default": false
          },
          {
            "id": "release_channel",
            "label": "Release channel",
            "description": "GKE control-plane and node upgrade channel.",
            "type": "select",
            "default": "REGULAR",
            "options": [
              { "value": "RAPID", "label": "Rapid" },
              { "value": "REGULAR", "label": "Regular" },
              { "value": "STABLE", "label": "Stable" }
            ]
          },
          {
            "id": "min_master_version",
            "label": "Minimum control-plane version",
            "description": "Leave blank to use the release channel default.",
            "type": "text"
          }
        ]
      },
      {
        "id": "networking",
        "label": "Networking and control plane",
        "fields": [
          {
            "id": "network",
            "label": "VPC network",
            "type": "select",
            "required": true,
            "data_source": {
              "resource": "compute.networks",
              "params": { "project_id": { "from_field": "project_id" } },
              "display": { "value_key": "name", "label_key": "name" },
              "cache_ttl": 300
            }
          },
          {
            "id": "subnetwork",
            "label": "Subnetwork",
            "type": "select",
            "required": true,
            "data_source": {
              "resource": "compute.subnetworks",
              "params": {
                "project_id": { "from_field": "project_id" },
                "region": { "from_field": "region" },
                "network": { "from_field": "network" }
              },
              "display": { "value_key": "name", "label_key": "name" },
              "cache_ttl": 300
            }
          },
          {
            "id": "cluster_secondary_range_name",
            "label": "Pod secondary IP range",
            "description": "Existing secondary IP range on the selected subnetwork.",
            "type": "text"
          },
          {
            "id": "services_secondary_range_name",
            "label": "Service secondary IP range",
            "description": "Existing secondary IP range on the selected subnetwork.",
            "type": "text"
          },
          {
            "id": "private_nodes",
            "label": "Private nodes",
            "type": "boolean",
            "default": true
          },
          {
            "id": "enable_private_endpoint",
            "label": "Private control-plane endpoint",
            "type": "boolean",
            "default": false,
            "depends_on": { "field": "private_nodes", "value": true }
          },
          {
            "id": "master_ipv4_cidr_block",
            "label": "Control-plane IPv4 CIDR block",
            "description": "Private control-plane /28 range.",
            "type": "text",
            "depends_on": { "field": "private_nodes", "value": true }
          },
          {
            "id": "master_global_access",
            "label": "Global private endpoint access",
            "type": "boolean",
            "default": false,
            "depends_on": { "field": "private_nodes", "value": true }
          },
          {
            "id": "master_authorized_networks",
            "label": "Control-plane authorized networks",
            "description": "Map of display name to CIDR range.",
            "type": "map",
            "default": {}
          },
          {
            "id": "enable_dataplane_v2",
            "label": "Enable Dataplane V2",
            "description": "Uses GKE advanced datapath. When enabled, legacy Kubernetes NetworkPolicy is not configured separately.",
            "type": "boolean",
            "default": true
          },
          {
            "id": "enable_network_policy",
            "label": "Enable Kubernetes NetworkPolicy",
            "description": "Only configurable when Dataplane V2 is disabled.",
            "type": "boolean",
            "default": true,
            "depends_on": { "field": "enable_dataplane_v2", "value": false }
          },
          {
            "id": "enable_http_load_balancing",
            "label": "Enable HTTP(S) Load Balancing",
            "type": "boolean",
            "default": true,
            "depends_on": { "field": "mode", "value": "standard" }
          }
        ]
      },
      {
        "id": "security",
        "label": "Security and identity",
        "collapsed": true,
        "fields": [
          {
            "id": "enable_workload_identity",
            "label": "Enable Workload Identity",
            "type": "boolean",
            "default": true
          },
          {
            "id": "enable_binary_authorization",
            "label": "Enforce Binary Authorization",
            "type": "boolean",
            "default": false
          },
          {
            "id": "database_encryption_key_name",
            "label": "KMS key for Kubernetes Secrets",
            "description": "Cloud KMS key resource name used for application-layer secret encryption.",
            "type": "text"
          },
          {
            "id": "groups_for_rbac",
            "label": "Google Group for RBAC",
            "description": "Security group email used with GKE Google Groups for RBAC.",
            "type": "text"
          }
        ]
      },
      {
        "id": "operations",
        "label": "Operations and add-ons",
        "collapsed": true,
        "fields": [
          {
            "id": "logging_components",
            "label": "Cloud Logging components",
            "type": "list",
            "default": ["SYSTEM_COMPONENTS", "WORKLOADS"]
          },
          {
            "id": "monitoring_components",
            "label": "Cloud Monitoring components",
            "type": "list",
            "default": ["SYSTEM_COMPONENTS"]
          },
          {
            "id": "enable_managed_prometheus",
            "label": "Enable Managed Service for Prometheus",
            "type": "boolean",
            "default": true
          },
          {
            "id": "fleet_project",
            "label": "Fleet host project",
            "description": "Set to register the cluster with a Fleet.",
            "type": "text"
          },
          {
            "id": "enable_backup_agent",
            "label": "Enable Backup for GKE agent",
            "type": "boolean",
            "default": false
          },
          {
            "id": "maintenance_daily_window_start_time",
            "label": "Daily maintenance start time",
            "description": "UTC time in HH:MM format.",
            "type": "text",
            "validation": {
              "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
              "pattern_error": "Use a UTC time in HH:MM format."
            }
          },
          {
            "id": "maintenance_exclusions",
            "label": "Maintenance exclusions",
            "description": "Periods during which GKE must not perform maintenance.",
            "type": "repeatable",
            "default": [],
            "fields": [
              { "id": "name", "label": "Exclusion name", "type": "text", "required": true },
              { "id": "start_time", "label": "Start time", "description": "RFC3339 UTC timestamp.", "type": "text", "required": true },
              { "id": "end_time", "label": "End time", "description": "RFC3339 UTC timestamp.", "type": "text", "required": true },
              {
                "id": "scope",
                "label": "Exclusion scope",
                "type": "select",
                "options": [
                  { "value": "NO_UPGRADES", "label": "No upgrades" },
                  { "value": "NO_MINOR_UPGRADES", "label": "No minor upgrades" },
                  { "value": "NO_MINOR_OR_NODE_UPGRADES", "label": "No minor or node upgrades" }
                ]
              }
            ]
          }
        ]
      },
      {
        "id": "standard-scaling",
        "label": "Standard cluster autoscaling",
        "description": "Cluster-level node auto-provisioning settings.",
        "collapsed": true,
        "depends_on": { "field": "mode", "value": "standard" },
        "fields": [
          {
            "id": "enable_node_auto_provisioning",
            "label": "Enable node auto-provisioning",
            "type": "boolean",
            "default": false
          },
          {
            "id": "autoscaling_profile",
            "label": "Autoscaling profile",
            "type": "select",
            "default": "BALANCED",
            "depends_on": { "field": "enable_node_auto_provisioning", "value": true },
            "options": [
              { "value": "BALANCED", "label": "Balanced" },
              { "value": "OPTIMIZE_UTILIZATION", "label": "Optimize utilization" }
            ]
          }
        ]
      },
      {
        "id": "standard-node-pools",
        "label": "Standard node pools",
        "description": "Each node pool is managed independently from the cluster.",
        "collapsed": true,
        "depends_on": { "field": "mode", "value": "standard" },
        "fields": [
          {
            "id": "node_pools",
            "label": "Node pools",
            "type": "repeatable",
            "required": true,
            "fields": [
              { "id": "name", "label": "Node pool name", "type": "text", "required": true },
              {
                "id": "node_locations",
                "label": "Node locations",
                "type": "list",
                "default": [],
                "data_source": {
                  "resource": "compute.zones",
                  "params": {
                    "project_id": { "from_field": "project_id" },
                    "region": { "from_field": "region" }
                  },
                  "display": { "value_key": "name", "label_key": "name" },
                  "cache_ttl": 300
                }
              },
              {
                "id": "machine_type",
                "label": "Machine type",
                "type": "select",
                "default": "e2-medium",
                "data_source": {
                  "resource": "compute.machineTypes",
                  "params": {
                    "project_id": { "from_field": "project_id" },
                    "zone": { "from_field": "node_locations" }
                  },
                  "display": { "value_key": "name", "label_key": "name" },
                  "allow_custom": true,
                  "cache_ttl": 300
                }
              },
              { "id": "disk_size_gb", "label": "Disk size (GB)", "type": "number", "default": 100, "validation": { "min": 10 } },
              {
                "id": "disk_type",
                "label": "Disk type",
                "type": "select",
                "default": "pd-balanced",
                "options": [
                  { "value": "pd-standard", "label": "Standard persistent disk" },
                  { "value": "pd-balanced", "label": "Balanced persistent disk" },
                  { "value": "pd-ssd", "label": "SSD persistent disk" }
                ]
              },
              {
                "id": "image_type",
                "label": "Node image type",
                "type": "select",
                "default": "COS_CONTAINERD",
                "options": [
                  { "value": "COS_CONTAINERD", "label": "Container-Optimized OS with containerd" },
                  { "value": "UBUNTU_CONTAINERD", "label": "Ubuntu with containerd" }
                ]
              },
              { "id": "spot", "label": "Use Spot VMs", "type": "boolean", "default": false },
              { "id": "initial_node_count", "label": "Initial node count", "type": "number", "default": 1, "validation": { "min": 1 } },
              { "id": "autoscaling_enabled", "label": "Enable autoscaling", "type": "boolean", "default": true },
              { "id": "min_node_count", "label": "Minimum nodes", "type": "number", "default": 1, "depends_on": { "field": "autoscaling_enabled", "value": true }, "validation": { "min": 0 } },
              { "id": "max_node_count", "label": "Maximum nodes", "type": "number", "default": 3, "depends_on": { "field": "autoscaling_enabled", "value": true }, "validation": { "min": 1 } },
              { "id": "auto_repair", "label": "Enable automatic repair", "type": "boolean", "default": true },
              { "id": "auto_upgrade", "label": "Enable automatic upgrade", "type": "boolean", "default": true },
              { "id": "max_surge", "label": "Maximum surge nodes", "type": "number", "default": 1, "validation": { "min": 0 } },
              { "id": "max_unavailable", "label": "Maximum unavailable nodes", "type": "number", "default": 0, "validation": { "min": 0 } },
              { "id": "service_account", "label": "Node service account", "type": "text" },
              { "id": "labels", "label": "Node labels", "type": "map", "default": {} },
              { "id": "tags", "label": "Network tags", "type": "list", "default": [] },
              { "id": "metadata", "label": "Instance metadata", "type": "map", "default": { "disable-legacy-endpoints": "true" } },
              { "id": "enable_secure_boot", "label": "Enable Secure Boot", "type": "boolean", "default": true },
              { "id": "enable_integrity_monitoring", "label": "Enable integrity monitoring", "type": "boolean", "default": true },
              { "id": "max_pods_per_node", "label": "Maximum pods per node", "type": "number" }
            ]
          }
        ]
      }
    ]
  }
}
