{
  "$schema": "../ui-metadata.schema.json",
  "module": "cloud-dns-record",
  "version": "1.0.0",
  "display": {
    "label": "Cloud DNS Record",
    "icon": "network",
    "description": "Standard Cloud DNS record sets. Deploy the managed zone first.",
    "category": "global"
  },
  "globals": [
    {
      "id": "project_id",
      "label": "Project ID",
      "type": "text",
      "required": true,
      "placeholder": "my-gcp-project"
    }
  ],
  "import": {
    "module": "cloud_dns_record",
    "target": "google_dns_record_set.this",
    "id_template": "projects/{project_id}/managedZones/{managed_zone}/rrsets/{name}/{type}",
    "identity_fields": [
      "project_id",
      "managed_zone",
      "name",
      "type",
      "record_key"
    ],
    "requires_review": false
  },
  "resource": {
    "variable": "cloud_dns_record",
    "key_field": "record_key",
    "key_label": "Record identifier",
    "key_description": "A stable identifier for this record, used as the Terraform key. Pick something descriptive such as www-a or api-cname. Each entry must be a distinct DNS name + record type; two entries sharing both are rejected.",
    "locked_after_create": true,
    "sections": [
      {
        "id": "record",
        "label": "Record configuration",
        "fields": [
          {
            "id": "record_key",
            "label": "Record identifier",
            "locked_after_create": true,
            "type": "text",
            "required": true,
            "placeholder": "www-a",
            "validation": {
              "pattern": "^[a-zA-Z0-9-]{1,63}$",
              "pattern_error": "Use letters, numbers, and hyphens."
            }
          },
          {
            "id": "managed_zone",
            "label": "Managed zone",
            "description": "Only zones that already exist in Cloud DNS can be selected. Deploy a new zone before its records.",
            "type": "select",
            "required": true,
            "data_source": {
              "resource": "dns.managedZones",
              "params": {
                "project_id": {
                  "from_field": "project_id"
                }
              },
              "display": {
                "value_key": "name",
                "label_key": "name",
                "description_key": "description"
              },
              "cache_ttl": 120
            }
          },
          {
            "id": "name",
            "label": "Record name",
            "locked_after_create": true,
            "description": "Fully qualified record name ending with a dot. It must be inside the selected zone.",
            "type": "text",
            "required": true,
            "placeholder": "www.example.com.",
            "validation": {
              "pattern": "^.+\\.$",
              "pattern_error": "Record names must end with a trailing dot."
            }
          },
          {
            "id": "type",
            "label": "Record type",
            "locked_after_create": true,
            "type": "select",
            "required": true,
            "default": "A",
            "options": [
              {
                "value": "A",
                "label": "A"
              },
              {
                "value": "AAAA",
                "label": "AAAA"
              },
              {
                "value": "CAA",
                "label": "CAA"
              },
              {
                "value": "CNAME",
                "label": "CNAME"
              },
              {
                "value": "MX",
                "label": "MX"
              },
              {
                "value": "NS",
                "label": "NS"
              },
              {
                "value": "PTR",
                "label": "PTR"
              },
              {
                "value": "SRV",
                "label": "SRV"
              },
              {
                "value": "TXT",
                "label": "TXT"
              }
            ]
          },
          {
            "id": "ttl",
            "label": "TTL (seconds)",
            "type": "number",
            "default": 300,
            "validation": {
              "min": 1
            }
          },
          {
            "id": "rrdatas",
            "label": "Record data",
            "description": "Add one value per record. SRV: priority weight port target.; TXT values containing spaces must be quoted; CAA: 0 issue \"ca.example\".",
            "type": "list",
            "required": true,
            "depends_on": {
              "field": "routing_policy_type",
              "value": "none"
            },
            "validation": {
              "min": 1
            }
          },
          {
            "id": "routing_policy_type",
            "label": "Traffic routing policy",
            "description": "Choose None for ordinary records. Routing policies replace top-level record data.",
            "type": "select",
            "default": "none",
            "options": [
              {
                "value": "none",
                "label": "None"
              },
              {
                "value": "wrr",
                "label": "Weighted round robin"
              },
              {
                "value": "geo",
                "label": "Geolocation"
              }
            ]
          },
          {
            "id": "dnssec_enabled",
            "label": "Selected zone has DNSSEC enabled",
            "description": "When enabled, each routing target must use either record data or health-checked endpoints, not both.",
            "type": "boolean",
            "default": false,
            "depends_on": {
              "field": "routing_policy_type",
              "value": "none",
              "operator": "neq"
            }
          }
        ]
      },
      {
        "id": "routing-health",
        "label": "Routing health check",
        "description": "Optional for ordinary data targets. Required when any target uses health-checked external endpoints; this references an existing Compute health check and does not create one.",
        "collapsed": true,
        "depends_on": {
          "field": "routing_policy_type",
          "value": "none",
          "operator": "neq"
        },
        "fields": [
          {
            "id": "routing_health_check",
            "label": "Existing Compute health check",
            "type": "select",
            "nullable": true,
            "data_source": {
              "resource": "compute.healthChecks",
              "params": {
                "project_id": {
                  "from_field": "project_id"
                }
              },
              "display": {
                "value_key": "selfLink",
                "label_key": "name",
                "description_key": "description"
              },
              "allow_custom": true,
              "cache_ttl": 300
            }
          }
        ]
      },
      {
        "id": "wrr",
        "label": "Weighted targets",
        "depends_on": {
          "field": "routing_policy_type",
          "value": "wrr"
        },
        "fields": [
          {
            "id": "wrr_targets",
            "label": "Weighted targets",
            "type": "repeatable",
            "required": true,
            "fields": [
              {
                "id": "weight",
                "label": "Weight",
                "type": "number",
                "required": true,
                "default": 1,
                "validation": {
                  "min": 0
                }
              },
              {
                "id": "rrdatas",
                "label": "Record data",
                "description": "Use record data or health-checked external endpoints. With DNSSEC, do not use both.",
                "type": "list"
              },
              {
                "id": "health_checked_external_endpoints",
                "label": "Health-checked external endpoints",
                "type": "list"
              }
            ]
          }
        ]
      },
      {
        "id": "geo",
        "label": "Geolocation targets",
        "depends_on": {
          "field": "routing_policy_type",
          "value": "geo"
        },
        "fields": [
          {
            "id": "geo_targets",
            "label": "Geolocation targets",
            "type": "repeatable",
            "required": true,
            "fields": [
              {
                "id": "location",
                "label": "GCP location",
                "type": "text",
                "required": true,
                "placeholder": "us-central1"
              },
              {
                "id": "rrdatas",
                "label": "Record data",
                "type": "list"
              },
              {
                "id": "health_checked_external_endpoints",
                "label": "Health-checked external endpoints",
                "type": "list"
              }
            ]
          }
        ]
      }
    ]
  }
}
