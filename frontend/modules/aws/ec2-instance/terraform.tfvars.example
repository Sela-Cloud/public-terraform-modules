region = "us-east-1"

ec2_instance = {
  "web-server-01" = {
    name                        = "web-server-01"
    ami                         = null # Automatically resolves to latest Amazon Linux 2023
    instance_type               = "t3.micro"
    key_name                    = "my-ssh-key"
    subnet_id                   = "subnet-0123456789abcdef0"
    vpc_security_group_ids      = ["sg-0123456789abcdef0"]
    associate_public_ip_address = true
    enable_eip                  = false
    monitoring                  = true
    disable_api_termination     = true

    root_block_device = {
      volume_type           = "gp3"
      volume_size           = 30
      encrypted             = true
      delete_on_termination = true
    }

    ebs_block_device = [
      {
        device_name           = "/dev/sdf"
        volume_type           = "gp3"
        volume_size           = 50
        encrypted             = true
        delete_on_termination = true
      }
    ]

    user_data = <<-EOF
      #!/bin/bash
      yum update -y
      yum install -y httpd
      systemctl start httpd
      systemctl enable httpd
      echo "<h1>Hello from AWS EC2 via Sela Craft!</h1>" > /var/www/html/index.html
    EOF

    tags = {
      Environment = "production"
      Role        = "web-frontend"
      Owner       = "devops-team"
    }

    volume_tags = {
      Environment = "production"
    }
  },

  "api-server-01" = {
    name                        = "api-server-01"
    ami                         = null
    instance_type               = "t3.small"
    key_name                    = "my-ssh-key"
    subnet_id                   = "subnet-0123456789abcdef1"
    vpc_security_group_ids      = ["sg-0123456789abcdef0"]
    associate_public_ip_address = false
    enable_eip                  = true # Allocate and associate an Elastic IP

    root_block_device = {
      volume_type           = "gp3"
      volume_size           = 40
      encrypted             = true
      delete_on_termination = true
    }

    ebs_block_device = []

    tags = {
      Environment = "production"
      Role        = "api-backend"
      Owner       = "devops-team"
    }

    volume_tags = {
      Environment = "production"
    }
  }
}
