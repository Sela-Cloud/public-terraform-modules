{
  "$schema": "../../../ui-metadata.schema.json",
  "module": "ec2-instance",
  "version": "1.0.0",
  "display": {
    "label": "AWS EC2 Instance",
    "icon": "ec2",
    "description": "Provision scalable Amazon EC2 virtual machines with storage, networking, and security configurations",
    "category": "regional"
  },
  "globals": [
    {
      "id": "region",
      "label": "AWS Region",
      "description": "The AWS region where resources will be provisioned.",
      "type": "select",
      "required": true,
      "default": "us-east-1",
      "data_source": {
        "resource": "ec2.regions",
        "params": {},
        "display": {
          "value_key": "name",
          "label_key": "description",
          "description_key": "name"
        }
      }
    }
  ],
  "resource": {
    "variable": "ec2_instance",
    "key_field": "name",
    "key_label": "Instance Name",
    "key_description": "Unique name and identifier for the EC2 instance, applied as the 'Name' tag.",
    "sections": [
      {
        "id": "basic",
        "label": "Basic Configuration",
        "description": "Core instance settings including compute size, AMI, and placement.",
        "fields": [
          {
            "id": "name",
            "label": "Instance Name",
            "description": "Name applied to the instance as a tag and identifier.",
            "type": "text",
            "required": true,
            "placeholder": "my-web-server"
          },
          {
            "id": "instance_type",
            "label": "Instance Type",
            "description": "EC2 instance size and family (e.g. t3.micro, m5.large, c6i.xlarge).",
            "type": "text",
            "required": true,
            "default": "t3.micro",
            "placeholder": "t3.micro"
          },
          {
            "id": "ami",
            "label": "AMI ID",
            "description": "Amazon Machine Image ID. Leave empty to automatically use latest Amazon Linux 2023.",
            "type": "select",
            "required": false,
            "nullable": true,
            "placeholder": "ami-0c55b159cbfafe1f0",
            "data_source": {
              "resource": "ec2.images",
              "params": { "region": { "from_field": "region" } },
              "display": { "value_key": "id", "label_key": "name", "description_key": "description" },
              "allow_custom": true,
              "cache_ttl": 300
            }
          },
          {
            "id": "key_name",
            "label": "Key Pair Name",
            "description": "Name of an existing EC2 Key Pair for SSH/RDP access. Ignored when Create Key Pair is enabled below.",
            "type": "select",
            "required": false,
            "nullable": true,
            "placeholder": "my-keypair",
            "depends_on": { "field": "create_key_pair", "value": false },
            "data_source": {
              "resource": "ec2.key_pairs",
              "params": { "region": { "from_field": "region" } },
              "display": { "value_key": "id", "label_key": "name" },
              "allow_custom": true,
              "cache_ttl": 300
            }
          },
          {
            "id": "availability_zone",
            "label": "Availability Zone",
            "description": "Specific AZ to launch the instance into. Optional.",
            "type": "select",
            "required": false,
            "nullable": true,
            "placeholder": "us-east-1a",
            "data_source": {
              "resource": "ec2.availability_zones",
              "params": { "region": { "from_field": "region" } },
              "display": { "value_key": "name", "label_key": "name" },
              "allow_custom": true,
              "cache_ttl": 300
            }
          },
          {
            "id": "placement_group",
            "label": "Placement Group",
            "description": "Name of the placement group to start the instance in.",
            "type": "text",
            "required": false,
            "nullable": true
          },
          {
            "id": "tenancy",
            "label": "Tenancy",
            "description": "Hardware tenancy of the instance.",
            "type": "select",
            "required": false,
            "default": "default",
            "options": [
              { "value": "default", "label": "Shared (Default)" },
              { "value": "dedicated", "label": "Dedicated Instance" },
              { "value": "host", "label": "Dedicated Host" }
            ]
          },
          {
            "id": "host_id",
            "label": "Dedicated Host ID",
            "description": "ID of a dedicated host the instance will be assigned to. Only applies when Tenancy is Dedicated Host.",
            "type": "text",
            "required": false,
            "nullable": true,
            "depends_on": { "field": "tenancy", "value": "host" }
          },
          {
            "id": "cpu_core_count",
            "label": "CPU Core Count",
            "description": "Sets the number of CPU cores for the instance. Leave empty for the instance type's default.",
            "type": "number",
            "required": false,
            "nullable": true
          },
          {
            "id": "threads_per_core",
            "label": "Threads per Core",
            "description": "Sets the number of threads per CPU core (e.g. 1 to disable Hyper-Threading).",
            "type": "number",
            "required": false,
            "nullable": true
          }
        ]
      },
      {
        "id": "network",
        "label": "Network & Interfaces",
        "description": "VPC subnet, security groups, and IP address allocation.",
        "fields": [
          {
            "id": "vpc_id",
            "label": "VPC",
            "description": "VPC the instance's subnet belongs to. Narrows the Subnet list below to this VPC.",
            "type": "select",
            "required": false,
            "placeholder": "vpc-0123456789abcdef0",
            "data_source": {
              "resource": "ec2.vpcs",
              "params": {
                "region": { "from_field": "region" }
              },
              "display": {
                "value_key": "id",
                "label_key": "name",
                "description_key": "cidr"
              },
              "allow_custom": true,
              "cache_ttl": 300
            }
          },
          {
            "id": "subnet_id",
            "label": "Subnet",
            "description": "VPC Subnet where the instance primary interface will reside.",
            "type": "select",
            "required": false,
            "data_source": {
              "resource": "ec2.subnets",
              "params": {
                "region": { "from_field": "region" },
                "vpc_id": { "from_field": "vpc_id" }
              },
              "display": {
                "value_key": "id",
                "label_key": "name",
                "description_key": "cidr"
              },
              "allow_custom": true,
              "cache_ttl": 300
            }
          },
          {
            "id": "vpc_security_group_ids",
            "label": "Security Group IDs",
            "description": "List of VPC Security Group IDs to associate with the instance.",
            "type": "list",
            "required": false,
            "default": [],
            "data_source": {
              "resource": "ec2.security_groups",
              "params": {
                "region": { "from_field": "region" },
                "vpc_id": { "from_field": "vpc_id" }
              },
              "display": { "value_key": "id", "label_key": "name", "description_key": "description" },
              "allow_custom": true,
              "cache_ttl": 300
            }
          },
          {
            "id": "associate_public_ip_address",
            "label": "Auto-assign Public IP",
            "description": "Whether to request a public IPv4 address from the subnet pool.",
            "type": "boolean",
            "required": false,
            "default": false
          },
          {
            "id": "private_ip",
            "label": "Static Private IP",
            "description": "Specific private IPv4 address to assign within the subnet.",
            "type": "text",
            "required": false,
            "placeholder": "10.0.1.50"
          },
          {
            "id": "secondary_private_ips",
            "label": "Secondary Private IPs",
            "description": "Additional private IPv4 addresses to associate with the primary interface.",
            "type": "list",
            "required": false,
            "default": []
          },
          {
            "id": "enable_eip",
            "label": "Allocate Elastic IP (EIP)",
            "description": "Allocate and associate a dedicated static Elastic IP to this instance.",
            "type": "boolean",
            "required": false,
            "default": false
          },
          {
            "id": "source_dest_check",
            "label": "Source / Destination Check",
            "description": "Enable source/destination IP checking. Disable for NAT gateways or firewall appliances.",
            "type": "boolean",
            "required": false,
            "default": true
          }
        ]
      },
      {
        "id": "storage",
        "label": "Storage Configuration",
        "description": "Root volume parameters and additional EBS volume attachments.",
        "fields": [
          {
            "id": "root_block_device",
            "label": "Root Block Device",
            "description": "Parameters for the primary root EBS volume.",
            "type": "object",
            "required": false,
            "fields": [
              {
                "id": "volume_type",
                "description": "EBS volume type for the root disk. gp3 is the current general-purpose default.",
                "label": "Volume Type",
                "type": "select",
                "default": "gp3",
                "options": [
                  { "value": "gp3", "label": "General Purpose SSD (gp3)" },
                  { "value": "gp2", "label": "General Purpose SSD (gp2)" },
                  { "value": "io1", "label": "Provisioned IOPS SSD (io1)" },
                  { "value": "io2", "label": "Provisioned IOPS SSD (io2)" },
                  { "value": "standard", "label": "Magnetic (standard)" }
                ]
              },
              {
                "id": "volume_size",
                "description": "Root disk size in GiB. It must be at least as large as the AMI's snapshot.",
                "label": "Volume Size (GB)",
                "type": "number",
                "default": 30
              },
              {
                "id": "delete_on_termination",
                "description": "Delete the root volume when the instance is terminated. Turning this off leaves the volume, and its cost, behind.",
                "label": "Delete on Termination",
                "type": "boolean",
                "default": true
              },
              {
                "id": "encrypted",
                "description": "Encrypt the root volume at rest.",
                "label": "Encrypted",
                "type": "boolean",
                "default": true
              },
              {
                "id": "kms_key_id",
                "label": "KMS Key ID / ARN",
                "description": "Custom KMS key for encryption. Leave blank for default AWS managed key.",
                "type": "select",
                "required": false,
                "nullable": true,
                "data_source": {
                  "resource": "kms.keys",
                  "params": { "region": { "from_field": "region" } },
                  "display": { "value_key": "id", "label_key": "name" },
                  "allow_custom": true,
                  "cache_ttl": 300
                }
              }
            ]
          },
          {
            "id": "ebs_block_device",
            "label": "Additional EBS Volumes",
            "description": "List of secondary EBS disks to attach to the instance.",
            "type": "repeatable",
            "required": false,
            "fields": [
              {
                "id": "device_name",
                "label": "Device Name",
                "description": "Block device name (e.g. /dev/sdf, /dev/xvdf).",
                "type": "text",
                "required": true,
                "placeholder": "/dev/sdf"
              },
              {
                "id": "volume_type",
                "description": "EBS volume type for this data disk.",
                "label": "Volume Type",
                "type": "select",
                "default": "gp3",
                "options": [
                  { "value": "gp3", "label": "gp3" },
                  { "value": "gp2", "label": "gp2" },
                  { "value": "io1", "label": "io1" },
                  { "value": "io2", "label": "io2" }
                ]
              },
              {
                "id": "volume_size",
                "description": "Size of this data disk in GiB.",
                "label": "Volume Size (GB)",
                "type": "number",
                "default": 20
              },
              {
                "id": "encrypted",
                "description": "Encrypt this data volume at rest.",
                "label": "Encrypted",
                "type": "boolean",
                "default": true
              },
              {
                "id": "kms_key_id",
                "label": "KMS Key ID / ARN",
                "description": "Custom KMS key for encryption. Leave blank for default AWS managed key.",
                "type": "select",
                "required": false,
                "nullable": true,
                "data_source": {
                  "resource": "kms.keys",
                  "params": { "region": { "from_field": "region" } },
                  "display": { "value_key": "id", "label_key": "name" },
                  "allow_custom": true,
                  "cache_ttl": 300
                }
              },
              {
                "id": "iops",
                "label": "IOPS",
                "description": "Provisioned IOPS. Only applies to io1, io2, and gp3 volumes.",
                "type": "number",
                "required": false,
                "nullable": true
              },
              {
                "id": "throughput",
                "label": "Throughput (MB/s)",
                "description": "Throughput for gp3 volumes.",
                "type": "number",
                "required": false,
                "nullable": true
              },
              {
                "id": "snapshot_id",
                "label": "Source Snapshot ID",
                "description": "Create this volume from an existing EBS snapshot.",
                "type": "text",
                "required": false,
                "nullable": true
              },
              {
                "id": "delete_on_termination",
                "description": "Delete this volume when the instance is terminated.",
                "label": "Delete on Termination",
                "type": "boolean",
                "default": true
              }
            ]
          }
        ]
      },
      {
        "id": "security",
        "label": "Security & IAM",
        "description": "IAM instance role and Instance Metadata Service (IMDSv2) hardening.",
        "fields": [
          {
            "id": "iam_instance_profile",
            "label": "IAM Instance Profile",
            "description": "IAM Instance Profile name or ARN to grant AWS API permissions to the VM.",
            "type": "select",
            "required": false,
            "nullable": true,
            "placeholder": "EC2SSMInstanceProfile",
            "data_source": {
              "resource": "iam.instance_profiles",
              "params": {},
              "display": { "value_key": "id", "label_key": "name" },
              "allow_custom": true,
              "cache_ttl": 300
            }
          },
          {
            "id": "metadata_options",
            "label": "Metadata Options (IMDSv2)",
            "description": "Configure IMDSv2 tokens and security hop limit.",
            "type": "object",
            "required": false,
            "fields": [
              {
                "id": "http_endpoint",
                "description": "Whether the instance metadata service is reachable at all.",
                "label": "HTTP Endpoint",
                "type": "select",
                "default": "enabled",
                "options": [
                  { "value": "enabled", "label": "Enabled" },
                  { "value": "disabled", "label": "Disabled" }
                ]
              },
              {
                "id": "http_tokens",
                "label": "IMDSv2 Tokens",
                "description": "Required enforces IMDSv2 token usage for enhanced security.",
                "type": "select",
                "default": "required",
                "options": [
                  { "value": "required", "label": "Required (IMDSv2 Enforced)" },
                  { "value": "optional", "label": "Optional (IMDSv1 Allowed)" }
                ]
              },
              {
                "id": "http_put_response_hop_limit",
                "description": "How many network hops a metadata response may travel. Keep it at 1 unless containers on the host need metadata, which needs 2.",
                "label": "Hop Limit",
                "type": "number",
                "default": 2
              }
            ]
          }
        ]
      },
      {
        "id": "management",
        "label": "Protection & Management",
        "description": "Lifecycle protection, monitoring, CPU credits, and bootstrap scripts.",
        "fields": [
          {
            "id": "disable_api_termination",
            "label": "Termination Protection",
            "description": "Protect the instance from accidental termination.",
            "type": "boolean",
            "required": false,
            "default": false
          },
          {
            "id": "disable_api_stop",
            "label": "Stop Protection",
            "description": "Protect the instance from accidental stop requests.",
            "type": "boolean",
            "required": false,
            "default": false
          },
          {
            "id": "monitoring",
            "label": "Detailed Monitoring",
            "description": "Enable detailed 1-minute CloudWatch metric collection (extra AWS charges apply).",
            "type": "boolean",
            "required": false,
            "default": false
          },
          {
            "id": "ebs_optimized",
            "label": "EBS Optimized",
            "description": "Dedicated throughput between Amazon EC2 and Amazon EBS.",
            "type": "boolean",
            "required": false,
            "default": true
          },
          {
            "id": "cpu_credits",
            "label": "T-series CPU Credits",
            "description": "Credit option for burstable instance families.",
            "type": "select",
            "required": false,
            "default": "standard",
            "options": [
              { "value": "standard", "label": "Standard" },
              { "value": "unlimited", "label": "Unlimited" }
            ]
          },
          {
            "id": "user_data",
            "label": "User Data Script",
            "description": "Shell script or cloud-init directives executed at first boot.",
            "type": "text",
            "multiline": true,
            "required": false,
            "placeholder": "#!/bin/bash\nyum update -y"
          },
          {
            "id": "user_data_replace_on_change",
            "label": "Recreate on User Data Change",
            "description": "Force instance destroy and recreate if user data changes.",
            "type": "boolean",
            "required": false,
            "default": false
          }
        ]
      },
      {
        "id": "ssh_key_management",
        "label": "SSH Key Pair",
        "description": "Optionally create a dedicated Key Pair instead of referencing an existing one.",
        "collapsed": true,
        "fields": [
          {
            "id": "create_key_pair",
            "label": "Create Key Pair",
            "description": "Create a new AWS Key Pair for SSH access instead of using Key Pair Name above.",
            "type": "boolean",
            "required": false,
            "default": false
          },
          {
            "id": "key_pair_name",
            "label": "New Key Pair Name",
            "description": "Name for the created Key Pair. Defaults to '<instance name>-key' if left empty.",
            "type": "text",
            "required": false,
            "nullable": true,
            "depends_on": { "field": "create_key_pair", "value": true }
          },
          {
            "id": "public_key",
            "label": "Public Key Material",
            "description": "Public key to import into the created key pair. Leave empty with Auto-Generate Key below to have one generated automatically.",
            "type": "text",
            "multiline": true,
            "required": false,
            "nullable": true,
            "depends_on": { "field": "create_key_pair", "value": true }
          },
          {
            "id": "generate_ssh_key",
            "label": "Auto-Generate Key",
            "description": "Automatically generate a private key when no Public Key Material is provided.",
            "type": "boolean",
            "required": false,
            "default": false,
            "depends_on": { "field": "create_key_pair", "value": true }
          },
          {
            "id": "ssh_user",
            "label": "SSH User",
            "description": "Default SSH user for the instance (e.g. 'ec2-user' for Amazon Linux, 'ubuntu' for Ubuntu).",
            "type": "text",
            "required": false,
            "default": "ec2-user",
            "depends_on": { "field": "create_key_pair", "value": true }
          }
        ]
      },
      {
        "id": "dedicated_security_group",
        "label": "Dedicated Security Group",
        "description": "Optionally create a security group with inbound SSH allowed, in addition to any Security Group IDs above.",
        "collapsed": true,
        "fields": [
          {
            "id": "create_security_group",
            "label": "Create Security Group",
            "description": "Create a dedicated security group with inbound SSH (port 22) and outbound access allowed.",
            "type": "boolean",
            "required": false,
            "default": false
          },
          {
            "id": "security_group_name",
            "label": "Security Group Name",
            "description": "Name of the dedicated security group. Defaults to '<instance name>-sg' if left empty.",
            "type": "text",
            "required": false,
            "nullable": true,
            "depends_on": { "field": "create_security_group", "value": true }
          },
          {
            "id": "security_group_description",
            "label": "Security Group Description",
            "type": "text",
            "required": false,
            "default": "Security group for EC2 instance with SSH access",
            "depends_on": { "field": "create_security_group", "value": true }
          },
          {
            "id": "ssh_cidr_blocks",
            "label": "SSH-Allowed CIDR Blocks",
            "description": "IPv4 CIDR blocks permitted to connect via SSH on port 22.",
            "type": "list",
            "required": false,
            "default": ["0.0.0.0/0"],
            "depends_on": { "field": "create_security_group", "value": true }
          },
          {
            "id": "security_group_tags",
            "label": "Security Group Tags",
            "type": "map",
            "required": false,
            "default": {},
            "depends_on": { "field": "create_security_group", "value": true }
          }
        ]
      },
      {
        "id": "advanced",
        "label": "Advanced",
        "description": "Spot market options, Nitro Enclave, private DNS, capacity reservations, and instance store volumes.",
        "collapsed": true,
        "fields": [
          {
            "id": "instance_market_options",
            "label": "Market Options",
            "type": "object",
            "required": false,
            "nullable": true,
            "fields": [
              {
                "id": "market_type",
                "label": "Market Type",
                "type": "select",
                "default": "spot",
                "options": [{ "value": "spot", "label": "Spot" }]
              },
              {
                "id": "spot_options",
                "label": "Spot Options",
                "type": "object",
                "required": false,
                "nullable": true,
                "fields": [
                  {
                    "id": "max_price",
                    "label": "Max Price (per hour, USD)",
                    "type": "text",
                    "required": false,
                    "nullable": true,
                    "placeholder": "0.05"
                  },
                  {
                    "id": "spot_instance_type",
                    "label": "Spot Request Type",
                    "type": "select",
                    "default": "one-time",
                    "options": [
                      { "value": "one-time", "label": "One-time" },
                      { "value": "persistent", "label": "Persistent" }
                    ]
                  },
                  {
                    "id": "instance_interruption_behavior",
                    "label": "Interruption Behavior",
                    "type": "select",
                    "default": "terminate",
                    "options": [
                      { "value": "terminate", "label": "Terminate" },
                      { "value": "stop", "label": "Stop" },
                      { "value": "hibernate", "label": "Hibernate" }
                    ]
                  },
                  {
                    "id": "valid_until",
                    "label": "Valid Until (RFC3339)",
                    "type": "text",
                    "required": false,
                    "nullable": true,
                    "placeholder": "2026-12-31T23:59:59Z"
                  }
                ]
              }
            ]
          },
          {
            "id": "enable_enclave",
            "label": "Enable Nitro Enclave",
            "type": "boolean",
            "required": false,
            "nullable": true
          },
          {
            "id": "private_dns_name_options",
            "label": "Private DNS Name Options",
            "type": "object",
            "required": false,
            "nullable": true,
            "fields": [
              {
                "id": "hostname_type",
                "label": "Hostname Type",
                "type": "select",
                "required": false,
                "nullable": true,
                "options": [
                  { "value": "ip-name", "label": "IP Name" },
                  { "value": "resource-name", "label": "Resource Name" }
                ]
              },
              {
                "id": "enable_resource_name_dns_a_record",
                "label": "Enable Resource-Name A Record",
                "type": "boolean",
                "required": false,
                "nullable": true
              },
              {
                "id": "enable_resource_name_dns_aaaa_record",
                "label": "Enable Resource-Name AAAA Record",
                "type": "boolean",
                "required": false,
                "nullable": true
              }
            ]
          },
          {
            "id": "capacity_reservation_specification",
            "label": "Capacity Reservation",
            "type": "object",
            "required": false,
            "nullable": true,
            "fields": [
              {
                "id": "capacity_reservation_preference",
                "label": "Preference",
                "type": "select",
                "required": false,
                "nullable": true,
                "options": [
                  { "value": "open", "label": "Open" },
                  { "value": "none", "label": "None" }
                ]
              },
              {
                "id": "capacity_reservation_target",
                "label": "Target",
                "type": "object",
                "required": false,
                "nullable": true,
                "fields": [
                  {
                    "id": "capacity_reservation_id",
                    "label": "Capacity Reservation ID",
                    "type": "text",
                    "required": false,
                    "nullable": true
                  },
                  {
