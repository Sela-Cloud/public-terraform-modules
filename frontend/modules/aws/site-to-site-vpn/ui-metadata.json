                    "required": false,
                    "nullable": true,
                    "description": "No lookup is wired here, since this catalog does not yet have a CloudWatch Logs log-group lookup -- enter the ARN directly."
                  },
                  {
                    "id": "log_output_format",
                    "label": "Log Output Format",
                    "type": "select",
