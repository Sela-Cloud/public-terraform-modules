{
  "$schema": "../../../ui-metadata.schema.json",
  "module": "site-to-site-vpn",
  "version": "1.0.0",
  "display": {
    "label": "AWS Site-to-Site VPN",
    "icon": "vpn",
    "description": "Provision a Customer Gateway (created or referenced) and a Site-to-Site VPN Connection to a Virtual Private Gateway or Transit Gateway, with both tunnels and optional static routes",
    "category": "regional"
  },
  "globals": [
    {
      "id": "region",
      "label": "AWS Region",
      "description": "The AWS region where resources will be provisioned.",
      "type": "select",
      "required": true,
      "default": "us-east-1",
      "data_source": {
        "resource": "ec2.regions",
        "params": {},
        "display": {
          "value_key": "name",
          "label_key": "description",
          "description_key": "name"
        }
      }
    }
  ],
  "resource": {
    "variable": "site_to_site_vpn",
    "key_field": "name",
    "key_label": "Name",
    "key_description": "Unique name for the VPN Connection, applied as the 'Name' tag.",
    "sections": [
      {
        "id": "basic",
        "label": "Basic Configuration",
        "fields": [
          {
            "id": "name",
            "label": "Name",
            "type": "text",
            "required": true,
            "placeholder": "prod-s2s-vpn",
            "validation": {
              "min": 1,
              "max": 255,
              "pattern": "^[a-zA-Z0-9-_]+$",
              "pattern_error": "Name must contain only alphanumeric characters, dashes, and underscores."
            }
          }
        ]
      },
      {
        "id": "customer_gateway",
        "label": "Customer Gateway",
        "description": "The on-premises side of the VPN connection. Create a new Customer Gateway here, or reference an existing one.",
        "fields": [
          {
            "id": "create_customer_gateway",
            "label": "Create Customer Gateway",
            "description": "Uncheck to reference an existing Customer Gateway instead.",
            "type": "boolean",
            "required": false,
            "default": true
          },
          {
            "id": "customer_gateway_id",
            "label": "Existing Customer Gateway",
            "type": "select",
            "required": false,
            "nullable": true,
            "depends_on": {
              "field": "create_customer_gateway",
              "value": false,
              "operator": "eq"
            },
            "data_source": {
              "resource": "ec2.customer_gateways",
              "params": {
                "region": {
                  "from_field": "region"
                }
              },
              "display": {
                "value_key": "id",
                "label_key": "name",
                "description_key": "ipAddress"
              },
              "allow_custom": true,
              "cache_ttl": 300
            }
          },
          {
            "id": "customer_gateway_ip_address",
            "label": "Outside IP Address",
            "description": "The IPv4 address for the customer gateway device's outside interface.",
            "type": "text",
            "required": false,
            "nullable": true,
            "placeholder": "203.0.113.1",
            "depends_on": {
              "field": "create_customer_gateway",
              "value": true,
              "operator": "eq"
            }
          },
          {
            "id": "customer_gateway_bgp_asn",
            "label": "BGP ASN",
            "description": "1 to 2147483647. Mutually exclusive with Extended BGP ASN below.",
            "type": "text",
            "required": false,
            "nullable": true,
            "placeholder": "65000",
            "depends_on": {
              "field": "create_customer_gateway",
              "value": true,
              "operator": "eq"
            }
          },
          {
            "id": "customer_gateway_bgp_asn_extended",
            "label": "Extended BGP ASN",
            "description": "2147483648 to 4294967295. Mutually exclusive with BGP ASN above.",
            "type": "text",
            "required": false,
            "nullable": true,
            "depends_on": {
              "field": "create_customer_gateway",
              "value": true,
              "operator": "eq"
            }
          },
          {
            "id": "customer_gateway_certificate_arn",
            "label": "Device Certificate ARN",
            "description": "For certificate-based authentication instead of a pre-shared key. No lookup is wired here -- this catalog's ACM lookup returns public certificates, not the private-CA device certificates this field needs -- enter the ARN directly.",
            "type": "text",
            "required": false,
            "nullable": true,
            "depends_on": {
              "field": "create_customer_gateway",
              "value": true,
              "operator": "eq"
            }
          },
          {
            "id": "customer_gateway_device_name",
            "label": "Device Name",
            "description": "For your own reference.",
            "type": "text",
            "required": false,
            "nullable": true,
            "depends_on": {
              "field": "create_customer_gateway",
              "value": true,
              "operator": "eq"
            }
          }
        ]
      },
      {
        "id": "vpn_connection_target",
        "label": "VPN Connection Target",
        "description": "Exactly one of these two is required.",
        "fields": [
          {
            "id": "vpn_gateway_id",
            "label": "Virtual Private Gateway",
            "type": "select",
            "required": false,
            "nullable": true,
            "data_source": {
              "resource": "ec2.vpn_gateways",
              "params": {
                "region": {
                  "from_field": "region"
                }
              },
              "display": {
                "value_key": "id",
                "label_key": "name",
                "description_key": "vpcId"
              },
              "allow_custom": true,
              "cache_ttl": 300
            }
          },
          {
            "id": "transit_gateway_id",
            "label": "Transit Gateway",
            "description": "No lookup is wired here, since this catalog does not yet create Transit Gateways -- enter the ID directly.",
            "type": "text",
            "required": false,
            "nullable": true,
            "placeholder": "tgw-0123456789abcdef0"
          }
        ]
      },
      {
        "id": "vpn_connection",
        "label": "VPN Connection",
        "fields": [
          {
            "id": "static_routes_only",
            "label": "Static Routes Only",
            "description": "For customer gateway devices that don't support BGP. Leave unchecked for dynamic BGP routing.",
            "type": "boolean",
            "required": false,
            "default": false
          },
          {
            "id": "enable_acceleration",
            "label": "Enable Acceleration",
            "description": "Only valid when connected to a Transit Gateway above.",
            "type": "boolean",
            "required": false,
            "default": false,
            "depends_on": {
              "field": "transit_gateway_id",
              "value": null,
              "operator": "neq"
            }
          },
          {
            "id": "local_ipv4_network_cidr",
            "label": "Local IPv4 Network CIDR",
            "description": "The IPv4 CIDR on the AWS side of the VPN connection.",
            "type": "text",
            "required": false,
            "nullable": true,
            "placeholder": "0.0.0.0/0"
          },
          {
            "id": "remote_ipv4_network_cidr",
            "label": "Remote IPv4 Network CIDR",
            "description": "The IPv4 CIDR on the customer gateway side of the VPN connection.",
            "type": "text",
            "required": false,
            "nullable": true,
            "placeholder": "0.0.0.0/0"
          },
          {
            "id": "local_ipv6_network_cidr",
            "label": "Local IPv6 Network CIDR",
            "type": "text",
            "required": false,
            "nullable": true
          },
          {
            "id": "remote_ipv6_network_cidr",
            "label": "Remote IPv6 Network CIDR",
            "type": "text",
            "required": false,
            "nullable": true
          },
          {
            "id": "outside_ip_address_type",
            "label": "Outside IP Address Type",
            "type": "select",
            "required": false,
            "nullable": true,
            "default": null,
            "options": [
              {
                "value": "PublicIpv4",
                "label": "Public IPv4"
              },
              {
                "value": "PrivateIpv4",
                "label": "Private IPv4 (requires Transport Transit Gateway Attachment below)"
              }
            ]
          },
          {
            "id": "transport_transit_gateway_attachment_id",
            "label": "Transport Transit Gateway Attachment",
            "description": "Required when Outside IP Address Type is Private IPv4. No lookup is wired here, since this catalog does not yet create Transit Gateway attachments -- enter the ID directly.",
            "type": "text",
            "required": false,
            "nullable": true,
            "placeholder": "tgw-attach-0123456789abcdef0"
          },
          {
            "id": "tunnel_inside_ip_version",
            "label": "Tunnel Inside IP Version",
            "type": "select",
            "required": false,
            "nullable": true,
            "default": null,
            "options": [
              {
                "value": "ipv4",
                "label": "IPv4"
              },
              {
                "value": "ipv6",
                "label": "IPv6"
              }
            ]
          },
          {
            "id": "tunnel_bandwidth",
            "label": "Tunnel Bandwidth",
            "description": "Not supported when attached to a Virtual Private Gateway, or when acceleration is enabled.",
            "type": "select",
            "required": false,
            "nullable": true,
            "default": null,
            "options": [
              {
                "value": "standard",
                "label": "Standard (1.25 Gbps)"
              },
              {
                "value": "large",
                "label": "Large (5 Gbps, Transit Gateway only)"
              }
            ]
          },
          {
            "id": "preshared_key_storage",
            "label": "Pre-Shared Key Storage",
            "description": "Leave as Standard to keep pre-shared keys in the Site-to-Site VPN service (and Terraform state). Choose Secrets Manager to store them there instead.",
            "type": "select",
            "required": false,
            "nullable": true,
            "default": null,
            "options": [
              {
                "value": "Standard",
                "label": "Standard"
              },
              {
                "value": "SecretsManager",
                "label": "AWS Secrets Manager"
              }
            ]
          }
        ]
      },
      {
        "id": "tunnel1",
        "label": "Tunnel 1",
        "fields": [
          {
            "id": "tunnel1",
            "label": "Tunnel 1 Options",
            "type": "object",
            "required": false,
            "nullable": true,
            "default": {},
            "fields": [
              {
                "id": "inside_cidr",
                "label": "Inside IPv4 CIDR",
                "type": "text",
                "required": false,
                "nullable": true,
                "placeholder": "169.254.100.0/30"
              },
              {
                "id": "inside_ipv6_cidr",
                "label": "Inside IPv6 CIDR",
                "type": "text",
                "required": false,
                "nullable": true
              },
              {
                "id": "preshared_key",
                "label": "Pre-Shared Key",
                "type": "text",
                "required": false,
                "nullable": true,
                "sensitive": true
              },
              {
                "id": "dpd_timeout_action",
                "label": "DPD Timeout Action",
                "type": "select",
                "required": false,
                "nullable": true,
                "default": null,
                "options": [
                  {
                    "value": "clear",
                    "label": "Clear"
                  },
                  {
                    "value": "none",
                    "label": "None"
                  },
                  {
                    "value": "restart",
                    "label": "Restart"
                  }
                ]
              },
              {
                "id": "dpd_timeout_seconds",
                "label": "DPD Timeout (seconds)",
                "type": "number",
                "required": false,
                "nullable": true
              },
              {
                "id": "ike_versions",
                "label": "IKE Versions",
                "type": "list",
                "required": false,
