region = "us-east-1"

iam_user = {
  "john.doe" = {
    name                 = "john.doe"
    path                 = "/engineering/"
    permissions_boundary = null

    groups = [
      "developers"
    ]

    managed_policy_arns = [
      "arn:aws:iam::aws:policy/PowerUserAccess"
    ]

    tags = {
      Environment = "development"
      Department  = "Engineering"
      Role        = "Backend Developer"
      ManagedBy   = "Terraform"
    }
  },

  "cicd-deployer" = {
    name                 = "cicd-deployer"
    path                 = "/automation/"
    permissions_boundary = "arn:aws:iam::123456789012:policy/DeveloperBoundary"

    groups = [
      "deployers"
    ]

    managed_policy_arns = []

    tags = {
      Environment = "production"
      Team        = "DevOps"
      Purpose     = "Automated CI/CD deployment"
      ManagedBy   = "Terraform"
    }
  }
}
