{
    "$schema": "../../../ui-metadata.schema.json",
    "module": "secret",
    "version": "1.0.0",
    "display": {
        "label": "Secrets Manager",
        "icon": "key",
        "description": "AWS Secrets Manager secrets with optional KMS encryption, multi-region replication, and automatic rotation.",
        "category": "regional"
    },
    "globals": [],
    "import": {
        "module": "secrets",
        "target": "aws_secretsmanager_secret.this",
        "id_template": "{secret_id}",
        "identity_fields": [
            "secret_id"
        ],
        "requires_review": true
    },
    "resource": {
        "variable": "secrets",
        "key_field": "secret_id",
        "key_label": "Secret ID",
        "key_description": "Secret names cannot be changed after creation.",
        "locked_after_create": true,
        "sections": [
            {
                "id": "basics",
                "label": "Secret configuration",
                "fields": [
                    {
                        "id": "secret_id",
                        "label": "Secret ID",
                        "locked_after_create": true,
                        "type": "text",
                        "required": true,
                        "placeholder": "prod/app/db-password",
                        "validation": {
                            "min": 1,
                            "max": 512,
                            "pattern": "^[A-Za-z0-9/_+=.@-]{1,512}$",
                            "pattern_error": "Use letters, numbers, and the characters /_+=.@-"
                        }
                    },
                    {
                        "id": "description",
                        "label": "Description",
                        "type": "text",
                        "nullable": true,
                        "validation": {
                            "max": 2048
                        }
                    },
                    {
                        "id": "kms_key_id",
                        "label": "KMS key",
                        "description": "KMS key ID, ARN, or alias. Leave empty to use the default aws/secretsmanager key.",
                        "type": "text",
                        "nullable": true,
                        "placeholder": "arn:aws:kms:us-east-1:123456789012:key/..."
                    },
                    {
                        "id": "recovery_window_in_days",
                        "label": "Recovery window (days)",
                        "description": "Days Secrets Manager waits before permanently deleting the secret. Use 0 to delete immediately, otherwise 7 to 30.",
                        "type": "number",
                        "default": 30,
                        "validation": {
                            "min": 0,
                            "max": 30
                        }
                    },
                    {
                        "id": "tags",
                        "label": "Tags",
                        "type": "map"
                    }
                ]
            },
            {
                "id": "replication",
                "label": "Replication",
                "collapsed": true,
                "fields": [
                    {
                        "id": "custom_replication",
                        "label": "Enable replication",
                        "description": "Replicate this secret to other regions.",
                        "type": "boolean",
                        "default": false
                    },
                    {
                        "id": "replica_regions",
                        "label": "Replica regions",
                        "description": "Regions to replicate the secret to, for example us-west-2.",
                        "type": "list",
                        "depends_on": {
                            "field": "custom_replication",
                            "value": true
                        }
                    }
                ]
            },
            {
                "id": "rotation",
                "label": "Rotation",
                "collapsed": true,
                "fields": [
                    {
                        "id": "set_rotation",
                        "label": "Enable automatic rotation",
                        "type": "boolean",
                        "default": false
                    },
                    {
                        "id": "rotation_lambda_arn",
                        "label": "Rotation Lambda ARN",
                        "type": "text",
                        "required": true,
                        "placeholder": "arn:aws:lambda:us-east-1:123456789012:function:rotate-secret",
                        "depends_on": {
                            "field": "set_rotation",
                            "value": true
                        },
                        "validation": {
                            "pattern": "^arn:aws[a-zA-Z-]*:lambda:[a-z0-9-]+:\\d{12}:function:[A-Za-z0-9_-]+(:[A-Za-z0-9_-]+)?$",
                            "pattern_error": "Enter a valid Lambda function ARN."
                        }
                    },
                    {
                        "id": "rotation_period_days",
                        "label": "Rotation period (days)",
                        "description": "Set this or a schedule expression, not both.",
                        "type": "number",
                        "nullable": true,
                        "default": 30,
                        "depends_on": {
                            "field": "set_rotation",
                            "value": true
                        },
                        "validation": {
                            "min": 1,
                            "max": 1000
                        }
                    },
                    {
                        "id": "rotation_duration",
                        "label": "Rotation window duration",
                        "description": "Length of the rotation window in whole hours, for example 2h. Maximum is 24h.",
                        "type": "text",
                        "nullable": true,
                        "placeholder": "2h",
                        "depends_on": {
                            "field": "set_rotation",
                            "value": true
                        },
                        "validation": {
                            "pattern": "^([1-9]|1[0-9]|2[0-4])h$",
                            "pattern_error": "Use whole hours, for example 2h (maximum 24h)."
                        }
                    },
                    {
                        "id": "rotation_schedule_expression",
                        "label": "Rotation schedule expression",
                        "description": "Overrides the rotation period when set.",
                        "type": "text",
                        "nullable": true,
                        "placeholder": "rate(10 days) or cron(0 8 1 * ? *)",
                        "depends_on": {
                            "field": "set_rotation",
                            "value": true
                        },
                        "validation": {
                            "pattern": "^(rate\\(\\d+ (day|days|hour|hours)\\)|cron\\(.+\\))$",
                            "pattern_error": "Use rate(N days) or cron(...)."
                        }
                    }
                ]
            }
        ]
    }
}