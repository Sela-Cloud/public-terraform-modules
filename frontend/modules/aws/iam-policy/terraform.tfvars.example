region = "us-east-1"

iam_policy = {
  "s3-readonly-policy" = {
    name        = "s3-readonly-policy"
    name_prefix = null
    description = "Grants read-only access to Amazon S3 buckets and objects"
    path        = "/engineering/"

    policy = <<-EOT
{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3ReadOnlyPermissions",
      "Effect": "Allow",
      "Action": [
        "s3:Get*",
        "s3:List*"
      ],
      "Resource": "*"
    }
  ]
}
EOT

    delay_after_policy_creation_in_ms = null

    tags = {
      Environment = "production"
      Department  = "Engineering"
      ManagedBy   = "Terraform"
    }
  },

  "dynamodb-app-policy" = {
    name        = "dynamodb-app-policy"
    name_prefix = null
    description = "Grants read/write access to application DynamoDB tables"
    path        = "/application/"

    policy = <<-EOT
{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DynamoDBTableAccess",
      "Effect": "Allow",
      "Action": [
        "dynamodb:BatchGetItem",
        "dynamodb:BatchWriteItem",
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:Query",
        "dynamodb:Scan"
      ],
      "Resource": "arn:aws:dynamodb:*:*:table/app-*"
    }
  ]
}
EOT

    delay_after_policy_creation_in_ms = 1000

    tags = {
      Environment = "staging"
      Service     = "AppBackend"
      ManagedBy   = "Terraform"
    }
  }
}
