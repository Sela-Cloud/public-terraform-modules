{
  "$schema": "../../../ui-metadata.schema.json",
  "module": "lt",
  "version": "1.0.0",
  "display": {
    "label": "AWS Launch Template",
    "icon": "server",
    "description": "Create and manage Amazon EC2 Launch Templates with AMIs, instance sizing, storage mappings, and network configurations",
    "category": "regional"
  },
  "globals": [
    {
      "id": "region",
      "label": "AWS Region",
      "description": "The AWS region where resources will be provisioned.",
      "type": "select",
      "required": true,
      "default": "us-east-1",
      "data_source": {
        "resource": "ec2.regions",
        "params": {},
        "display": {
          "value_key": "name",
          "label_key": "description",
          "description_key": "name"
        }
      }
    }
  ],
  "resource": {
    "variable": "lt",
    "key_field": "name",
    "key_label": "Launch Template Name",
    "key_description": "Unique identifier name for the launch template. Serves as map key.",
    "sections": [
      {
        "id": "basic",
        "label": "Basic Configuration",
        "description": "Core launch template identification and version management.",
        "fields": [
          {
            "id": "name",
            "label": "Launch Template Name",
            "description": "The name of the launch template.",
            "type": "text",
            "required": true,
            "default": "lt-default",
            "placeholder": "my-app-launch-template",
            "validation": {
              "min": 1,
              "max": 128,
              "pattern": "^[a-zA-Z0-9()._-]+$",
              "pattern_error": "Name must contain only alphanumeric characters, dots, underscores, dashes, and parentheses."
            }
          },
          {
            "id": "name_prefix",
            "label": "Name Prefix",
            "description": "Creates a unique name beginning with the specified prefix. Conflicts with name.",
            "type": "text",
            "required": false,
            "default": null,
            "nullable": true,
            "placeholder": "my-app-"
          },
          {
            "id": "description",
            "label": "Description",
            "description": "Description of the launch template.",
            "type": "text",
            "required": false,
            "default": null,
            "nullable": true,
            "placeholder": "Launch template for web application tier"
          },
          {
            "id": "update_default_version",
            "label": "Update Default Version",
            "description": "Whether to update Default Version each time the template is updated.",
            "type": "boolean",
            "required": false,
            "default": true
          }
        ]
      },
      {
        "id": "compute",
        "label": "Compute & Instance Settings",
        "description": "AMI selection, instance sizing, key pairs, and IAM instance profile.",
        "fields": [
          {
            "id": "image_id",
            "label": "AMI ID",
            "description": "The AMI ID to use to launch the instance (e.g., ami-0c55b159cbfafe1f0).",
            "type": "text",
            "required": false,
            "default": null,
            "nullable": true,
            "placeholder": "ami-0c55b159cbfafe1f0"
          },
          {
            "id": "instance_type",
            "label": "Instance Type",
            "description": "The EC2 instance type to use for instances launched from this template.",
            "type": "text",
            "required": false,
            "default": "t3.micro",
            "placeholder": "t3.micro"
          },
          {
            "id": "key_name",
            "label": "Key Pair Name",
            "description": "The name of the EC2 Key Pair to use for SSH access.",
            "type": "text",
            "required": false,
            "default": null,
            "nullable": true,
            "placeholder": "my-ec2-key"
          },
          {
            "id": "iam_instance_profile_name",
            "label": "IAM Instance Profile Name",
            "description": "The name of the IAM instance profile to associate with the instance.",
            "type": "text",
            "required": false,
            "default": null,
            "nullable": true,
            "placeholder": "ec2-instance-role"
          },
          {
            "id": "iam_instance_profile_arn",
            "label": "IAM Instance Profile ARN",
            "description": "The ARN of the IAM instance profile to associate with the instance.",
            "type": "text",
            "required": false,
            "default": null,
            "nullable": true,
            "placeholder": "arn:aws:iam::123456789012:instance-profile/..."
          },
          {
            "id": "ebs_optimized",
            "label": "EBS Optimized",
            "description": "If true, launched instances will be EBS-optimized.",
            "type": "boolean",
            "required": false,
            "default": null,
            "nullable": true
          },
          {
            "id": "enable_monitoring",
            "label": "Detailed Monitoring",
            "description": "Enable detailed 1-minute CloudWatch monitoring metrics.",
            "type": "boolean",
            "required": false,
            "default": null,
            "nullable": true
          }
        ]
      },
      {
        "id": "network",
        "label": "Networking & Security",
        "description": "Security groups and network configurations.",
        "fields": [
          {
            "id": "vpc_security_group_ids",
            "label": "VPC Security Group IDs",
            "description": "A list of security group IDs to associate with instances.",
            "type": "list",
            "required": false,
            "default": null,
            "nullable": true
          }
        ]
      },
      {
        "id": "network_interfaces",
        "label": "Network Interfaces",
        "description": "Customize network interfaces attached at instance boot.",
        "collapsed": true,
        "fields": [
          {
            "id": "network_interfaces",
            "label": "Network Interface",
            "type": "repeatable",
            "required": false,
            "default": [],
            "fields": [
              {
                "id": "device_index",
                "label": "Device Index",
                "type": "number",
                "default": 0,
                "validation": { "min": 0 }
              },
              {
                "id": "subnet_id",
                "label": "Subnet ID",
                "type": "text",
                "required": false,
                "nullable": true,
                "placeholder": "subnet-0123456789abcdef0"
              },
              {
                "id": "security_groups",
                "label": "Security Group IDs",
                "type": "list",
                "required": false,
                "nullable": true
              },
              {
                "id": "associate_public_ip_address",
                "label": "Associate Public IP Address",
                "type": "boolean",
                "required": false,
                "default": null,
                "nullable": true
              },
              {
                "id": "delete_on_termination",
                "label": "Delete on Termination",
                "type": "boolean",
                "default": true
              },
              {
                "id": "description",
                "label": "Description",
                "type": "text",
                "required": false,
                "nullable": true
              }
            ]
          }
        ]
      },
      {
        "id": "storage",
        "label": "Storage (EBS Volumes)",
        "description": "Additional EBS volumes attached to instances launched from this template.",
        "collapsed": true,
        "fields": [
          {
            "id": "block_device_mappings",
            "label": "Block Device Mapping",
            "description": "Each mapping attaches one EBS volume at the given device name.",
            "type": "repeatable",
            "required": false,
            "default": [],
            "fields": [
              {
                "id": "device_name",
                "label": "Device Name",
                "type": "text",
                "required": true,
                "placeholder": "/dev/xvda"
              },
              {
                "id": "ebs",
                "label": "EBS Volume",
                "type": "object",
                "nullable": true,
                "fields": [
                  {
                    "id": "volume_size",
                    "label": "Volume Size (GiB)",
                    "type": "number",
                    "default": 20,
                    "validation": { "min": 1 }
                  },
                  {
                    "id": "volume_type",
                    "label": "Volume Type",
                    "type": "select",
                    "default": "gp3",
                    "options": [
                      { "value": "gp3", "label": "gp3" },
                      { "value": "gp2", "label": "gp2" },
                      { "value": "io1", "label": "io1" },
                      { "value": "io2", "label": "io2" },
                      { "value": "st1", "label": "st1" },
                      { "value": "sc1", "label": "sc1" },
                      { "value": "standard", "label": "standard" }
                    ]
                  },
                  {
                    "id": "iops",
                    "label": "IOPS",
                    "type": "number",
                    "required": false,
                    "nullable": true
                  },
                  {
                    "id": "throughput",
                    "label": "Throughput (MB/s)",
                    "type": "number",
                    "required": false,
                    "nullable": true
                  },
                  {
                    "id": "encrypted",
                    "label": "Encrypted",
                    "type": "boolean",
                    "default": true
                  },
                  {
                    "id": "kms_key_id",
                    "label": "KMS Key ID",
                    "type": "text",
                    "required": false,
                    "nullable": true
                  },
                  {
                    "id": "delete_on_termination",
                    "label": "Delete on Termination",
                    "type": "boolean",
                    "default": true
                  },
                  {
                    "id": "snapshot_id",
                    "label": "Snapshot ID",
                    "type": "text",
                    "required": false,
                    "nullable": true
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "id": "tag_specifications",
        "label": "Launch-Time Tag Specifications",
        "description": "Tags applied to specific resource types (instance, volume, network interface) created at launch, in addition to the launch template's own tags.",
        "collapsed": true,
        "fields": [
          {
            "id": "tag_specifications",
            "label": "Tag Specification",
            "type": "repeatable",
            "required": false,
            "default": [],
            "fields": [
              {
                "id": "resource_type",
                "label": "Resource Type",
                "type": "select",
                "required": true,
                "options": [
                  { "value": "instance", "label": "Instance" },
                  { "value": "volume", "label": "Volume" },
                  { "value": "network-interface", "label": "Network Interface" },
                  { "value": "spot-instances-request", "label": "Spot Instances Request" }
                ]
              },
              {
                "id": "tags",
                "label": "Tags",
                "type": "map",
                "required": true
              }
            ]
          }
        ]
      },
      {
        "id": "user_data",
        "label": "User Data",
        "description": "Bootstrap shell script or cloud-init configuration executed on first boot.",
        "fields": [
          {
            "id": "user_data",
            "label": "User Data Script",
            "description": "The user data script (plain text or base64 encoded).",
            "type": "text",
            "multiline": true,
            "required": false,
            "default": null,
            "nullable": true,
            "placeholder": "#!/bin/bash\nyum update -y"
          }
        ]
      },
      {
        "id": "metadata",
        "label": "Metadata Options (IMDSv2)",
        "description": "Instance Metadata Service security configuration.",
        "fields": [
          {
            "id": "enable_metadata_options",
            "label": "Configure Metadata Options",
            "description": "Whether to configure instance metadata options.",
            "type": "boolean",
            "required": false,
            "default": true
          },
          {
            "id": "http_endpoint",
            "label": "HTTP Endpoint",
            "description": "Enable or disable the HTTP metadata endpoint.",
            "type": "select",
            "required": false,
            "default": "enabled",
            "options": [
              { "value": "enabled", "label": "Enabled" },
              { "value": "disabled", "label": "Disabled" }
            ]
          },
          {
            "id": "http_tokens",
            "label": "HTTP Tokens (IMDSv2)",
            "description": "Whether IMDSv2 session tokens are required.",
            "type": "select",
            "required": false,
            "default": "required",
            "options": [
              { "value": "required", "label": "Required (IMDSv2 enforced)" },
              { "value": "optional", "label": "Optional (IMDSv1 & IMDSv2)" }
            ]
          },
          {
            "id": "http_put_response_hop_limit",
            "label": "HTTP PUT Response Hop Limit",
            "description": "Desired HTTP PUT response hop limit for metadata requests (1-64).",
            "type": "number",
            "required": false,
            "default": 1,
            "validation": { "min": 1, "max": 64 }
          },
          {
            "id": "instance_metadata_tags",
            "label": "Instance Metadata Tags",
            "description": "Enables or disables access to instance tags from instance metadata.",
            "type": "select",
            "required": false,
            "default": null,
            "nullable": true,
            "options": [
              { "value": "enabled", "label": "Enabled" },
              { "value": "disabled", "label": "Disabled" }
            ]
          }
        ]
      },
      {
        "id": "protection",
        "label": "Instance Protection & Shutdown Behavior",
        "collapsed": true,
        "fields": [
          {
            "id": "disable_api_termination",
            "label": "Enable Termination Protection",
            "description": "Prevents the instance from being terminated via the API.",
            "type": "boolean",
            "required": false,
            "default": null,
            "nullable": true
          },
          {
            "id": "disable_api_stop",
            "label": "Enable Stop Protection",
            "description": "Prevents the instance from being stopped via the API.",
            "type": "boolean",
            "required": false,
            "default": null,
            "nullable": true
          },
          {
            "id": "instance_initiated_shutdown_behavior",
            "label": "Shutdown Behavior",
            "description": "What happens when the instance initiates a shutdown from the OS.",
            "type": "select",
            "required": false,
            "default": null,
            "nullable": true,
            "options": [
              { "value": "stop", "label": "Stop" },
              { "value": "terminate", "label": "Terminate" }
            ]
          }
        ]
      },
      {
        "id": "placement_section",
        "label": "Placement",
        "collapsed": true,
        "fields": [
          {
            "id": "placement",
            "label": "Placement",
            "type": "object",
            "required": false,
            "nullable": true,
            "fields": [
              {
                "id": "availability_zone",
                "label": "Availability Zone",
                "type": "text",
                "required": false,
                "nullable": true,
                "placeholder": "us-east-1a"
              },
              {
                "id": "tenancy",
                "label": "Tenancy",
                "type": "select",
                "required": false,
                "nullable": true,
                "options": [
                  { "value": "default", "label": "Default (shared hardware)" },
                  { "value": "dedicated", "label": "Dedicated Instance" },
                  { "value": "host", "label": "Dedicated Host" }
                ]
              },
              {
                "id": "affinity",
                "label": "Host Affinity",
                "type": "text",
                "required": false,
                "nullable": true,
                "depends_on": { "field": "tenancy", "value": "host" }
              },
              {
                "id": "host_id",
                "label": "Dedicated Host ID",
                "type": "text",
                "required": false,
                "nullable": true,
                "depends_on": { "field": "tenancy", "value": "host" }
              },
              {
                "id": "group_name",
                "label": "Placement Group Name",
                "type": "text",
                "required": false,
                "nullable": true
              }
            ]
          }
        ]
      },
      {
        "id": "cpu_options_section",
        "label": "CPU Options",
        "collapsed": true,
        "fields": [
          {
            "id": "cpu_options",
            "label": "CPU Options",
            "type": "object",
            "required": false,
            "nullable": true,
            "fields": [
              {
                "id": "core_count",
                "label": "Core Count",
                "type": "number",
                "required": false,
                "nullable": true,
                "validation": { "min": 1 }
              },
              {
                "id": "threads_per_core",
                "label": "Threads per Core",
                "type": "number",
                "required": false,
                "nullable": true,
                "validation": { "min": 1, "max": 2 }
              }
            ]
          }
        ]
      },
      {
        "id": "credit_specification_section",
        "label": "Credit Specification (Burstable Instances)",
        "description": "CPU credit option for T-family burstable instance types.",
        "collapsed": true,
        "fields": [
          {
            "id": "credit_specification",
            "label": "Credit Specification",
            "type": "object",
            "required": false,
            "nullable": true,
            "fields": [
              {
                "id": "cpu_credits",
                "label": "CPU Credits",
                "type": "select",
                "required": true,
                "options": [
                  { "value": "standard", "label": "Standard" },
                  { "value": "unlimited", "label": "Unlimited" }
                ]
              }
            ]
          }
        ]
      },
      {
        "id": "instance_market_options_section",
        "label": "Purchasing Option",
        "description": "Use Spot capacity instead of On-Demand for cost savings.",
        "collapsed": true,
        "fields": [
          {
            "id": "instance_market_options",
            "label": "Market Options",
            "type": "object",
            "required": false,
            "nullable": true,
            "fields": [
              {
                "id": "market_type",
                "label": "Market Type",
                "type": "select",
                "default": "spot",
                "options": [{ "value": "spot", "label": "Spot" }]
              },
              {
                "id": "spot_options",
                "label": "Spot Options",
                "type": "object",
                "required": false,
                "nullable": true,
                "fields": [
                  {
                    "id": "max_price",
                    "label": "Max Price (per hour, USD)",
                    "type": "text",
                    "required": false,
                    "nullable": true,
                    "placeholder": "0.05"
                  },
                  {
                    "id": "spot_instance_type",
                    "label": "Spot Request Type",
                    "type": "select",
                    "default": "one-time",
                    "options": [
                      { "value": "one-time", "label": "One-time" },
                      { "value": "persistent", "label": "Persistent" }
                    ]
                  },
                  {
                    "id": "instance_interruption_behavior",
                    "label": "Interruption Behavior",
                    "type": "select",
                    "default": "terminate",
                    "options": [
                      { "value": "terminate", "label": "Terminate" },
                      { "value": "stop", "label": "Stop" },
                      { "value": "hibernate", "label": "Hibernate" }
                    ]
                  },
                  {
                    "id": "valid_until",
                    "label": "Valid Until (RFC3339)",
                    "type": "text",
                    "required": false,
                    "nullable": true,
                    "placeholder": "2026-12-31T23:59:59Z"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "id": "tags",
        "label": "Tags",
        "description": "Resource tags assigned to the launch template.",
        "fields": [
          {
            "id": "tags",
            "label": "Resource Tags",
            "description": "Key-value tags assigned to the launch template.",
            "type": "map",
            "required": false,
            "default": {}
          }
        ]
      }
    ]
  }
}
