{
  "$schema": "../../../ui-metadata.schema.json",
  "module": "vpn-gateway",
  "version": "1.0.1",
  "display": {
    "label": "AWS VPN Gateway",
    "icon": "gateway",
    "description": "Provision a Virtual Private Gateway attached to a VPC, with route propagation for Site-to-Site VPN dynamic routing",
    "category": "regional"
  },
  "globals": [
    {
      "id": "region",
      "label": "AWS Region",
      "description": "The AWS region where resources will be provisioned.",
      "type": "select",
      "required": true,
      "data_source": {
        "resource": "ec2.regions",
        "params": {},
        "display": { "value_key": "name", "label_key": "description", "description_key": "name" }
      }
    }
  ],
  "provides": [
    {
      "data_source": "ec2.vpn_gateways",
      "value_field": "name"
    }
  ],
  "resource": {
    "variable": "vpn_gateway",
    "key_field": "name",
    "key_label": "Name",
    "key_description": "Unique name for the Virtual Private Gateway, applied as the 'Name' tag.",
    "sections": [
      {
        "id": "basic",
        "label": "Basic Configuration",
        "fields": [
          {
            "id": "name",
            "label": "Name",
            "type": "text",
            "required": true,
            "placeholder": "prod-vgw",
            "validation": { "min": 1, "max": 255, "pattern": "^[a-zA-Z0-9-_]+$", "pattern_error": "Name must contain only alphanumeric characters, dashes, and underscores." }
          },
          {
            "id": "vpc_id",
            "label": "VPC",
            "description": "Leave empty to create a detached gateway.",
            "type": "select",
            "required": false,
            "nullable": true,
            "data_source": {
              "resource": "ec2.vpcs",
              "params": { "region": { "from_field": "region" } },
              "display": { "value_key": "id", "label_key": "name", "description_key": "cidr" },
              "allow_custom": true,
              "cache_ttl": 300
            }
          },
          {
            "id": "availability_zone",
            "label": "Availability Zone",
            "type": "select",
            "required": false,
            "nullable": true,
            "data_source": {
              "resource": "ec2.availability_zones",
              "params": { "region": { "from_field": "region" } },
              "display": { "value_key": "name", "label_key": "name" },
              "allow_custom": true,
              "cache_ttl": 300
            }
          },
          {
            "id": "amazon_side_asn",
            "label": "Amazon-Side ASN",
            "description": "Leave empty to use AWS's default ASN (64512).",
            "type": "text",
            "required": false,
            "nullable": true,
            "placeholder": "64512"
          }
        ]
      },
      {
        "id": "route_propagation",
        "label": "Route Propagation",
        "description": "For dynamic (BGP) routing only. Leave empty for a static-routes-only VPN connection.",
        "fields": [
          {
            "id": "route_table_ids",
            "label": "Route Tables",
            "type": "list",
            "required": false,
            "default": [],
            "data_source": {
              "resource": "ec2.route_tables",
              "params": { "region": { "from_field": "region" }, "vpc_id": { "from_field": "vpc_id" } },
              "display": { "value_key": "id", "label_key": "name" },
              "allow_custom": true,
              "cache_ttl": 300
            }
          }
        ]
      },
      {
        "id": "tags",
        "label": "Tags",
        "fields": [
          { "id": "tags", "label": "Resource Tags", "type": "map", "required": false, "default": {} }
        ]
      }
    ]
  }
}
