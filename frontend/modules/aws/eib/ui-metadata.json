{
  "$schema": "../../../ui-metadata.schema.json",
  "module": "eib",
  "version": "1.0.0",
  "display": {
    "label": "AWS EC2 Image Builder",
    "icon": "layers",
    "description": "Automate the creation, testing, and deployment of golden virtual machine AMIs using EC2 Image Builder",
    "category": "regional"
  },
  "globals": [
    {
      "id": "region",
      "label": "AWS Region",
      "description": "The AWS region where resources will be provisioned.",
      "type": "select",
      "required": true,
      "default": "us-east-1",
      "data_source": {
        "resource": "ec2.regions",
        "params": {},
        "display": {
          "value_key": "name",
          "label_key": "description",
          "description_key": "name"
        }
      }
    }
  ],
  "resource": {
    "variable": "eib",
    "key_field": "name",
    "key_label": "Pipeline Name",
    "key_description": "Unique identifier name for the Image Builder pipeline. Serves as map key.",
    "sections": [
      {
        "id": "basic",
        "label": "Basic Configuration",
        "description": "Pipeline identification and status.",
        "fields": [
          {
            "id": "name",
            "label": "Pipeline Name",
            "description": "Unique name identifier for the Image Builder pipeline.",
            "type": "text",
            "required": true,
            "default": "eib-default",
            "placeholder": "my-golden-image-pipeline",
            "validation": {
              "min": 1,
              "max": 128,
              "pattern": "^[a-zA-Z0-9-_]+$",
              "pattern_error": "Name must contain only alphanumeric characters, dashes, and underscores."
            }
          },
          {
            "id": "description",
            "label": "Description",
            "description": "Description of the Image Builder pipeline.",
            "type": "text",
            "required": false,
            "default": null,
            "nullable": true,
            "placeholder": "Builds and tests hardened golden images"
          },
          {
            "id": "pipeline_status",
            "label": "Pipeline Status",
            "description": "Whether the pipeline is actively enabled.",
            "type": "select",
            "required": false,
            "default": "ENABLED",
            "options": [
              { "value": "ENABLED", "label": "Enabled" },
              { "value": "DISABLED", "label": "Disabled" }
            ]
          }
        ]
      },
      {
        "id": "recipe",
        "label": "Image Recipe",
        "description": "Parent image and build components.",
        "fields": [
          {
            "id": "parent_image",
            "label": "Parent Image",
            "description": "Base image ARN or AMI ID (e.g. arn:aws:imagebuilder:us-east-1:aws:image/amazon-linux-2-x86/x.x.x).",
            "type": "text",
            "required": true,
            "default": "arn:aws:imagebuilder:us-east-1:aws:image/amazon-linux-2-x86/x.x.x",
            "placeholder": "arn:aws:imagebuilder:us-east-1:aws:image/amazon-linux-2-x86/x.x.x"
          },
          {
            "id": "recipe_version",
            "label": "Recipe Version",
            "description": "Semantic version for the image recipe.",
            "type": "text",
            "required": false,
            "default": "1.0.0",
            "placeholder": "1.0.0"
          },
          {
            "id": "components",
            "label": "Build Components",
            "description": "List of Image Builder component ARNs to apply during build. At least one is required by AWS.",
            "type": "list",
            "required": true
          }
        ]
      },
      {
        "id": "storage",
        "label": "Storage (Output AMI)",
        "description": "Customize block device mappings (e.g. root volume size) for the resulting AMI.",
        "collapsed": true,
        "fields": [
          {
            "id": "block_device_mappings",
            "label": "Block Device Mapping",
            "type": "repeatable",
            "required": false,
            "default": [],
            "fields": [
              {
                "id": "device_name",
                "label": "Device Name",
                "type": "text",
                "required": true,
                "placeholder": "/dev/xvda"
              },
              {
                "id": "ebs",
                "label": "EBS Volume",
                "type": "object",
                "nullable": true,
                "fields": [
                  {
                    "id": "volume_size",
                    "label": "Volume Size (GiB)",
                    "type": "number",
                    "required": false,
                    "nullable": true,
                    "validation": { "min": 1 }
                  },
                  {
                    "id": "volume_type",
                    "label": "Volume Type",
                    "type": "select",
                    "required": false,
                    "nullable": true,
                    "options": [
                      { "value": "gp3", "label": "gp3" },
                      { "value": "gp2", "label": "gp2" },
                      { "value": "io1", "label": "io1" },
                      { "value": "io2", "label": "io2" },
                      { "value": "st1", "label": "st1" },
                      { "value": "sc1", "label": "sc1" },
                      { "value": "standard", "label": "standard" }
                    ]
                  },
                  {
                    "id": "delete_on_termination",
                    "label": "Delete on Termination",
                    "type": "boolean",
                    "default": true
                  },
                  {
                    "id": "encrypted",
                    "label": "Encrypted",
                    "type": "boolean",
                    "required": false,
                    "nullable": true
                  },
                  {
                    "id": "kms_key_id",
                    "label": "KMS Key ID",
                    "type": "text",
                    "required": false,
                    "nullable": true
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "id": "infrastructure",
        "label": "Infrastructure Configuration",
        "description": "EC2 instance sizing, IAM profile, and VPC networking for build instances.",
        "fields": [
          {
            "id": "instance_profile_name",
            "label": "IAM Instance Profile Name",
            "description": "IAM instance profile name attached to the build instance (must have EC2ImageBuilderProfile policies).",
            "type": "text",
            "required": true,
            "placeholder": "EC2ImageBuilderInstanceProfile"
          },
          {
            "id": "instance_types",
            "label": "Instance Types",
            "description": "List of EC2 instance types to use for build machines.",
            "type": "list",
            "required": false,
            "default": ["t3.medium"]
          },
          {
            "id": "subnet_id",
            "label": "Subnet",
            "description": "VPC Subnet where build instances will be launched.",
            "type": "select",
            "required": false,
            "default": null,
            "nullable": true,
            "placeholder": "subnet-0123456789abcdef0",
            "data_source": {
              "resource": "ec2.subnets",
              "params": { "region": { "from_field": "region" } },
              "display": { "value_key": "id", "label_key": "name", "description_key": "cidr" },
              "allow_custom": true,
              "cache_ttl": 300
            }
          },
          {
            "id": "security_group_ids",
            "label": "Security Group IDs",
            "description": "List of security group IDs for build instances.",
            "type": "list",
            "required": false,
            "default": []
          },
          {
            "id": "key_pair",
            "label": "EC2 Key Pair",
            "description": "SSH key pair name for troubleshooting build instances.",
            "type": "text",
            "required": false,
            "default": null,
            "nullable": true,
            "placeholder": "my-build-key"
          },
          {
            "id": "terminate_instance_on_failure",
            "label": "Terminate on Failure",
            "description": "Whether to automatically terminate build instances when the pipeline fails.",
            "type": "boolean",
            "required": false,
            "default": true
          },
          {
            "id": "sns_topic_arn",
            "label": "SNS Topic ARN",
            "description": "SNS Topic ARN for build status notifications.",
            "type": "text",
            "required": false,
            "default": null,
            "nullable": true,
            "placeholder": "arn:aws:sns:us-east-1:123456789012:image-builder-alerts"
          }
        ]
      },
      {
        "id": "build_instance_security",
        "label": "Build Instance Security & Logging",
        "description": "Instance metadata (IMDSv2) hardening and build log storage for the build/test instances.",
        "collapsed": true,
        "fields": [
          {
            "id": "http_tokens",
            "label": "HTTP Tokens (IMDSv2)",
            "description": "Whether IMDSv2 session tokens are required on build instances. Leave unset to use the AWS default.",
            "type": "select",
            "required": false,
            "default": null,
            "nullable": true,
            "options": [
              { "value": "required", "label": "Required (IMDSv2 enforced)" },
              { "value": "optional", "label": "Optional (IMDSv1 & IMDSv2)" }
            ]
          },
          {
            "id": "http_put_response_hop_limit",
            "label": "HTTP PUT Response Hop Limit",
            "description": "Desired HTTP PUT response hop limit for metadata requests (1-64).",
            "type": "number",
            "required": false,
            "nullable": true,
            "depends_on": { "field": "http_tokens", "operator": "neq", "value": null },
            "validation": { "min": 1, "max": 64 }
          },
          {
            "id": "logging_s3_bucket_name",
            "label": "Build Logs S3 Bucket",
            "description": "S3 bucket to store build logs. Leave blank to skip logging configuration.",
            "type": "text",
            "required": false,
            "default": null,
            "nullable": true,
            "placeholder": "my-build-logs-bucket"
          },
          {
            "id": "logging_s3_key_prefix",
            "label": "Build Logs S3 Key Prefix",
            "type": "text",
            "required": false,
            "nullable": true,
            "placeholder": "eib/",
            "depends_on": { "field": "logging_s3_bucket_name", "operator": "neq", "value": null }
          }
        ]
      },
      {
        "id": "schedule",
        "label": "Pipeline Schedule",
        "description": "Automated schedule expression for regular image builds.",
        "fields": [
          {
            "id": "schedule_expression",
            "label": "Schedule Expression",
            "description": "Cron or rate expression (e.g., cron(0 0 ? * SUN *) or rate(7 days)).",
            "type": "text",
            "required": false,
            "default": null,
            "nullable": true,
            "placeholder": "cron(0 0 ? * SUN *)"
          }
        ]
      },
      {
        "id": "distribution",
        "label": "Distribution (AMI Sharing & Regions)",
        "description": "Copy the built AMI to other regions and optionally share it with other AWS accounts. Leave empty to only build in this region with no distribution.",
        "collapsed": true,
        "fields": [
          {
            "id": "distributions",
            "label": "Distribution Target",
            "type": "repeatable",
            "required": false,
            "default": [],
            "fields": [
              {
                "id": "region",
                "label": "Target Region",
                "type": "select",
                "required": true,
                "data_source": {
                  "resource": "ec2.regions",
                  "params": {},
                  "display": { "value_key": "name", "label_key": "description" },
                  "allow_custom": true,
                  "cache_ttl": 300
                }
              },
              {
                "id": "ami_name",
                "label": "Output AMI Name",
                "description": "Supports Image Builder variables, e.g. {{ imagebuilder:buildDate }}.",
                "type": "text",
                "required": false,
                "nullable": true,
                "placeholder": "golden-ami-{{ imagebuilder:buildDate }}"
              },
              {
                "id": "ami_description",
                "label": "Output AMI Description",
                "type": "text",
                "required": false,
                "nullable": true
              },
              {
                "id": "ami_tags",
                "label": "Output AMI Tags",
                "type": "map",
                "required": false,
                "default": {}
              },
              {
                "id": "kms_key_id",
                "label": "KMS Key ID",
                "description": "Encrypt the copied AMI's snapshot with this KMS key.",
                "type": "text",
                "required": false,
                "nullable": true
              },
              {
                "id": "launch_permission_account_ids",
                "label": "Share with AWS Account IDs",
                "type": "list",
                "required": false,
                "default": []
              }
            ]
          }
        ]
      },
      {
        "id": "tags",
        "label": "Tags",
        "description": "Resource tags assigned to Image Builder resources.",
        "fields": [
          {
            "id": "tags",
            "label": "Resource Tags",
            "description": "Key-value tags assigned to all created resources.",
            "type": "map",
            "required": false,
            "default": {}
          }
        ]
      }
    ]
  }
}
