{
  "$schema": "../../../ui-metadata.schema.json",
  "module": "rds",
  "version": "1.0.1",
  "display": {
    "label": "AWS RDS Database",
    "icon": "database",
    "description": "Deploy managed Amazon RDS MySQL and PostgreSQL databases with high availability, security, and automated backups",
    "category": "regional"
  },
  "globals": [
    {
      "id": "region",
      "label": "AWS Region",
      "description": "The AWS region where resources will be provisioned.",
      "type": "select",
      "required": true,
      "data_source": {
        "resource": "ec2.regions",
        "params": {},
        "display": {
          "value_key": "name",
          "label_key": "description",
          "description_key": "name"
        }
      }
    }
  ],
  "resource": {
    "variable": "rds",
    "key_field": "identifier",
    "key_label": "DB Instance Identifier",
    "key_description": "Unique identifier for the RDS instance in the AWS Region.",
    "sections": [
      {
        "id": "basic",
        "label": "Engine & Compute",
        "description": "Database engine, compute sizing, and credentials.",
        "fields": [
          {
            "id": "identifier",
            "label": "DB Identifier",
            "description": "Unique name for the RDS database instance.",
            "type": "text",
            "required": true,
            "placeholder": "my-database"
          },
          {
            "id": "identifier_prefix",
            "label": "DB Identifier Prefix",
            "description": "Creates a unique identifier beginning with this prefix instead of using DB Identifier above, which takes precedence when set.",
            "type": "text",
            "required": false,
            "nullable": true
          },
          {
            "id": "engine",
            "label": "Database Engine",
            "description": "Database engine to deploy (e.g., mysql or postgres).",
            "type": "select",
            "required": true,
            "default": "mysql",
            "options": [
              {
                "label": "MySQL",
                "value": "mysql"
              },
              {
                "label": "MariaDB",
                "value": "mariadb"
              },
              {
                "label": "PostgreSQL",
                "value": "postgres"
              }
            ]
          },
          {
            "id": "engine_version",
            "label": "Engine Version",
            "description": "Database engine version (e.g., 8.0.35 for MySQL or 16.1 for PostgreSQL).",
            "type": "text",
            "required": false,
            "placeholder": "8.0.35"
          },
          {
            "id": "instance_class",
            "label": "Instance Class",
            "description": "Compute size for the RDS instance.",
            "type": "text",
            "required": true,
            "default": "db.t4g.micro",
            "placeholder": "db.t4g.micro"
          },
          {
            "id": "db_name",
            "label": "Initial Database Name",
            "description": "Name of the initial schema database to create.",
            "type": "text",
            "required": false,
            "placeholder": "appdb"
          },
          {
            "id": "character_set_name",
            "label": "Character Set",
            "description": "Character set to use on DB creation, for engines that support it.",
            "type": "text",
            "required": false,
            "nullable": true
          },
          {
            "id": "license_model",
            "label": "License Model",
            "description": "Leave empty for the engine default (general-public-license for MySQL/MariaDB, postgresql-license for PostgreSQL).",
            "type": "text",
            "required": false,
            "nullable": true
          },
          {
            "id": "username",
            "label": "Master Username",
            "description": "Master username (defaults to admin for MySQL, postgres for PostgreSQL).",
            "type": "text",
            "required": false,
            "placeholder": "admin"
          },
          {
            "id": "manage_master_user_password",
            "label": "Manage Password in Secrets Manager",
            "description": "Automatically create and manage credentials securely in AWS Secrets Manager.",
            "type": "boolean",
            "required": false,
            "default": true
          },
          {
            "id": "master_user_secret_kms_key_id",
            "label": "Secrets Manager KMS Key",
            "description": "Custom KMS key for the managed master-password secret. Leave empty for the default key.",
            "type": "select",
            "required": false,
            "nullable": true,
            "depends_on": { "field": "manage_master_user_password", "value": true },
            "data_source": {
              "resource": "kms.keys",
              "params": { "region": { "from_field": "region" } },
              "display": { "value_key": "id", "label_key": "name" },
              "allow_custom": true,
              "cache_ttl": 300
            }
          },
          {
            "id": "password",
            "label": "Master Password",
            "description": "Master user password. Required unless managing in Secrets Manager, restoring from a snapshot, or creating a read replica.",
            "type": "text",
            "required": false,
            "depends_on": { "field": "manage_master_user_password", "value": false }
          },
          {
            "id": "port",
            "label": "Database Port",
            "description": "Custom port (defaults to 3306 for MySQL, 5432 for PostgreSQL).",
            "type": "number",
            "required": false
          }
        ]
      },
      {
        "id": "storage",
        "label": "Storage Configuration",
        "description": "Volume size, autoscaling, and encryption.",
        "fields": [
          {
            "id": "allocated_storage",
            "label": "Allocated Storage (GB)",
            "description": "Initial storage allocation in gigabytes.",
            "type": "number",
            "required": true,
            "default": 20
          },
          {
            "id": "max_allocated_storage",
            "label": "Max Autoscaling Storage (GB)",
            "description": "Upper limit for storage autoscaling (set to null or 0 to disable).",
            "type": "number",
            "required": false,
            "default": 100
          },
          {
            "id": "storage_type",
            "label": "Storage Type",
            "description": "Storage volume type (e.g., gp3, gp2, io1).",
            "type": "select",
            "required": true,
            "default": "gp3",
            "options": [
              {
                "label": "General Purpose SSD (gp3)",
                "value": "gp3"
              },
              {
                "label": "General Purpose SSD (gp2)",
                "value": "gp2"
              },
              {
                "label": "Provisioned IOPS SSD (io1)",
                "value": "io1"
              },
              {
                "label": "Provisioned IOPS SSD (io2)",
                "value": "io2"
              },
              {
                "label": "Magnetic (standard)",
                "value": "standard"
              }
            ]
          },
          {
            "id": "iops",
            "label": "Provisioned IOPS",
            "description": "Only applies to gp3, io1, and io2 storage types.",
            "type": "number",
            "required": false,
            "nullable": true,
            "depends_on": { "field": "storage_type", "operator": "in", "value": ["gp3", "io1", "io2"] }
          },
          {
            "id": "storage_throughput",
            "label": "Storage Throughput (MB/s)",
            "description": "Only applies to gp3 storage.",
            "type": "number",
            "required": false,
            "nullable": true,
            "depends_on": { "field": "storage_type", "value": "gp3" }
          },
          {
            "id": "dedicated_log_volume",
            "label": "Dedicated Log Volume",
            "description": "Use a dedicated log volume (DLV) for the DB instance.",
            "type": "boolean",
            "required": false,
            "default": false
          },
          {
            "id": "storage_encrypted",
            "label": "Storage Encrypted",
            "description": "Enable KMS encryption at rest for the database storage.",
            "type": "boolean",
            "required": false,
            "default": true
          },
          {
            "id": "kms_key_id",
            "label": "KMS Key ARN",
            "description": "Custom KMS key ARN for storage encryption (leave empty for AWS default).",
            "type": "select",
            "required": false,
            "nullable": true,
            "depends_on": { "field": "storage_encrypted", "value": true },
            "data_source": {
              "resource": "kms.keys",
              "params": { "region": { "from_field": "region" } },
              "display": { "value_key": "id", "label_key": "name" },
              "allow_custom": true,
              "cache_ttl": 300
            }
          }
        ]
      },
      {
        "id": "networking",
        "label": "Networking & Security",
        "description": "VPC, Subnet groups, and Security Group ingress rules.",
        "fields": [
          {
            "id": "vpc_id",
            "label": "VPC",
            "description": "The VPC where the RDS database and security group reside. Required when Create Security Group (below) is enabled -- which it is by default.",
            "type": "select",
            "required": false,
            "required_if": { "field": "create_security_group", "value": true },
            "placeholder": "vpc-0123456789abcdef0",
            "data_source": {
              "resource": "ec2.vpcs",
              "params": { "region": { "from_field": "region" } },
              "display": { "value_key": "id", "label_key": "name", "description_key": "cidr" },
              "allow_custom": true,
              "cache_ttl": 300
            }
          },
          {
            "id": "subnet_ids",
            "label": "Subnet IDs",
            "description": "At least 2 subnets, in different Availability Zones -- AWS rejects a DB subnet group built from fewer. Required when Create DB Subnet Group (below) is enabled -- which it is by default.",
            "type": "list",
            "required": false,
            "required_if": { "field": "create_db_subnet_group", "value": true },
            "validation": { "min": 2 },
            "data_source": {
              "resource": "ec2.subnets",
              "params": { "region": { "from_field": "region" }, "vpc_id": { "from_field": "vpc_id" } },
              "display": { "value_key": "id", "label_key": "name", "description_key": "cidr" },
              "allow_custom": true,
              "cache_ttl": 300
            }
          },
          {
            "id": "vpc_security_group_ids",
            "label": "Existing Security Group IDs",
            "description": "Existing security groups to attach, in addition to any dedicated one created above.",
            "type": "list",
            "required": false,
            "default": [],
            "data_source": {
              "resource": "ec2.security_groups",
              "params": { "region": { "from_field": "region" }, "vpc_id": { "from_field": "vpc_id" } },
              "display": { "value_key": "id", "label_key": "name", "description_key": "description" },
              "allow_custom": true,
              "cache_ttl": 300
            }
          },
          {
            "id": "create_db_subnet_group",
            "label": "Create DB Subnet Group",
            "description": "Whether to automatically create a dedicated DB subnet group. When on, Subnet IDs (above) is required.",
            "type": "boolean",
            "required": false,
            "default": true
          },
          {
            "id": "db_subnet_group_name",
            "label": "DB Subnet Group Name",
            "description": "Name of the DB subnet group to create or reference. Defaults to '<identifier>-subnet-group' if left empty.",
            "type": "text",
            "required": false,
            "nullable": true,
            "depends_on": { "field": "create_db_subnet_group", "value": true }
          },
          {
            "id": "db_subnet_group_use_name_prefix",
            "label": "Use Name as Prefix",
            "type": "boolean",
            "required": false,
            "default": false,
            "depends_on": { "field": "create_db_subnet_group", "value": true }
          },
          {
            "id": "db_subnet_group_description",
            "label": "DB Subnet Group Description",
            "type": "text",
            "required": false,
            "nullable": true,
            "depends_on": { "field": "create_db_subnet_group", "value": true }
          },
          {
            "id": "db_subnet_group_tags",
            "label": "DB Subnet Group Tags",
            "type": "map",
            "required": false,
            "default": {},
            "depends_on": { "field": "create_db_subnet_group", "value": true }
          },
          {
            "id": "create_security_group",
            "label": "Create Security Group",
            "description": "Whether to create a dedicated security group for the RDS instance. When on, VPC (above) is required.",
            "type": "boolean",
            "required": false,
            "default": true
          },
          {
            "id": "security_group_name",
            "label": "Security Group Name",
            "description": "Name of the dedicated security group. Defaults to '<identifier>-sg' if left empty.",
            "type": "text",
            "required": false,
            "nullable": true,
            "depends_on": { "field": "create_security_group", "value": true }
          },
          {
            "id": "security_group_use_name_prefix",
            "label": "Use Name as Prefix",
            "type": "boolean",
            "required": false,
            "default": false,
            "depends_on": { "field": "create_security_group", "value": true }
          },
          {
            "id": "security_group_description",
            "label": "Security Group Description",
            "type": "text",
            "required": false,
            "nullable": true,
            "depends_on": { "field": "create_security_group", "value": true }
          },
          {
            "id": "allowed_cidr_blocks",
            "label": "Allowed CIDR Blocks",
            "description": "IPv4 CIDR blocks permitted to connect to the database port.",
            "type": "list",
            "required": false,
            "depends_on": { "field": "create_security_group", "value": true }
          },
          {
            "id": "allowed_ipv6_cidr_blocks",
            "label": "Allowed IPv6 CIDR Blocks",
            "description": "IPv6 CIDR blocks permitted to connect to the database port.",
            "type": "list",
            "required": false,
            "depends_on": { "field": "create_security_group", "value": true }
          },
          {
            "id": "allowed_security_group_ids",
            "label": "Allowed Security Group IDs",
            "description": "Source security groups permitted to connect to the database port.",
            "type": "list",
            "required": false,
            "depends_on": { "field": "create_security_group", "value": true },
            "data_source": {
              "resource": "ec2.security_groups",
              "params": { "region": { "from_field": "region" }, "vpc_id": { "from_field": "vpc_id" } },
              "display": { "value_key": "id", "label_key": "name", "description_key": "description" },
              "allow_custom": true,
              "cache_ttl": 300
            }
          },
          {
            "id": "security_group_tags",
            "label": "Security Group Tags",
            "type": "map",
            "required": false,
            "default": {},
            "depends_on": { "field": "create_security_group", "value": true }
          },
          {
            "id": "multi_az",
            "label": "Multi-AZ Deployment",
            "description": "Provision high-availability standby replica in a different AZ.",
            "type": "boolean",
            "required": false,
            "default": false
          },
          {
            "id": "availability_zone",
            "label": "Availability Zone",
            "description": "Specific AZ to place a single-AZ instance in. Ignored when Multi-AZ is enabled.",
            "type": "select",
            "required": false,
            "nullable": true,
            "depends_on": { "field": "multi_az", "value": false },
            "data_source": {
              "resource": "ec2.availability_zones",
              "params": { "region": { "from_field": "region" } },
              "display": { "value_key": "name", "label_key": "name" },
              "allow_custom": true,
              "cache_ttl": 300
            }
          },
          {
            "id": "publicly_accessible",
            "label": "Publicly Accessible",
            "description": "Whether the database is accessible from the public internet.",
            "type": "boolean",
            "required": false,
            "default": false
          },
          {
            "id": "network_type",
            "label": "Network Type",
            "description": "IPv4-only, or dual-stack IPv4/IPv6.",
            "type": "select",
            "required": false,
            "default": "IPV4",
            "options": [
              { "value": "IPV4", "label": "IPv4" },
              { "value": "DUAL", "label": "Dual-stack (IPv4 + IPv6)" }
            ]
          },
          {
            "id": "ca_cert_identifier",
            "label": "CA Certificate Identifier",
            "description": "The identifier of the CA certificate for the DB instance, e.g. rds-ca-rsa2048-g1.",
            "type": "text",
            "required": false,
            "nullable": true,
            "placeholder": "rds-ca-rsa2048-g1"
          }
        ]
      },
      {
        "id": "maintenance",
        "label": "Backups & Maintenance",
        "description": "Automated backups, retention periods, and deletion safeguards.",
        "fields": [
          {
            "id": "backup_retention_period",
            "label": "Backup Retention Period (Days)",
            "description": "Number of days automated backups are retained (0 to 35).",
            "type": "number",
            "required": false,
            "default": 7
          },
          {
            "id": "backup_window",
            "label": "Backup Window (UTC)",
            "description": "Daily window for automated backups.",
            "type": "text",
            "required": false,
            "default": "03:00-04:00"
          },
          {
            "id": "maintenance_window",
            "label": "Maintenance Window (UTC)",
            "description": "Weekly window for database maintenance.",
            "type": "text",
            "required": false,
            "default": "Mon:04:00-Mon:05:00"
          },
          {
            "id": "skip_final_snapshot",
            "label": "Skip Final Snapshot",
            "description": "Whether to skip taking a snapshot before deleting the database.",
            "type": "boolean",
            "required": false,
            "default": true
          },
          {
            "id": "final_snapshot_identifier",
            "label": "Final Snapshot Identifier",
            "description": "Defaults to '<identifier>-final-snapshot' if left empty.",
            "type": "text",
            "required": false,
            "nullable": true,
            "depends_on": { "field": "skip_final_snapshot", "value": false }
          },
          {
            "id": "copy_tags_to_snapshot",
            "label": "Copy Tags to Snapshot",
            "type": "boolean",
            "required": false,
            "default": true
          },
          {
            "id": "delete_automated_backups",
            "label": "Delete Automated Backups on Deletion",
            "type": "boolean",
            "required": false,
            "default": true
          },
          {
            "id": "deletion_protection",
            "label": "Deletion Protection",
            "description": "Protect the database from accidental deletion.",
            "type": "boolean",
            "required": false,
            "default": false
          },
          {
            "id": "auto_minor_version_upgrade",
            "label": "Auto Minor Version Upgrade",
            "description": "Automatically apply minor engine version updates during maintenance.",
            "type": "boolean",
            "required": false,
            "default": true
          },
          {
            "id": "allow_major_version_upgrade",
            "label": "Allow Major Version Upgrade",
            "type": "boolean",
            "required": false,
            "default": false
          },
          {
            "id": "apply_immediately",
            "label": "Apply Changes Immediately",
            "description": "Apply modifications right away instead of during the next maintenance window.",
            "type": "boolean",
            "required": false,
            "default": false
          },
          {
            "id": "snapshot_identifier",
            "label": "Restore from Snapshot",
            "description": "Create this database from an existing DB snapshot identifier or ARN.",
            "type": "text",
            "required": false,
            "nullable": true
          },
          {
            "id": "replicate_source_db",
            "label": "Read Replica Source",
            "description": "Makes this a read replica of the given source database identifier or ARN.",
            "type": "text",
            "required": false,
            "nullable": true
          }
        ]
      },
      {
        "id": "monitoring",
        "label": "Monitoring & Logs",
        "description": "Enhanced Monitoring, Performance Insights, and CloudWatch logs.",
        "fields": [
          {
            "id": "monitoring_interval",
            "label": "Enhanced Monitoring Interval (seconds)",
            "description": "Frequency of metrics collection (0, 1, 5, 10, 15, 30, 60).",
            "type": "number",
            "required": false,
            "default": 0
          },
          {
            "id": "create_monitoring_role",
            "label": "Create Monitoring IAM Role",
            "description": "Automatically create IAM role for RDS Enhanced Monitoring.",
            "type": "boolean",
            "required": false,
            "default": false
          },
          {
            "id": "monitoring_role_arn",
            "label": "Existing Monitoring Role ARN",
            "description": "Use an existing IAM role for Enhanced Monitoring instead of creating one.",
            "type": "select",
            "required": false,
            "nullable": true,
            "depends_on": { "field": "create_monitoring_role", "value": false },
            "data_source": {
              "resource": "iam.roles",
              "params": {},
              "display": { "value_key": "arn", "label_key": "name" },
              "allow_custom": true,
              "cache_ttl": 300
            }
          },
          {
            "id": "monitoring_role_name",
            "label": "Monitoring Role Name",
            "description": "Defaults to '<identifier>-rds-monitoring-role' if left empty.",
            "type": "text",
            "required": false,
            "nullable": true,
            "depends_on": { "field": "create_monitoring_role", "value": true }
          },
          {
            "id": "monitoring_role_tags",
            "label": "Monitoring Role Tags",
            "type": "map",
            "required": false,
            "default": {},
            "depends_on": { "field": "create_monitoring_role", "value": true }
          },
          {
            "id": "performance_insights_enabled",
            "label": "Performance Insights Enabled",
            "description": "Collect detailed database query execution metrics.",
            "type": "boolean",
            "required": false,
            "default": false
          },
          {
            "id": "performance_insights_kms_key_id",
            "label": "Performance Insights KMS Key",
            "type": "select",
            "required": false,
            "nullable": true,
            "depends_on": { "field": "performance_insights_enabled", "value": true },
            "data_source": {
              "resource": "kms.keys",
              "params": { "region": { "from_field": "region" } },
              "display": { "value_key": "id", "label_key": "name" },
              "allow_custom": true,
              "cache_ttl": 300
            }
          },
          {
            "id": "performance_insights_retention_period",
            "label": "Performance Insights Retention (Days)",
            "type": "select",
            "required": false,
            "default": 7,
            "depends_on": { "field": "performance_insights_enabled", "value": true },
            "options": [
              { "value": "7", "label": "7 days (free tier)" },
              { "value": "731", "label": "731 days (2 years, long-term)" }
            ]
          },
          {
            "id": "iam_database_authentication_enabled",
            "label": "IAM Database Authentication",
            "description": "Allow authenticating to the database using IAM credentials instead of passwords.",
            "type": "boolean",
            "required": false,
            "default": false
          },
          {
            "id": "enabled_cloudwatch_logs_exports",
            "label": "CloudWatch Logs Exports",
            "description": "Log types to publish to CloudWatch.",
            "type": "list",
            "required": false
          }
        ]
      },
      {
        "id": "parameter_group",
        "label": "DB Parameter Group",
        "description": "Engine configuration parameters applied to the database.",
        "collapsed": true,
        "fields": [
          {
            "id": "create_db_parameter_group",
            "label": "Create DB Parameter Group",
            "type": "boolean",
            "required": false,
            "default": true
          },
          {
            "id": "parameter_group_name",
            "label": "Parameter Group Name",
            "description": "Name to create or reference. Defaults based on identifier and engine family if left empty.",
            "type": "text",
            "required": false,
            "nullable": true,
            "depends_on": { "field": "create_db_parameter_group", "value": true }
          },
          {
            "id": "parameter_group_use_name_prefix",
            "label": "Use Name as Prefix",
            "type": "boolean",
            "required": false,
            "default": false,
            "depends_on": { "field": "create_db_parameter_group", "value": true }
          },
          {
            "id": "family",
            "label": "Parameter Group Family",
            "description": "E.g. mysql8.0, mariadb10.11, postgres16. Defaults based on engine/engine version if left empty.",
            "type": "text",
            "required": false,
            "nullable": true,
            "placeholder": "postgres16",
            "depends_on": { "field": "create_db_parameter_group", "value": true }
          },
          {
            "id": "parameter_group_description",
            "label": "Parameter Group Description",
            "type": "text",
            "required": false,
            "nullable": true,
            "depends_on": { "field": "create_db_parameter_group", "value": true }
