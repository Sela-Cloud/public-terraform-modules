variable "region" {
  description = "The AWS region where resources will be provisioned."
  type        = string
  default     = "us-east-1"
}

variable "rds" {
  description = "Map of RDS instance configurations to deploy, keyed by instance name or identifier."
  type = map(object({
    identifier                      = optional(string, null)
    identifier_prefix               = optional(string, null)
    engine                          = optional(string, "mysql")
    engine_version                  = optional(string, null)
    instance_class                  = optional(string, "db.t4g.micro")
    allocated_storage               = optional(number, 20)
    max_allocated_storage           = optional(number, 100)
    storage_type                    = optional(string, "gp3")
    iops                            = optional(number, null)
    storage_throughput              = optional(number, null)
    dedicated_log_volume            = optional(bool, false)
    storage_encrypted               = optional(bool, true)
    kms_key_id                      = optional(string, null)
    license_model                   = optional(string, null)
    character_set_name              = optional(string, null)
    db_name                         = optional(string, null)
    username                        = optional(string, null)
    password                        = optional(string, null)
    manage_master_user_password     = optional(bool, true)
    master_user_secret_kms_key_id   = optional(string, null)
    port                            = optional(number, null)
    multi_az                        = optional(bool, false)
    availability_zone               = optional(string, null)
    publicly_accessible             = optional(bool, false)
    network_type                    = optional(string, "IPV4")
    ca_cert_identifier              = optional(string, null)
    vpc_security_group_ids          = optional(list(string), [])
    create_db_subnet_group          = optional(bool, true)
    db_subnet_group_name            = optional(string, null)
    db_subnet_group_use_name_prefix = optional(bool, false)
    db_subnet_group_description     = optional(string, null)
    subnet_ids                      = optional(list(string), [])
    db_subnet_group_tags            = optional(map(string), {})
    create_db_parameter_group       = optional(bool, true)
    parameter_group_name            = optional(string, null)
    parameter_group_use_name_prefix = optional(bool, false)
    family                          = optional(string, null)
    parameter_group_description     = optional(string, null)
    parameters = optional(list(object({
      name         = string
      value        = string
      apply_method = optional(string)
    })), [])
    parameter_group_tags                  = optional(map(string), {})
    create_db_option_group                = optional(bool, false)
    option_group_name                     = optional(string, null)
    option_group_use_name_prefix          = optional(bool, false)
    major_engine_version                  = optional(string, null)
    option_group_description              = optional(string, null)
    options                               = optional(any, [])
    option_group_tags                     = optional(map(string), {})
    create_security_group                 = optional(bool, true)
    vpc_id                                = optional(string, null)
    security_group_name                   = optional(string, null)
    security_group_use_name_prefix        = optional(bool, false)
    security_group_description            = optional(string, null)
    allowed_cidr_blocks                   = optional(list(string), [])
    allowed_ipv6_cidr_blocks              = optional(list(string), [])
    allowed_security_group_ids            = optional(list(string), [])
    security_group_tags                   = optional(map(string), {})
    backup_retention_period               = optional(number, 7)
    backup_window                         = optional(string, "03:00-04:00")
    copy_tags_to_snapshot                 = optional(bool, true)
    skip_final_snapshot                   = optional(bool, true)
    final_snapshot_identifier             = optional(string, null)
    maintenance_window                    = optional(string, "Mon:04:00-Mon:05:00")
    auto_minor_version_upgrade            = optional(bool, true)
    allow_major_version_upgrade           = optional(bool, false)
    apply_immediately                     = optional(bool, false)
    deletion_protection                   = optional(bool, false)
    delete_automated_backups              = optional(bool, true)
    enabled_cloudwatch_logs_exports       = optional(list(string), [])
    monitoring_interval                   = optional(number, 0)
    monitoring_role_arn                   = optional(string, null)
    create_monitoring_role                = optional(bool, false)
    monitoring_role_name                  = optional(string, null)
    monitoring_role_tags                  = optional(map(string), {})
    performance_insights_enabled          = optional(bool, false)
    performance_insights_kms_key_id       = optional(string, null)
    performance_insights_retention_period = optional(number, 7)
    iam_database_authentication_enabled   = optional(bool, false)
    snapshot_identifier                   = optional(string, null)
    replicate_source_db                   = optional(string, null)
    domain                                = optional(string, null)
    domain_iam_role_name                  = optional(string, null)
    domain_auth_secret_arn                = optional(string, null)
    domain_dns_ips                        = optional(list(string), null)
    custom_iam_instance_profile           = optional(string, null)
    blue_green_update = optional(object({
      enabled = optional(bool)
    }), null)
    restore_to_point_in_time = optional(object({
      restore_time                             = optional(string)
      source_db_instance_automated_backups_arn = optional(string)
      source_db_instance_identifier            = optional(string)
      source_dbi_resource_id                   = optional(string)
      use_latest_restorable_time               = optional(bool)
    }), null)
    s3_import = optional(object({
      bucket_name           = string
      bucket_prefix         = optional(string)
      ingestion_role        = string
      source_engine         = string
      source_engine_version = string
    }), null)
    role_associations = optional(map(object({
      feature_name = string
      role_arn     = string
    })), {})
    create_db_event_subscription          = optional(bool, false)
    db_event_subscription_name            = optional(string, null)
    db_event_subscription_use_name_prefix = optional(bool, false)
    sns_topic_arn                         = optional(string, null)
    event_categories                      = optional(list(string), null)
    event_subscription_enabled            = optional(bool, true)
    db_event_subscription_tags            = optional(map(string), {})
    timeouts = optional(object({
      create = optional(string, "60m")
      update = optional(string, "60m")
      delete = optional(string, "60m")
    }), {})
    tags = optional(map(string), {})
  }))
  default = {}
}
