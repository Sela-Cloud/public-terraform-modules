region = "us-east-1"

iam_role = {
  "app-ec2-role" = {
    name                  = "app-ec2-role"
    name_prefix           = null
    assume_role_policy    = <<-EOF
    {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Action": "sts:AssumeRole",
          "Effect": "Allow",
          "Principal": {
            "Service": "ec2.amazonaws.com"
          }
        }
      ]
    }
    EOF
    description           = "EC2 instance role for application workloads"
    path                  = "/"
    force_detach_policies = false
    max_session_duration  = 3600
    permissions_boundary  = null
    managed_policy_arns = [
      "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
    ]
    inline_policy = []

    tags = {
      Environment = "production"
      Owner       = "devops-team"
      Project     = "core-infrastructure"
    }
  },

  "lambda-processor-role" = {
    name                  = "lambda-processor-role"
    name_prefix           = null
    assume_role_policy    = <<-EOF
    {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Action": "sts:AssumeRole",
          "Effect": "Allow",
          "Principal": {
            "Service": "lambda.amazonaws.com"
          }
        }
      ]
    }
    EOF
    description           = "Execution role for data processor Lambda functions"
    path                  = "/service-roles/"
    force_detach_policies = true
    max_session_duration  = 7200
    permissions_boundary  = null
    managed_policy_arns = [
      "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
    ]
    inline_policy = [
      {
        name = "s3-processor-access"
        policy = <<-EOF
        {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Action": [
                "s3:GetObject",
                "s3:PutObject"
              ],
              "Effect": "Allow",
              "Resource": "arn:aws:s3:::my-processing-bucket/*"
            }
          ]
        }
        EOF
      }
    ]

    tags = {
      Environment = "staging"
      Owner       = "data-team"
      Service     = "processor"
    }
  }
}
