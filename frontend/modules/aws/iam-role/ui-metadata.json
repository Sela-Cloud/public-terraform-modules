{
  "$schema": "../../../ui-metadata.schema.json",
  "module": "iam-role",
  "version": "1.0.0",
  "display": {
    "label": "AWS IAM Role",
    "icon": "iam",
    "description": "Provision AWS IAM Roles with trust relationships, managed policy attachments, and inline policies",
    "category": "global"
  },
  "globals": [
    {
      "id": "region",
      "label": "AWS Region",
      "description": "The AWS region where resources will be provisioned.",
      "type": "select",
      "required": true,
      "default": "us-east-1",
      "data_source": {
        "resource": "ec2.regions",
        "params": {},
        "display": {
          "value_key": "name",
          "label_key": "description",
          "description_key": "name"
        }
      }
    }
  ],
  "provides": [
    {
      "data_source": "iam.roles",
      "value_field": "name"
    }
  ],
  "resource": {
    "variable": "iam_role",
    "key_field": "name",
    "key_label": "Role Name",
    "key_description": "Unique friendly name for the IAM role.",
    "sections": [
      {
        "id": "basic",
        "label": "Basic Configuration",
        "description": "Core IAM role settings including name, path, and description.",
        "fields": [
          {
            "id": "name",
            "label": "Role Name",
            "description": "Friendly name of the IAM role. Conflicts with name_prefix.",
            "type": "text",
            "required": true,
            "default": "iam-role-default",
            "placeholder": "app-execution-role",
            "validation": {
              "min": 1,
              "max": 64,
              "pattern": "^[a-zA-Z0-9+=,.@_-]+$",
              "pattern_error": "Role name must only contain alphanumeric characters and symbols +=,.@_-"
            }
          },
          {
            "id": "name_prefix",
            "label": "Role Name Prefix",
            "description": "Creates a unique friendly name beginning with the specified prefix. Conflicts with name.",
            "type": "text",
            "required": false,
            "placeholder": "app-role-"
          },
          {
            "id": "path",
            "label": "Path",
            "description": "Path to the IAM role. Must begin and end with a forward slash (/).",
            "type": "text",
            "required": false,
            "default": "/",
            "placeholder": "/",
            "validation": {
              "pattern": "^(/|(/[a-zA-Z0-9_+=,.@-]+)+/)$",
              "pattern_error": "Path must begin and end with a forward slash (/)."
            }
          },
          {
            "id": "description",
            "label": "Description",
            "description": "Description of the role's purpose and usage.",
            "type": "text",
            "required": false,
            "default": "Managed by Terraform",
            "placeholder": "Execution role for workloads"
          }
        ]
      },
      {
        "id": "trust_and_permissions",
        "label": "Trust Policy & Permissions",
        "description": "Who can assume this role, and permission boundary configuration.",
        "fields": [
          {
            "id": "trusted_entity_type",
            "label": "Trusted Entity",
            "description": "Who can assume this role.",
            "type": "select",
            "default": "CUSTOM_JSON",
            "options": [
              {
                "value": "AWS_SERVICE",
                "label": "AWS Service"
              },
              {
                "value": "AWS_ACCOUNT",
                "label": "AWS Account"
              },
              {
                "value": "IAM_PRINCIPAL",
                "label": "Existing IAM Role or User"
              },
              {
                "value": "CUSTOM_JSON",
                "label": "Custom JSON"
              }
            ]
          },
          {
            "id": "trusted_service_principals",
            "label": "Service Principals",
            "description": "AWS services allowed to assume this role.",
            "type": "list",
            "required": false,
            "default": [],
            "depends_on": {
              "field": "trusted_entity_type",
              "value": "AWS_SERVICE"
            },
            "options": [
              {
                "value": "ec2.amazonaws.com",
                "label": "EC2"
              },
              {
                "value": "lambda.amazonaws.com",
                "label": "Lambda"
              },
              {
                "value": "ecs-tasks.amazonaws.com",
                "label": "ECS Tasks"
              },
              {
                "value": "eks.amazonaws.com",
                "label": "EKS"
              },
              {
                "value": "eks-fargate-pods.amazonaws.com",
                "label": "EKS Fargate Pods"
              },
              {
                "value": "rds.amazonaws.com",
                "label": "RDS"
              },
              {
                "value": "states.amazonaws.com",
                "label": "Step Functions"
              },
              {
                "value": "events.amazonaws.com",
                "label": "EventBridge"
              }
            ]
          },
          {
            "id": "trusted_account_ids",
            "label": "AWS Account IDs",
            "description": "AWS account IDs allowed to assume this role.",
            "type": "list",
            "required": false,
            "default": [],
            "placeholder": "123456789012",
            "depends_on": {
              "field": "trusted_entity_type",
              "value": "AWS_ACCOUNT"
            }
          },
          {
            "id": "trusted_role_arns",
            "label": "Trusted IAM Roles",
            "description": "Existing IAM roles allowed to assume this role.",
            "type": "list",
            "required": false,
            "default": [],
            "depends_on": {
              "field": "trusted_entity_type",
              "value": "IAM_PRINCIPAL"
            },
            "data_source": {
              "resource": "iam.roles",
              "params": {},
              "display": {
                "value_key": "arn",
                "label_key": "name"
              },
              "allow_custom": true,
              "cache_ttl": 300
            }
          },
          {
            "id": "trusted_user_arns",
            "label": "Trusted IAM Users",
            "description": "Existing IAM users allowed to assume this role.",
            "type": "list",
            "required": false,
            "default": [],
            "depends_on": {
              "field": "trusted_entity_type",
              "value": "IAM_PRINCIPAL"
            },
            "data_source": {
              "resource": "iam.users",
              "params": {},
              "display": {
                "value_key": "arn",
                "label_key": "name"
              },
              "allow_custom": true,
              "cache_ttl": 300
            }
          },
          {
            "id": "trusted_external_id",
            "label": "External ID",
            "description": "Requires this value to be presented on assumption. Recommended for cross-account trust to avoid the confused-deputy problem.",
            "type": "text",
            "required": false,
            "nullable": true,
            "depends_on": {
              "field": "trusted_entity_type",
              "operator": "in",
              "value": [
                "IAM_PRINCIPAL",
                "AWS_ACCOUNT"
              ]
            }
          },
          {
            "id": "assume_role_policy",
            "label": "Assume Role Policy Document",
            "description": "JSON formatted trust policy document granting entities permission to assume this role.",
            "type": "text",
            "multiline": true,
            "required": true,
            "default": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [\n    {\n      \"Action\": \"sts:AssumeRole\",\n      \"Effect\": \"Allow\",\n      \"Principal\": {\n        \"Service\": \"ec2.amazonaws.com\"\n      }\n    }\n  ]\n}",
            "placeholder": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [...]\n}",
            "depends_on": {
              "field": "trusted_entity_type",
              "value": "CUSTOM_JSON"
            }
          },
          {
            "id": "permissions_boundary",
            "label": "Permissions Boundary ARN",
            "description": "ARN of the managed policy that sets the permissions boundary for the role.",
            "type": "text",
            "required": false,
            "placeholder": "arn:aws:iam::123456789012:policy/DeveloperBoundary"
          }
        ]
      },
      {
        "id": "session_and_lifecycle",
        "label": "Session & Lifecycle Management",
        "description": "Session duration limits and policy detachment settings.",
        "fields": [
          {
            "id": "max_session_duration",
            "label": "Max Session Duration (Seconds)",
            "description": "Maximum session duration in seconds (from 3600 to 43200).",
            "type": "number",
            "required": false,
            "default": 3600,
            "validation": {
              "min": 3600,
              "max": 43200
            }
          },
          {
            "id": "force_detach_policies",
            "label": "Force Detach Policies",
            "description": "Force detachment of attached policies prior to destroying the role.",
            "type": "boolean",
            "required": false,
            "default": false
          }
        ]
      },
      {
        "id": "policy_attachments",
        "label": "Policy Attachments",
        "description": "Managed policies and inline policies attached to this role.",
        "fields": [
          {
            "id": "managed_policy_arns",
            "label": "Managed Policy ARNs",
            "description": "List of AWS managed policy ARNs to attach to the role.",
            "type": "list",
            "required": false,
            "default": [],
            "data_source": {
              "resource": "iam.policies",
              "params": {
                "scope": {
                  "static": "local"
                }
              },
              "display": {
                "value_key": "id",
                "label_key": "name",
                "description_key": "arn"
              },
              "allow_custom": true,
              "cache_ttl": 300
            }
          },
          {
            "id": "inline_policy",
            "label": "Inline Policies",
            "description": "List of inline policy objects defining policy name and JSON document.",
            "type": "repeatable",
            "required": false,
            "default": [],
            "fields": [
              {
                "id": "name",
                "label": "Policy Name",
                "description": "Name of the inline policy.",
                "type": "text",
                "required": true,
                "placeholder": "my-inline-policy"
              },
              {
                "id": "policy",
                "label": "Policy Document",
                "description": "JSON formatted IAM policy document.",
                "type": "text",
                "multiline": true,
                "required": true,
                "placeholder": "{\n  \"Version\": \"2012-10-17\",\n  \"Statement\": [...]\n}"
              }
            ]
          }
        ]
      },
      {
        "id": "tags",
        "label": "Tags",
        "description": "Resource tags for organizational, tracking, and cost allocation purposes.",
        "fields": [
          {
            "id": "tags",
            "label": "Role Tags",
            "description": "Key-value tags assigned to the IAM role.",
            "type": "map",
            "required": false,
            "default": {}
          }
        ]
      }
    ]
  }
}
